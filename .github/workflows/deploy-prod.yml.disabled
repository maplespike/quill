name: Deploy Prod (DISABLED - See header)

on:
  workflow_dispatch:
  push:
    branches: [prod]
    paths:
    - 'packages/**'
    - 'flake.nix'
    - 'flake.lock'
    - 'k8s/**'
    - '.github/workflows/deploy-prod.yml.disabled'

concurrency:
  group: deploy-prod-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  packages: write

jobs:
  disabled:
    runs-on: [self-hosted, nixos]
    steps:
      - name: Workflow Disabled
        run: |
          echo "❌ This workflow is disabled"
          echo "See docs/CRITICAL-ISSUES-FOUND.md for details"
          echo "Current deployment: Docker Compose for local development"
