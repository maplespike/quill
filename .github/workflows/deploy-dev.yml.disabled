name: Deploy Dev (DISABLED - See header)

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
    - 'packages/**'
    - 'flake.nix'
    - 'flake.lock'
    - 'k8s/**'
    - '.github/workflows/deploy-dev.yml.disabled'

concurrency:
  group: deploy-dev-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  packages: write

jobs:
  disabled:
    runs-on: [self-hosted, nixos]
    steps:
      - name: Workflow Disabled
        run: |
          echo "❌ This workflow is disabled"
