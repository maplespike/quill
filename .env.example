# =============================================================================
# MapleSpike -- Environment Variables Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then review and adjust values as needed. The run.sh script will
# auto-generate JWT_SECRET if left at its default on first run.
#
# Service ports (defaults):
#   API Server   8082
#   MCP Server   3001
#   Portal       4321
# =============================================================================

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------

# API key used for legacy X-API-Key auth header
MAPLESPIKE_API_KEY=maplespike-dev-key

# Dev-only API key (shown in startup banner, separate from the hashed key)
QUILL_DEV_API_KEY=maplespike-dev-key

# Storage backend: memory | sqlite | postgres
#   memory  - ephemeral, resets on restart (default)
#   sqlite  - persistent via better-sqlite3
#   postgres - production-ready via node-postgres
QUILL_STORAGE=memory

# Path for SQLite database file (only used when STORAGE=sqlite)
QUILL_DB_PATH=./quill.db

# HTTP listen port for the API server
PORT=8082

# JWT signing secret (REQUIRED -- generate a secure random value)
#   openssl rand -hex 64
# Without this the API server will refuse to start.
JWT_SECRET=change-in-production

# Server metadata (shown in health-check responses)
QUILL_VERSION=0.2.0
MAPLESPIKE_NAME=MapleSpike
APP_URL=http://localhost:8082

# ── Email (Transactional) ──────────────────────────────────────────
# Email provider for sending verification / welcome emails.
# Options: "sendgrid" (production), "console" (dev fallback — logs to stdout)
# EMAIL_PROVIDER=sendgrid

# SendGrid API key (required when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=

# Sender identity for transactional emails
# EMAIL_FROM=noreply@maplespike.ca
# EMAIL_FROM_NAME=MapleSpike

# Environment label: development | staging | production
ENVIRONMENT=development

# Log level: trace | debug | info | warn | error | fatal
QUILL_LOG_LEVEL=debug

# Domain and origin for WebAuthn / passkey authentication
MAPLESPIKE_DOMAIN=maplespike.ca
MAPLESPIKE_ORIGIN=http://localhost:8082

# Public site origin used in API and MCP responses (signup, docs, CORS extras).
# Order: QUILL_PUBLIC_BASE_URL, MAPLESPIKE_PUBLIC_URL, https://quill.$MAPLESPIKE_DOMAIN,
# APP_URL, then the brand portal https://quill.maplespike.ca.
# QUILL_PUBLIC_BASE_URL=https://quill.example.org
# MAPLESPIKE_PUBLIC_URL=https://quill.example.org

# -----------------------------------------------------------------------------
# AI Gateway (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------

# Primary AI endpoint (OpenAI-compatible chat completions API)
# Multiple aliases supported; consulted in this order:
#   QUILL_AI_ENDPOINT -> QUILL_GATEWAY_URL -> AI_ENDPOINT
# Leave all of them unset to disable the AI gateway. There is no built-in host.
# QUILL_AI_ENDPOINT=http://127.0.0.1:8080/v1
# QUILL_GATEWAY_URL=http://127.0.0.1:8080/v1
# AI_ENDPOINT=
# Fusion chat path used by POST /v1/ai/ask before the standard gateway.
# QUILL_FUSION_ENDPOINT=
# QUILL_FUSION_MODEL=

# API key for the AI gateway (if required)
QUILL_GATEWAY_API_KEY=

# AI model to use for chat / reasoning. Consulted in order:
#   QUILL_AI_MODEL -> QUILL_CHAT_MODEL -> AI_MODEL
QUILL_AI_MODEL=qwen3.5-27b
QUILL_CHAT_MODEL=qwen/qwen3-coder-30b-a3b-instruct
AI_MODEL=qwen3.5-27b

# OpenCorporates API key for corporate entity lookups
# Free key: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# OAuth / GitHub
# -----------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8082/v1/auth/github/callback
MAPLESPIKE_OAUTH_REDIRECT_BASE=http://localhost:8082/v1/auth/oauth

# -----------------------------------------------------------------------------
# PostgreSQL (API Server)
# -----------------------------------------------------------------------------

# Full connection string (takes precedence over individual vars below)
# DATABASE_URL=postgresql://user:password@localhost:5432/maplespike

# Individual Postgres connection parameters (used when STORAGE=postgres
# and DATABASE_URL is not set)
QUILL_DB_HOST=localhost
QUILL_DB_PORT=5432
QUILL_DB_NAME=maplespike
QUILL_DB_USER=maplespike
QUILL_DB_PASSWORD=

# Legacy / engine Postgres vars (consulted separately by some components)
PGHOST=localhost
PGPORT=5432
PGDATABASE=maplespike
PGUSER=postgres
PGPASSWORD=postgres

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------

# Port for SSE transport (MCP server starts in SSE mode when PORT is set)
# Default: 3001
MCP_PORT=3001

# API server base URL that the MCP server talks to
MAPLESPIKE_API_URL=http://localhost:8082/v1

# Qdrant vector DB endpoint for semantic RAG context retrieval.
# Unset disables vector search. There is no built-in host.
# QUILL_QDRANT_ENDPOINT=http://127.0.0.1:6333
# Qdrant collection name for document vectors (default: maplespike on MCP, brain_wiki on the API)
# QUILL_QDRANT_COLLECTION=maplespike
# Optional API key sent as the Qdrant api-key header.
# QUILL_QDRANT_API_KEY=
# Embedding model for vector search (default: nvidia/llama-3.2-nv-embedqa-1b-v2)
# QUILL_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Locale for CLI responses: en-CA or fr-CA
QUILL_LOCALE=en-CA

# Max handler runtime before the gateway closes the connection.
# Default: 55000 (55s — stays under the Hermes gateway's 60s limit).
# QUILL_HANDLER_TIMEOUT_MS=55000

# Honor X-Forwarded-For when sitting behind Cloudflare/nginx. ONLY set true
# behind a proxy whose egress IP is trusted; otherwise any client can rotate
# the per-IP quota key by rotating the header.
# TRUST_PROXY=false

# Optional delegated token validator. When set, /sse auth is delegated to
# astral-key ($ASTRAL_KEY_URL/auth/verify) instead of comparing against
# QUILL_API_KEY locally. The API also proxies /v1/auth/astral/* to this URL.
# Unset returns 503 from those proxy routes.
# ASTRAL_KEY_URL=

# Knowledge Fabric and SearXNG MCP tools. Unset returns a disabled message.
# KNOWLEDGE_FABRIC_URL=
# SEARXNG_URL=

# Pipeline-data citation index. Comma-separated file paths. Unset skips the
# index (claim-store lookup still works). A set path that is missing is HTTP 503.
# QUILL_PIPELINE_DATA_PATH=

# Dependency-audit snapshot for GET /v1/security/audit-summary.
# Unset or missing is HTTP 503. The API image sets this to /app/data/security/audit.json.
# QUILL_SECURITY_AUDIT_JSON=

# Qdrant embedder (pipeline-core curation). Unset disables embed and upsert.
# QDRANT_URL=
# EMBEDDING_ENDPOINT=
# QDRANT_COLLECTION=brain_wiki

# ── Fre quota gate (hosted/SSE only — stdio callers are self-hosted/uncounted) ──
# After QUILL_FREE_QUOTA calls per calendar month (UTC) per identity, paid
# tools return 402 unless x402 is enabled (see below) or the caller has a
# remaining credit balance. Self-hosted callers (stdio / `npx`) are NEVER
# gated. Reads from packages/quill-mcp/src/quota.ts.
# QUOTA_ENABLED=false
# QUILL_FREE_QUOTA=1000
# QUOTA_PERSIST_PATH=

# ── x402 (Solana USDC) micropayments ──
# When X402_ENABLED=true, paid tools require either:
#   (a) credit balance ≥ price (call `x402-deposit` MCP tool to fund), OR
#   (b) signature proof in `X-PAYMENT` header proving on-chain USDC transfer
#       to X402_RECIPIENT (verified via SOLANA_RPC_URL).
# Self-hosted callers are never blocked. Reads from
# packages/quill-mcp/src/x402-middleware.ts.
# X402_ENABLED=false
# X402_RECIPIENT=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# X402_CONFIRMATION_LEVEL=confirmed
# X402_TIMESTAMP_TOLERANCE_SEC=300

# Optional persistence — replay ledger (consumed signatures, 7-day TTL):
# X402_LEDGER_PATH=
# Optional persistence — credit balance ledger (per-identity pre-pay balance):
# X402_CREDITS_PATH=

# -----------------------------------------------------------------------------
# Notification Service
# -----------------------------------------------------------------------------

# SMTP configuration for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender identity for outgoing notifications
NOTIFICATION_FROM_EMAIL=noreply@maplespike.ca
NOTIFICATION_FROM_NAME=MapleSpike Alerts

# API base URL used in notification links (usually your API server)
QUILL_API_BASE=http://localhost:8082

# How often to poll for pending notifications (milliseconds)
POLL_INTERVAL_MS=60000

# Max outbound emails per poll cycle
MAX_EMAILS_PER_CYCLE=50

# -----------------------------------------------------------------------------
# Treasury / Crypto Donation Addresses (billing routes)
# -----------------------------------------------------------------------------

MAPLESPIKE_TREASURY_SOLANA=
MAPLESPIKE_TREASURY_ETH=
MAPLESPIKE_TREASURY_BASE=
MAPLESPIKE_TREASURY_POLYGON=
MAPLESPIKE_TREASURY_ARBITRUM=
MAPLESPIKE_TREASURY_OPTIMISM=
MAPLESPIKE_TREASURY_AVALANCHE=
MAPLESPIKE_TREASURY_BNB=
MAPLESPIKE_TREASURY_TRON=
MAPLESPIKE_TREASURY_BITCOIN=

# -----------------------------------------------------------------------------
# Legal / Regulatory API Keys
# -----------------------------------------------------------------------------

# CanLII API key for Canadian legal document access
# https://www.canlii.org/en/info/api.html
CANLII_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (monetization MVP — Phase 6)
# -----------------------------------------------------------------------------
# All three vars below must be set in production for /v1/billing/stripe/* to
# work. In production they live in the SOPS-encrypted `quill/secrets/runtime.yaml`
# and surface in the cluster as K8s Secret `maplespike-stripe-secrets`.
#
#   STRIPE_SECRET_KEY        - sk_live_... or sk_test_...; from
#                              https://dashboard.stripe.com/apikeys
#   STRIPE_WEBHOOK_SECRET    - whsec_...; from the Stripe webhook endpoint
#                              page after pointing a webhook at
#                              https://api.maplespike.ca/v1/billing/stripe/webhook
#   STRIPE_ACCOUNT_ID        - (optional) acct_...; encoded in the secret key already
#   STRIPE_PUBLISHABLE_KEY   - pk_live_... or pk_test_... (browser-safe; not currently
#                              rendered client-side, but kept for future SDK integration)
#
# In dev: leave these unset, or use sk_test_… values, and the checkout endpoint will
# return 503 with code STRIPE_NOT_CONFIGURED — safe failure mode.
APP_URL=http://localhost:8082
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# STRIPE_ACCOUNT_ID=acct_REPLACE_ME
# STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# -----------------------------------------------------------------------------
# Deployment / Infrastructure
# -----------------------------------------------------------------------------

# Nexus (internal deployment host)
NEXUS_HOST=
NEXUS_USER=
NEXUS_SSH_KEY=

# Analytics domain for Plausible or similar
MAPLESPIKE_ANALYTICS_DOMAIN=

# -----------------------------------------------------------------------------
# Portal (static site / Astro build)
# -----------------------------------------------------------------------------

# Brand site hostname used by the portal's cross-deployable brand link.
# Reference site: ../maplespike-brand (separate Cloudflare Pages project,
# sibling repo to maplespike). Pointer only — the portal does NOT proxy
# or render brand content; it links out to whatever this URL resolves to.
#
# Fallback (when this var is unset): https://brand.maplespike.lan,
# as encoded in packages/portal/src/layouts/BaseLayout.astro.
#
# Trailing slashes are stripped at link-build time. Set this at build
# time to point your portal deploy at the canonical brand host
# (e.g. https://brand.maplespike.ca for production, a staging host
# for QA, or a fork-specific host for self-hosters).
PUBLIC_BRAND_URL=

# -----------------------------------------------------------------------------
# Lightpanda (Zig-built headless browser CLI for JS-rendered scrape)
# -----------------------------------------------------------------------------
# Lightpanda (https://lightpanda.io) is a Zig-built headless browser binary
# that the pipeline uses for fetching JS-rendered data sources — sites that
# ship an empty SSR shell and only populate meaningful HTML after client
# hydration (e.g. PBO Nuxt at pbo-dpb.ca, several provincial regulator
# portals, SEDI public listings).
#
# packages/pipeline-core/src/utils/browser-fetch.ts spawns
#     `$LIGHTPANDA_BIN fetch --dump <fmt> <url>`
# per call and returns the post-render DOM as a string with the same shape
# as httpGet().
#
# Requirements for lightpanda-backed ingestion modules to work:
#   - lightpanda binary on PATH, or LIGHTPANDA_BIN set to its path
#   - self-hosters: pull the precompiled CLI from
#     https://github.com/lightpanda-io/lightpanda/releases — the repo's
#     Nix / docker-compose / Helm layers do NOT install the binary
#   - leave unset to look up `lightpanda` on PATH; the wrapper
#     throws at runtime when the binary cannot be spawned

# LIGHTPANDA_BIN=lightpanda

# Forwarded to `lightpanda fetch --log-level`. Lightpanda logs to stderr;
# the wrapper captures it on BrowserResponse.stderr for diagnostics.
# LIGHTPANDA_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Lightpanda (Zig-built headless browser CLI for JS-rendered scrape)
# -----------------------------------------------------------------------------
# Lightpanda (https://lightpanda.io) is a Zig-built headless browser binary
# that the pipeline uses for fetching JS-rendered data sources — sites that
# ship an empty SSR shell and only populate meaningful HTML after client
# hydration (PBO Nuxt, several provincial regulator portals, SEDI public
# listings). packages/pipeline-core/src/utils/browser-fetch.ts spawns
# `<LIGHTPANDA_BIN> fetch --dump <fmt> <url>` per call and returns the
# post-render DOM as a string with the same shape as httpGet().
#
# Requirements for lightpanda-callable ingestion modules to work:
#   - lightpanda binary on PATH, or LIGHTPANDA_BIN set to its path
#   - self-hosters: pull the precompiled CLI from
#     https://github.com/lightpanda-io/lightpanda/releases — the repo's
#     Nix / docker-compose / Helm layers do NOT install the binary
#   - leave unset to look up `lightpanda` on PATH; the wrapper
#     throws at runtime when the binary cannot be spawned
#
# LIGHTPANDA_BIN=lightpanda
#
# Forwarded to `lightpanda fetch --log-level`. Lightpanda logs to stderr;
# the wrapper captures it on BrowserResponse.stderr for diagnostics.
# LIGHTPANDA_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Redis — response cache + distributed rate-limit counters (gate A2-REDIS)
# -----------------------------------------------------------------------------
# Both consumers (packages/api-server/src/cache/redis.ts and
# middleware/rate-limiter.ts) read REDIS_URL only. There is no built-in
# default: an unset REDIS_URL means "no Redis in this environment" — the cache
# serves without caching and the limiter enforces its tier limits in-process
# (per pod). It is never a guess at a host that may not exist.
#
# Local dev stack: `docker compose up` starts the `quill-redis` service, so
# docker-compose.yml already passes this value to the API.
# Production: charts/quill/templates/redis.yaml renders the Service and
# values-prod.yaml sets api.env.REDIS_URL to it.
#
# REDIS_URL=redis://quill-redis:6379
