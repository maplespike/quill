# =============================================================================
# MapleSpike -- Environment Variables Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then review and adjust values as needed. The run.sh script will
# auto-generate JWT_SECRET if left at its default on first run.
#
# Service ports (defaults):
#   API Server   8082
#   MCP Server   3001
#   Portal       4321
# =============================================================================

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------

# API key used for legacy X-API-Key auth header
MAPLESPIKE_API_KEY=maplespike-dev-key

# Dev-only API key (shown in startup banner, separate from the hashed key)
MAPLESPIKE_DEV_API_KEY=maplespike-dev-key

# Storage backend: memory | sqlite | postgres
#   memory  - ephemeral, resets on restart (default)
#   sqlite  - persistent via better-sqlite3
#   postgres - production-ready via node-postgres
MAPLESPIKE_STORAGE=memory

# Path for SQLite database file (only used when STORAGE=sqlite)
MAPLESPIKE_DB_PATH=./maplespike.db

# HTTP listen port for the API server
PORT=8082

# JWT signing secret (REQUIRED -- generate a secure random value)
#   openssl rand -hex 64
# Without this the API server will refuse to start.
JWT_SECRET=change-in-production

# Server metadata (shown in health-check responses)
MAPLESPIKE_VERSION=0.2.0
MAPLESPIKE_NAME=MapleSpike
APP_URL=http://localhost:8082

# Environment label: development | staging | production
ENVIRONMENT=development

# Log level: trace | debug | info | warn | error | fatal
MAPLESPIKE_LOG_LEVEL=debug

# Domain and origin for WebAuthn / passkey authentication
MAPLESPIKE_DOMAIN=maplespike.ca
MAPLESPIKE_ORIGIN=http://localhost:8082

# -----------------------------------------------------------------------------
# AI Gateway (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------

# Primary AI endpoint (OpenAI-compatible chat completions API)
# Multiple aliases supported; consulted in this order:
#   MAPLESPIKE_AI_ENDPOINT -> MAPLESPIKE_GATEWAY_URL -> AI_ENDPOINT
MAPLESPIKE_AI_ENDPOINT=http://127.0.0.1:8080/v1
MAPLESPIKE_GATEWAY_URL=http://nexus:30880/v1

# API key for the AI gateway (if required)
MAPLESPIKE_GATEWAY_API_KEY=

# AI model to use for chat / reasoning. Consulted in order:
#   MAPLESPIKE_AI_MODEL -> MAPLESPIKE_CHAT_MODEL -> AI_MODEL
MAPLESPIKE_AI_MODEL=qwen3.5-27b
MAPLESPIKE_CHAT_MODEL=qwen/qwen3-coder-30b-a3b-instruct
AI_MODEL=qwen3.5-27b

# OpenCorporates API key for corporate entity lookups
# Free key: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# OAuth / GitHub
# -----------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8082/v1/auth/github/callback
MAPLESPIKE_OAUTH_REDIRECT_BASE=http://localhost:8082/v1/auth/oauth

# -----------------------------------------------------------------------------
# PostgreSQL (API Server)
# -----------------------------------------------------------------------------

# Full connection string (takes precedence over individual vars below)
# DATABASE_URL=postgresql://user:password@localhost:5432/maplespike

# Individual Postgres connection parameters (used when STORAGE=postgres
# and DATABASE_URL is not set)
MAPLESPIKE_DB_HOST=localhost
MAPLESPIKE_DB_PORT=5432
MAPLESPIKE_DB_NAME=maplespike
MAPLESPIKE_DB_USER=maplespike
MAPLESPIKE_DB_PASSWORD=

# Legacy / engine Postgres vars (consulted separately by some components)
PGHOST=localhost
PGPORT=5432
PGDATABASE=maplespike
PGUSER=postgres
PGPASSWORD=postgres

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------

# Port for SSE transport (MCP server starts in SSE mode when PORT is set)
# Default: 3001
MCP_PORT=3001

# API server base URL that the MCP server talks to
MAPLESPIKE_API_URL=http://localhost:8082/v1

# Qdrant vector DB endpoint for semantic RAG context retrieval
# Default: http://qdrant:6333 (in-cluster DNS)
# MAPLESPIKE_QDRANT_ENDPOINT=http://qdrant:6333
# Qdrant collection name for document vectors (default: maplespike)
# MAPLESPIKE_QDRANT_COLLECTION=maplespike
# Embedding model for vector search (default: nvidia/llama-3.2-nv-embedqa-1b-v2)
# MAPLESPIKE_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Locale for CLI responses: en-CA or fr-CA
MAPLESPIKE_LOCALE=en-CA

# -----------------------------------------------------------------------------
# Notification Service
# -----------------------------------------------------------------------------

# SMTP configuration for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender identity for outgoing notifications
NOTIFICATION_FROM_EMAIL=noreply@maplespike.ca
NOTIFICATION_FROM_NAME=MapleSpike Alerts

# API base URL used in notification links (usually your API server)
MAPLESPIKE_API_BASE=http://localhost:8082

# How often to poll for pending notifications (milliseconds)
POLL_INTERVAL_MS=60000

# Max outbound emails per poll cycle
MAX_EMAILS_PER_CYCLE=50

# -----------------------------------------------------------------------------
# Treasury / Crypto Donation Addresses (billing routes)
# -----------------------------------------------------------------------------

MAPLESPIKE_TREASURY_SOLANA=
MAPLESPIKE_TREASURY_ETH=
MAPLESPIKE_TREASURY_BASE=
MAPLESPIKE_TREASURY_POLYGON=
MAPLESPIKE_TREASURY_ARBITRUM=
MAPLESPIKE_TREASURY_OPTIMISM=
MAPLESPIKE_TREASURY_AVALANCHE=
MAPLESPIKE_TREASURY_BNB=
MAPLESPIKE_TREASURY_TRON=
MAPLESPIKE_TREASURY_BITCOIN=

# -----------------------------------------------------------------------------
# Legal / Regulatory API Keys
# -----------------------------------------------------------------------------

# CanLII API key for Canadian legal document access
# https://www.canlii.org/en/info/api.html
CANLII_API_KEY=

# -----------------------------------------------------------------------------
# Deployment / Infrastructure
# -----------------------------------------------------------------------------

# Nexus (internal deployment host)
NEXUS_HOST=
NEXUS_USER=
NEXUS_SSH_KEY=

# Analytics domain for Plausible or similar
MAPLESPIKE_ANALYTICS_DOMAIN=
