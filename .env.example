# MapleSpike — Environment Variables Reference
# Copy to .env for local development

## API Server
MAPLESPIKE_API_KEY=dev-key
MAPLESPIKE_DB_PATH=./maplespike.db
PORT=8082
JWT_SECRET=change-in-production
APP_URL=http://localhost:8082

## AI Gateway
AI_ENDPOINT=http://127.0.0.1:8080/v1
AI_MODEL=qwen3.5-27b
MAPLESPIKE_GATEWAY_URL=http://nexus:30880/v1
MAPLESPIKE_GATEWAY_API_KEY=sk-your-key-here  # Optional, for authenticated gateway access
OPENCORPORATES_API_KEY=your-key-here  # Free API key from opencorporates.com/api_accounts/new
MAPLESPIKE_CHAT_MODEL=qwen/qwen3-coder-30b-a3b-instruct

## OAuth / GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8082/v1/auth/github/callback
MAPLESPIKE_OAUTH_REDIRECT_BASE=http://localhost:8082/v1/auth/oauth

## MCP Server
MAPLESPIKE_API_URL=http://maplespike-api:8084/v1
MAPLESPIKE_LOCALE=en-CA

## Postgres (Engine)
PGHOST=localhost
PGPORT=5432
PGDATABASE=maplespike
PGUSER=postgres
PGPASSWORD=postgres

## Legal
CANLII_API_KEY=

## Deploy
NEXUS_HOST=
NEXUS_USER=
NEXUS_SSH_KEY=
MAPLESPIKE_ANALYTICS_DOMAIN=
