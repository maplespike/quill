{
  "name": "quill",
  "version": "0.4.0",
  "private": true,
  "description": "MapleSpike — civilian intelligence data platform",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "undici": ">=8.10.2",
    "nodemailer": ">=10.1.4",
    "ws": ">=8.21.0",
    "uuid": ">=11.1.1",
    "esbuild": ">=0.28.1",
    "vite": "^8.0.0",
    "@babel/core": ">=7.29.6",
    "bigint-buffer": "npm:bigint-buffer-fixed@1.1.6",
    "tar": ">=7.5.16"
  },
  "scripts": {
    "build": "turbo build",
    "generate-metrics": "node scripts/generate-metrics.mjs",
    "audit:open-source": "node scripts/audit-open-source.mjs",
    "audit:open-source:prod": "node scripts/audit-open-source.mjs --prod",
    "test:audit:open-source": "node --test scripts/test-audit-open-source.mjs",
    "generate-data-licenses": "node scripts/generate-data-licenses.mjs",
    "test:data-licenses": "node --test scripts/test-data-licenses.mjs",
    "test:source-compliance": "node scripts/gates/check-source-compliance.mjs",
    "test:source-compliance-unit": "node --test scripts/test-source-compliance.mjs",
    "test:license": "node --test scripts/test-license-coherence.mjs",
    "test:search-corpus-policy": "pnpm exec tsx --test scripts/test-search-corpus-policy.mts",
    "check:artifact-drift": "node scripts/check-portal-artifact-drift.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:quill": "pnpm --filter @maplespike/quill-mcp build",
    "build:api": "pnpm --filter @maplespike/api-server build",
    "build:pipeline": "pnpm --filter @maplespike/pipeline-core build",
    "build:engine": "pnpm --filter @maplespike/engine build",
    "build:sdk": "pnpm --filter @maplespike/sdk build",
    "test": "turbo test && pnpm run test:docs && pnpm run test:external && pnpm run test:ca && pnpm run test:pins && pnpm run test:node-images && pnpm run test:chart-ingest-deadlines && pnpm run test:chart-probes && pnpm run test:lockstep && pnpm run test:secrets-history && pnpm run test:gitignore && pnpm run test:workflow-gh && pnpm run test:fork-runner && pnpm run test:release-workflow && pnpm run test:pages-gating && pnpm run test:readme-lint-flags && pnpm run test:hang-bounds && pnpm run test:stall-watchdog && pnpm run test:isolation-timeout && pnpm run test:search-corpus-policy && pnpm run test:source-compliance && pnpm run test:source-compliance-unit && pnpm run test:count-ts && pnpm run test:license",
    "test:packages": "turbo test",
    "test:docs": "pnpm exec tsx --test scripts/test-doc-links.mts scripts/test-flip-readiness.mts",
    "test:external": "pnpm exec tsx --test scripts/test-external-hosts.mts",
    "test:ca": "pnpm exec tsx --test scripts/test-ca-bundle.mts",
    "test:pins": "pnpm exec tsx --test scripts/test-image-pins.mts",
    "test:node-images": "pnpm exec tsx --test scripts/test-node-images.mts",
    "test:chart-probes": "pnpm exec tsx --test scripts/test-chart-probes.mts",
    "test:chart-ingest-deadlines": "pnpm exec tsx --test scripts/test-chart-ingest-deadlines.mts",
    "test:chart-priority-classes": "pnpm exec tsx --test scripts/test-chart-priority-classes.mts",
    "test:lockstep": "pnpm exec tsx --test scripts/test-secret-lockstep.mts",
    "test:stall-watchdog": "pnpm exec tsx --test scripts/test-stall-watchdog.mts",
    "test:isolation-timeout": "pnpm exec tsx --test scripts/test-isolation-timeout.mts",
    "test:count-ts": "pnpm exec tsx --test scripts/test-count-ts.mts",
    "test:secrets-history": "pnpm exec tsx --test scripts/test-secrets-history.mts",
    "test:gitignore": "pnpm exec tsx --test scripts/test-gitignore-leak-shapes.mts scripts/test-internal-addresses.mts",
    "test:workflow-yaml": "node scripts/gates/check-workflow-yaml.mjs",
    "audit:provenance": "python3 scripts/compare-provenance.py",
    "test:workflow-gh": "pnpm exec tsx --test scripts/test-workflow-gh-auth.mts",
    "test:fork-runner": "node --test scripts/test-fork-runner-policy.mjs",
    "test:release-workflow": "pnpm exec tsx --test scripts/test-release-workflow.mts",
    "test:pages-gating": "pnpm exec tsx --test scripts/test-deploy-docs-pages-gating.mts",
    "test:readme-lint-flags": "pnpm exec tsx --test scripts/test-readme-lint-flags.mts",
    "test:hang-bounds": "pnpm exec tsx --test scripts/test-hang-bounds.mts",
    "test:routes": "pnpm exec tsx --test 'packages/*/src/__integration__/**/*.test.ts'",
    "e2e:smoke": "bash scripts/e2e-smoke.sh --mode=local",
    "test:e2e:signup": "pnpm exec tsx scripts/e2e-signup-reveal.mts",
    "dev:up": "bash scripts/dev-up.sh",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.0",
    "@chenglou/pretext": "^0.0.8",
    "@eslint/js": "^10.0.1",
    "cloudflare": "^7.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "marked": "^18.1.3",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
}
