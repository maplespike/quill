{
  "name": "quill",
  "version": "0.4.0",
  "private": true,
  "description": "MapleSpike — civilian intelligence data platform",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "undici": ">=8.10.2",
    "nodemailer": ">=10.0.9",
    "ws": ">=8.21.0",
    "uuid": ">=11.1.1",
    "esbuild": ">=0.28.1",
    "vite": "^8.0.0",
    "@babel/core": ">=7.29.6",
    "bigint-buffer": "npm:bigint-buffer-fixed@1.1.6",
    "tar": ">=7.5.16"
  },
  "scripts": {
    "build": "turbo build",
    "generate-metrics": "node scripts/generate-metrics.mjs",
    "audit:open-source": "node scripts/audit-open-source.mjs",
    "audit:open-source:prod": "node scripts/audit-open-source.mjs --prod",
    "test:audit:open-source": "node --test scripts/test-audit-open-source.mjs",
    "generate-data-licenses": "node scripts/generate-data-licenses.mjs",
    "test:data-licenses": "node --test scripts/test-data-licenses.mjs",
    "test:search-corpus-policy": "pnpm exec tsx --test scripts/test-search-corpus-policy.mts",
    "check:artifact-drift": "node scripts/check-portal-artifact-drift.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:quill": "pnpm --filter @maplespike/quill-mcp build",
    "build:api": "pnpm --filter @maplespike/api-server build",
    "build:pipeline": "pnpm --filter @maplespike/pipeline-core build",
    "build:engine": "pnpm --filter @maplespike/engine build",
    "build:sdk": "pnpm --filter @maplespike/sdk build",
    "test": "turbo test && pnpm run test:docs && pnpm run test:external && pnpm run test:ca && pnpm run test:pins && pnpm run test:lockstep && pnpm run test:secrets-history && pnpm run test:gitignore && pnpm run test:workflow-gh && pnpm run test:hang-bounds && pnpm run test:stall-watchdog && pnpm run test:search-corpus-policy && pnpm run test:count-ts",
    "test:packages": "turbo test",
    "test:docs": "pnpm exec tsx --test scripts/test-doc-links.mts",
    "test:external": "pnpm exec tsx --test scripts/test-external-hosts.mts",
    "test:ca": "pnpm exec tsx --test scripts/test-ca-bundle.mts",
    "test:pins": "pnpm exec tsx --test scripts/test-image-pins.mts",
    "test:lockstep": "pnpm exec tsx --test scripts/test-secret-lockstep.mts",
    "test:stall-watchdog": "pnpm exec tsx --test scripts/test-stall-watchdog.mts",
    "test:count-ts": "pnpm exec tsx --test scripts/test-count-ts.mts",
    "test:secrets-history": "pnpm exec tsx --test scripts/test-secrets-history.mts",
    "test:gitignore": "pnpm exec tsx --test scripts/test-gitignore-leak-shapes.mts",
    "test:workflow-yaml": "node scripts/gates/check-workflow-yaml.mjs",
    "audit:provenance": "python3 scripts/compare-provenance.py",
    "test:workflow-gh": "pnpm exec tsx --test scripts/test-workflow-gh-auth.mts",
    "test:hang-bounds": "pnpm exec tsx --test scripts/test-hang-bounds.mts",
    "test:routes": "pnpm exec tsx --test 'packages/*/src/__integration__/**/*.test.ts'",
    "e2e:smoke": "bash scripts/e2e-smoke.sh --mode=local",
    "test:e2e:signup": "pnpm exec tsx scripts/e2e-signup-reveal.mts",
    "dev:up": "bash scripts/dev-up.sh",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1+sha512.dcffc7b9dc455aa8555b7c0a5f71c9032fa9ff0d31308a81d0d13cb6c642b4893698c9f1fb4d36d2ae7e77a891f048f09574a7c8a215a8b4a3af53818378a75b",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@chenglou/pretext": "^0.0.8",
    "@eslint/js": "^10.0.1",
    "cloudflare": "^7.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.7.0",
    "marked": "^18.0.6",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
}
