{
  "name": "maplespike",
  "version": "0.2.0",
  "private": true,
  "description": "MapleSpike — civilian intelligence data platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:docs": "node scripts/build-docs.mjs",
    "build:mcp": "pnpm --filter @maplespike/mcp-server build",
    "build:api": "pnpm --filter @maplespike/api-server build",
    "build:pipeline": "pnpm --filter @maplespike/pipeline-core build",
    "build:engine": "pnpm --filter @maplespike/engine build",
    "build:sdk": "pnpm --filter @maplespike/sdk build",
    "test": "pnpm -r test",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.dcffc7b9dc455aa8555b7c0a5f71c9032fa9ff0d31308a81d0d13cb6c642b4893698c9f1fb4d36d2ae7e77a891f048f09574a7c8a215a8b4a3af53818378a75b",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@chenglou/pretext": "^0.0.7",
    "marked": "^18.0.3"
  },
  "license": "AGPL-3.0-or-later"
}
