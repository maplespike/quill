{
  "name": "civint",
  "version": "0.1.0",
  "private": true,
  "description": "CivInt Canada — civilian intelligence data platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:pipeline": "pnpm --filter @civint/pipeline-core build",
    "build:engine": "pnpm --filter @civic-intel/core build",
    "build:web": "pnpm --filter @civic-intel/web build",
    "build:mcp": "pnpm --filter @civint/mcp-server build",
    "build:api": "pnpm --filter @civint/api-server build",
    "dev:web": "pnpm --filter @civic-intel/web dev",
    "test": "pnpm -r test",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=18"
  }
}
