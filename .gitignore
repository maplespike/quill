node_modules/
dist/
.wrangler/
data/
# The municipal-discovered-ids registry IS checked in — it's the build-time
# cache that eliminates first-call discovery latency on every pod restart.
# Without this exception the root-level `data/` rule swallows it (git treats
# that pattern as `**/data/`, so any nested data/ directory would be ignored).
!packages/pipeline-core/data/municipal-discovered-ids.json
*.db
*.db-shm
*.db-wal
.env
.env.*

# Age private key for MapleSpike Secret Vault
.secrets/key.txt

# SOPS — encrypted .yaml files ARE safe to commit (that's the point).
# Only ignore decrypted/plaintext artifacts:
secrets/decrypted/
secrets/*.dec
secrets/*.plaintext
secrets/*.env
!.env.example
.DS_Store
*.log
.pnpm-store/
*.tsbuildinfo
.next/
out/
test-results/
.devenv/
.playwright-mcp/
landing-page.png
*.bak
packages/engine/src/**/*.js
packages/engine/src/**/*.d.ts
packages/engine/src/**/*.js.map
packages/engine/src/**/*.d.ts.map

.turbo/

# Python
__pycache__/
*.pyc
*.pyo
.hermes/
state.json
.sisyphus/state.json
.sisyphus/run-continuation/

# Nix build artifacts
result

# Understand Anything knowledge graph (local codebase analysis)
.understand-anything/
*.egg-info/
.env.deployment
*.tgz

# Bug hunter artifacts
.bug-hunter/

# Internal state
.omo/

# Generated dependency audit (regenerated by scripts/gen-security-audit.mjs)
packages/portal/public/data/security/

