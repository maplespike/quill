# MapleSpike Quill API Server
# Multi-stage build: compile TypeScript in builder, run in slim runtime
# ARG stays BEFORE the first FROM (global scope) so it is usable in FROM lines.
# The matching ENV must NOT: an ENV before any FROM creates a stage-less meta
# instruction and BuildKit fails the whole build with
#   "failed to solve: no build stage in current context".
# Each stage re-declares ARG GIT_SHA before consuming it -- a global ARG is not
# in scope inside a stage, so ENV ${GIT_SHA} there would expand to empty.
ARG GIT_SHA=unknown
FROM docker.io/library/node:24-bookworm-slim AS builder
ARG GIT_SHA
ENV QUILL_BUILD_REV=${GIT_SHA}
WORKDIR /app

# Install pnpm and build dependencies (python3, make, g++ for native modules like better-sqlite3)
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      ca-certificates \
      python3 \
      make \
      g++ && \
    corepack enable && corepack prepare pnpm@10.32.1 --activate && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy entire workspace (respects .dockerignore — excludes node_modules, dist, .git)
COPY . .

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Bake a dependency-audit snapshot into the image.
#
# GET /v1/security/audit-summary serves this file. It does not run `pnpm audit`
# at request time (the runtime image has no pnpm, and a cold probe used to
# stall the route for many seconds before falling back here). Generate the
# snapshot in this stage, where pnpm and the lockfile exist. The script
# degrades to a placeholder carrying a `note` when the registry is unreachable;
# the route refuses placeholders and answers 503 instead of lying
# (QUILL-AUDIT.md 2026-10-24). Refresh later with
# `node scripts/gen-security-audit.mjs`. There is no scheduled job.
RUN node scripts/gen-security-audit.mjs || true
RUN mkdir -p packages/portal/public/data/security && \
    test -f packages/portal/public/data/security/audit.json || \
    printf '%s\n' '{"generatedAt":"1970-01-01T00:00:00.000Z","summary":{"total":0,"critical":0,"high":0,"moderate":0,"low":0,"info":0},"top":[],"note":"audit generation did not run at build time"}' \
      > packages/portal/public/data/security/audit.json

# Build api-server and its workspace dependency chain (database → pipeline-core → engine → api-server)
RUN pnpm --filter @maplespike/api-server... build

# ─── Runtime stage ───────────────────────────────────────────────────────────
FROM docker.io/library/node:24-bookworm-slim AS api-server
ARG GIT_SHA
ENV QUILL_BUILD_REV=${GIT_SHA}
WORKDIR /app

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Issue #778: GitHub OAuth token exchange fails with 'unable to get local issuer
# certificate' because the running image had no usable CA bundle. Debian's
# ca-certificates package installs the bundle at /etc/ssl/certs/ca-certificates.crt;
# we consolidate it into a single, stable, parameterized file so Node (via
# NODE_EXTRA_CA_CERTS, see entrypoint.sh) can validate outbound TLS.
RUN mkdir -p /usr/local/share/ca-certificates && \
    cp /etc/ssl/certs/ca-certificates.crt /usr/local/share/ca-certificates/ca-bundle.crt

# Copy built artifacts and production dependencies from builder
COPY --from=builder /app/package.json /app/
COPY --from=builder /app/packages/api-server/dist/ /app/packages/api-server/dist/
COPY --from=builder /app/packages/api-server/package.json /app/packages/api-server/
COPY --from=builder /app/packages/database/dist/ /app/packages/database/dist/
COPY --from=builder /app/packages/database/package.json /app/packages/database/
COPY --from=builder /app/packages/pipeline-core/dist/ /app/packages/pipeline-core/dist/
COPY --from=builder /app/packages/pipeline-core/package.json /app/packages/pipeline-core/
COPY --from=builder /app/packages/engine/dist/ /app/packages/engine/dist/
COPY --from=builder /app/packages/engine/package.json /app/packages/engine/
COPY --from=builder /app/node_modules/ /app/node_modules/

# Dependency-audit snapshot for /v1/security/audit-summary (see the builder
# stage note). A stable absolute path the route probes; QUILL_SECURITY_AUDIT_JSON
# below points at it explicitly so no cwd guessing is involved.
COPY --from=builder /app/packages/portal/public/data/security/audit.json /app/data/security/audit.json

# pnpm workspaces with inject-workspace-packages=true: each package's runtime
# deps (pino, better-sqlite3, etc.) live as symlinks under the *per-package*
# node_modules dir, pointing into the .pnpm store at the workspace root. The
# root /app/node_modules copy above contains the .pnpm store, but ESM module
# resolution starts at the importing file's own node_modules — so copy each
# package's node_modules (symlink trees) into the runtime stage too.
COPY --from=builder /app/packages/api-server/node_modules/ /app/packages/api-server/node_modules/
COPY --from=builder /app/packages/database/node_modules/ /app/packages/database/node_modules/
COPY --from=builder /app/packages/pipeline-core/node_modules/ /app/packages/pipeline-core/node_modules/
COPY --from=builder /app/packages/engine/node_modules/ /app/packages/engine/node_modules/

# pnpm workspaces: the runtime stage only copies dist+package.json for
# workspace deps, so the @maplespike/* links pnpm normally creates under
# node_modules are missing. Recreate them so ESM resolution works.
RUN mkdir -p /app/node_modules/@maplespike \
 && ln -s /app/packages/pipeline-core /app/node_modules/@maplespike/pipeline-core \
 && ln -s /app/packages/database /app/node_modules/@maplespike/database \
 && ln -s /app/packages/engine /app/node_modules/@maplespike/engine

# inject-workspace-packages=true: pnpm materializes *injected copies* of
# workspace deps inside each .pnpm store package's node_modules/@maplespike/.
# Those copies are taken at `pnpm install` time — before tsc builds dist/ — so
# they only contain .turbo and ESM resolution fails (ERR_MODULE_NOT_FOUND for
# @maplespike/database imported from the store's pipeline-core copy). Replace
# every injected workspace leaf with a symlink to the built /app/packages/*.
RUN set -e; for d in /app/node_modules/.pnpm/@maplespike+*@*/node_modules/@maplespike; do \
      [ -d "$d" ] || continue; \
      for p in database pipeline-core engine; do \
        rm -rf "$d/$p"; ln -s "/app/packages/$p" "$d/$p"; \
      done; \
    done

ENV NODE_ENV=production
ENV PORT=8082
# Parameterized CA bundle path consumed by entrypoint.sh -> NODE_EXTRA_CA_CERTS
ENV CA_CERT_PATH=/usr/local/share/ca-certificates/ca-bundle.crt
# Snapshot path for GET /v1/security/audit-summary (baked by the builder stage).
ENV QUILL_SECURITY_AUDIT_JSON=/app/data/security/audit.json
EXPOSE 8082

# Wrapper entrypoint exports NODE_EXTRA_CA_CERTS and execs node (issue #778)
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER 1001
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["packages/api-server/dist/dev-server.js"]
