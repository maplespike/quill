{
  "name": "@maplespike/legislation",
  "version": "0.2.0",
  "description": "MapleSpike Legislation — point-in-time federal and provincial legislation via Justice Canada XML repo and provincial CKAN portals",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "canada",
    "legislation",
    "justice-laws",
    "statutes",
    "regulations",
    "point-in-time",
    "maplespike"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/reverb256/quill.git",
    "directory": "packages/legislation"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@maplespike/legal-core": "workspace:^"
  },
  "sideEffects": false
}
