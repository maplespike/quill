{
  "name": "@maplespike/quill-mcp",
  "version": "0.4.0",
  "description": "MapleSpike Quill \u2014 data-layer MCP server for AI agent consumption of Canadian public records (ADR 0005)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "quill-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings=0",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node dist/cli.js",
    "start:sse": "node dist/index.js",
    "test": "tsx --test 'src/__tests__/**/*.test.ts' 'src/__integration__/**/*.test.ts'",
    "test:unit": "tsx --test 'src/__tests__/**/*.test.ts'",
    "test:mcp-routes": "tsx --test 'src/__integration__/http-routes.test.ts'",
    "test:integration": "tsx --test 'src/__integration__/**/*.test.ts'",
    "test:all": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --experimental-test-coverage --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@maplespike/database": "workspace:*",
    "@maplespike/pipeline-core": "workspace:*",
    "jose": "^5.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}