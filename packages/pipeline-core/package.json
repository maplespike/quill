{
  "name": "@maplespike/pipeline-core",
  "version": "0.2.0",
  "description": "Core data pipeline: ingestion, curation, verification, and audit for Canadian civic data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --import tsx --test 'src/__tests__/**/*.test.ts' 'src/ingestion/__tests__/**/*.test.ts' 'src/ingestion/*/__tests__/**/*.test.ts'",
    "test:coverage": "node --import tsx --experimental-test-coverage --test 'src/__tests__/**/*.test.ts' 'src/ingestion/__tests__/**/*.test.ts' 'src/ingestion/*/__tests__/**/*.test.ts'",
    "heartbeat": "node scripts/push-heartbeat.mjs"
  },
  "dependencies": {
    "@maplespike/database": "workspace:*",
    "amqplib": "^0.10.5",
    "fast-xml-parser": "^5.8.0",
    "undici": "^8.2.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "sideEffects": false,
  "license": "AGPL-3.0-or-later"
}
