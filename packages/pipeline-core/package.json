{
  "name": "@maplespike/pipeline-core",
  "version": "0.2.0",
  "description": "Core data pipeline: ingestion, curation, verification, and audit for Canadian civic data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-framework": {
      "import": "./dist/test-framework/index.js",
      "types": "./dist/test-framework/index.d.ts"
    },
    "./health-monitoring": {
      "import": "./dist/health-monitoring/index.js",
      "types": "./dist/health-monitoring/index.d.ts"
    },
    "./doc-generator": {
      "import": "./dist/doc-generator/index.js",
      "types": "./dist/doc-generator/index.d.ts"
    },
    "./ontario-provincial": {
      "import": "./dist/ingestion/ontario-provincial/index.js",
      "types": "./dist/ingestion/ontario-provincial/index.d.ts"
    },
    "./worldbank-wdi": {
      "import": "./dist/ingestion/worldbank-wdi/index.js",
      "types": "./dist/ingestion/worldbank-wdi/index.d.ts"
    },
    "./un-comtrade": {
      "import": "./dist/ingestion/un-comtrade/index.js",
      "types": "./dist/ingestion/un-comtrade/index.d.ts"
    },
    "./gtfs-transit": {
      "import": "./dist/ingestion/gtfs-transit/index.js",
      "types": "./dist/ingestion/gtfs-transit/index.d.ts"
    },
    "./police-data": {
      "import": "./dist/ingestion/police-data/index.js",
      "types": "./dist/ingestion/police-data/index.d.ts"
    },
    "./political-donations": {
      "import": "./dist/ingestion/political-donations/index.js",
      "types": "./dist/ingestion/political-donations/index.d.ts"
    },
    "./parliamentary-voting": {
      "import": "./dist/ingestion/parliamentary-voting/index.js",
      "types": "./dist/ingestion/parliamentary-voting/index.d.ts"
    },
    "./public-accounts": {
      "import": "./dist/ingestion/public-accounts/index.js",
      "types": "./dist/ingestion/public-accounts/index.d.ts"
    },
    "./fire-emergency": {
      "import": "./dist/ingestion/fire-emergency/index.js"
    },
    "./oecd-stat": {
      "import": "./dist/ingestion/oecd-stat/index.js"
    },
    "./oecd": {
      "import": "./dist/ingestion/oecd/index.js",
      "types": "./dist/ingestion/oecd/index.d.ts"
    },
    "./undp-hdi": {
      "import": "./dist/ingestion/undp-hdi/index.js"
    },
    "./unhcr-refugees": {
      "import": "./dist/ingestion/unhcr-refugees/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "tsx --test src/**/*.test.ts src/ingestion/__tests__/*.test.ts",
    "test:coverage": "tsx --experimental-test-coverage --test src/**/*.test.ts",
    "heartbeat": "node scripts/push-heartbeat.mjs"
  },
  "dependencies": {
    "@maplespike/database": "workspace:*",
    "amqplib": "^0.10.5",
    "fast-xml-parser": "^5.8.0",
    "undici": "^8.2.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false,
  "license": "AGPL-3.0-or-later"
}
