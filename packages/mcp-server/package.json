{
  "name": "@maplespike/mcp-server",
  "version": "0.2.0",
  "description": "MapleSpike MCP Server - tools wrapping pipeline-core for AI agent consumption",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maplespike-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node dist/cli.js",
    "start:sse": "node dist/index.js",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --experimental-test-coverage --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@maplespike/database": "workspace:*",
    "@maplespike/pipeline-core": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}
