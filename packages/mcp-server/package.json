{
  "name": "@maplespike/mcp-server",
  "version": "0.1.0",
  "description": "MapleSpike MCP Server — 6 tools wrapping pipeline-core for AI agent consumption",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maplespike-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node dist/cli.js",
    "start:sse": "node dist/index.js",
    "test": "tsx --test 'src/**/*.test.ts'"
    "test:coverage": "tsx --experimental-test-coverage --test src/**/*.test.ts",
  },
  "dependencies": {
    "@maplespike/pipeline-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}
