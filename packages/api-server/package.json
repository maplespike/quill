{
  "name": "@maplespike/api-server",
  "version": "0.2.0",
  "description": "MapleSpike API Gateway - multi-tenant REST gateway wrapping pipeline-core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "node dist/dev-server.js",
    "dev:watch": "tsc --watch & node --watch dist/dev-server.js",
    "test": "pnpm build && tsx --test src/*.test.ts src/**/*.test.ts",
    "test:coverage": "tsx --experimental-test-coverage --test src/**/*.test.ts"
  },
  "dependencies": {
    "@dexterai/x402": "^5.1.0",
    "@hono/zod-validator": "^0.2.0",
    "@maplespike/engine": "workspace:*",
    "@maplespike/pipeline-core": "workspace:*",
    "@simplewebauthn/server": "^13.3.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.0",
    "imap": "^0.8.19",
    "mailparser": "^3.7.1",
    "nanoid": "^5.0.7",
    "pg": "^8.20.0",
    "viem": "^2.48.11",
    "pino": "^10.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241201.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/imap": "^0.8.40",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "undici": "^8.5.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}
