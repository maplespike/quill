{
  "name": "@maplespike/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrations/migrate.ts"
  },
  "dependencies": {
    "@maplespike/database": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "fuse.js": "^7.5.0",
    "pg": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "sideEffects": false,
  "license": "AGPL-3.0-or-later"
}
