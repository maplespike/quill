{
  "name": "@maplespike/sdk",
  "version": "0.2.0",
  "description": "MapleSpike TypeScript SDK — typed client for Canadian civic data: parliamentary, corporate, regulatory, immigration, and more",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "pnpm build && tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "canada", "civic-tech", "government", "open-data",
    "parliament", "lobbying", "immigration", "elections",
    "transparency", "maplespike"
  ],
  "license": "MIT",
  "homepage": "https://maplespike.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/reverb256/maplespike.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/reverb256/maplespike/issues",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
