{
  "name": "@maplespike/sdk",
  "version": "0.2.0",
  "description": "MapleSpike TypeScript SDK — typed client for Canadian civic data: parliamentary, corporate, regulatory, immigration, and more",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "pnpm build && tsx --test src/*.test.ts",
    "test:coverage": "tsx --experimental-test-coverage --test src/**/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "canada",
    "civic-tech",
    "government",
    "open-data",
    "parliament",
    "lobbying",
    "immigration",
    "elections",
    "transparency",
    "maplespike"
  ],
  "license": "Apache-2.0",
  "homepage": "https://maplespike.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/reverb256/quill.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/reverb256/quill/issues",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "dependencies": {
    "@maplespike/i18n": "workspace:*",
    "zod": "^4.6.7"
  }
}
