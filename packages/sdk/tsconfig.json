{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["src/agents.ts", "src/auth.ts", "src/index.ts", "src/query.ts", "src/schemas.ts", "src/types.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
