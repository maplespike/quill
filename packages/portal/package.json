{
  "name": "@maplespike/portal",
  "version": "0.3.0",
  "private": true,
  "description": "MapleSpike — Developer Portal (Astro + Tailwind v4 + shadcn/ui)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm gen:all && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pages:dev": "wrangler pages dev dist",
    "pages:build": "pnpm gen:all && astro build",
    "pages:deploy": "wrangler pages deploy dist --project-name=maplespike-quill",
    "gen:agents": "node scripts/generate-agents-json.mjs",
    "gen:openapi": "node scripts/generate-openapi.mjs",
    "gen:data": "node scripts/generate-pipeline-data.mjs",
    "gen:real-data": "node scripts/generate-real-data.mjs",
    "gen:committees": "node scripts/fetch-real-committees.mjs",
    "gen:llms": "node scripts/generate-llms.mjs",
    "gen:security": "node ../../scripts/gen-security-audit.mjs",
    "gen:pipeline": "timeout 60 node scripts/generate-pipeline-data.mjs || true",
    "gen:all": "node scripts/generate-agents-json.mjs && node scripts/generate-openapi.mjs && timeout 60 node scripts/generate-pipeline-data.mjs || true && node scripts/generate-llms.mjs && node ../../scripts/gen-security-audit.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@maplespike/i18n": "workspace:^",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "4.3.2",
    "astro": "^7.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.510.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.76.0",
    "tailwind-merge": "^3.2.0",
    "three": "^0.176.0",
    "tw-animate-css": "^1.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@maplespike/quill-mcp": "workspace:*",
    "@maplespike/sdk": "workspace:*",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "license": "MIT"
}
