    "gen:llms": "node scripts/generate-llms.mjs",
    "gen:security": "node ../../scripts/gen-security-audit.mjs",
    "gen:all": "node scripts/generate-agents-json.mjs && node scripts/generate-openapi.mjs && node scripts/generate-pipeline-data.mjs && node scripts/generate-llms.mjs && node ../../scripts/gen-security-audit.mjs"
