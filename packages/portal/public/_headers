# Cloudflare Pages _headers — apply to every route
# See https://developers.cloudflare.com/pages/configuration/headers/
#
# Stripe embedded checkout needs three origins this file used to omit:
#   script-src  https://js.stripe.com        (the SDK the island loadStripe()s)
#   frame-src   https://js.stripe.com, https://hooks.stripe.com   (the form is an iframe;
#               with no frame-src the page falls back to default-src 'self' and the form
#               never appears)
#   connect-src https://api.stripe.com       (Stripe.js calls the API from the browser)
# 2026-11-23: without these the live page rendered "Payment form could not load: Failed to
# load Stripe.js" for a real, signed-in session. server.py had the directives; this copy did
# not, and the CSP test only compared analytics hosts across the copies.
#
# DO NOT EDIT THIS POLICY IN ISOLATION. This file, server.py's CSP constant and
# nginx.conf are three copies for three servers, and tests/server-csp.test.ts now asserts
# all three carry exactly the same directives, sources and values. Edit all three together.
# Google Fonts, https://www.google.com and *.googleusercontent.com were removed the same day:
# nothing in the portal references them (the theme uses local fonts, see
# src/styles/themes/ink-and-paper.css), so they only widened the policy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cache-Control: public, no-transform
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: https://static.cloudflareinsights.com https://plausible.io https://js.stripe.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.stripe.com; connect-src 'self' https://*.maplespike.ca https://*.quill.maplespike.ca https://cloudflareinsights.com https://plausible.io https://api.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; media-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/config.js
  Cache-Control: public, max-age=60

/auth.js
  Cache-Control: public, max-age=60

/nav-scroll.js
  Cache-Control: public, max-age=60

/script.js
  Cache-Control: public, max-age=60

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: Content-Type
  Cache-Control: public, max-age=3600
