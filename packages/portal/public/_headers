# Cloudflare Pages HTTP response headers for maplespike-brand.
#
# CSP aligned with dist/_headers (deployed) — adds Cloudflare Insights
# beacon to script-src so the analytics tag isn't blocked. Convex endpoints
# kept open for the Astral/MapleSpike auth bridge. See DEPLOY.md §Security.

# ─── Astro-emitted chunks + assets ─────────────────────────────────
# Astro's default chunkFileNames/assetFileNames/entryFileNames all use
# `_astro/[name]-[hash][extname]`. The hash is a content fingerprint, so
# the URL changes whenever the bytes do — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ─── Image / other root-level assets (kept for legacy + future imports) ─
# Source imports like `import logo from '@/assets/logo.svg'` resolve at build
# time. Today none fall under /assets/ (assets emit to /_astro/ by Astro's
# default assetFileNames), but this rule is kept in case any future path-
# intutive consumption (`<img src="/assets/foo.svg">`, public/ promotion, etc.)
# shows up.
# Re-audit on the next chunk-graph change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.maplespike.ca https://*.convex.cloud https://*.convex.site https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; media-src 'self' data: blob:; upgrade-insecure-requests

/*

  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.maplespike.ca https://*.convex.cloud https://*.convex.site https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; media-src 'self' data: blob:; upgrade-insecure-requests
