{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Quill 'Public Record' (ink-and-paper) colour tokens, W3C DTCG 2025.10. OKLCH canonical; hex = exact sRGB value enforced by ink-and-paper.test.ts.",
  "color": {
    "$type": "color",
    "paper": {
      "page": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.961,
            0.0083,
            91.48
          ],
          "alpha": 1,
          "hex": "#f4f2ec"
        }
      },
      "deep": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.9159,
            0.0154,
            90.24
          ],
          "alpha": 1,
          "hex": "#e7e3d8"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.9848,
            0.0054,
            95.1
          ],
          "alpha": 1,
          "hex": "#fbfaf6"
        }
      },
      "chip": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.9314,
            0.014,
            88.69
          ],
          "alpha": 1,
          "hex": "#ece8de"
        }
      },
      "line": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.8829,
            0.0171,
            88.01
          ],
          "alpha": 1,
          "hex": "#ddd8cc"
        }
      },
      "line-strong": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.834,
            0.0232,
            87.16
          ],
          "alpha": 1,
          "hex": "#cfc8b8"
        }
      }
    },
    "ink": {
      "ink": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.1994,
            0.0039,
            106.75
          ],
          "alpha": 1,
          "hex": "#161614"
        },
        "$description": "16.19:1 on paper, APCA Lc 97"
      },
      "soft": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.2917,
            0.0071,
            106.83
          ],
          "alpha": 1,
          "hex": "#2c2c28"
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.4286,
            0.0154,
            86.89
          ],
          "alpha": 1,
          "hex": "#534f46"
        },
        "$description": "7.29:1 on paper, APCA Lc 80.5"
      }
    },
    "accent": {
      "editorial-red": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.4884,
            0.1554,
            27.78
          ],
          "alpha": 1,
          "hex": "#a63029"
        },
        "$description": "6.10:1 on paper, APCA Lc 74.7. Markers, active underlines, numbered labels, display emphasis.",
        "$extensions": {
          "ca.maplespike": {
            "p3": "oklch(48.84% 0.1832 27.78)"
          }
        }
      }
    },
    "on-ink": {
      "text": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.9673,
            0.007,
            88.64
          ],
          "alpha": 1,
          "hex": "#f6f4ef"
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.7732,
            0.016,
            90.27
          ],
          "alpha": 1,
          "hex": "#b9b5aa"
        }
      },
      "line": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.3464,
            0.0102,
            106.92
          ],
          "alpha": 1,
          "hex": "#3a3a34"
        }
      },
      "console": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.2296,
            0.0057,
            106.84
          ],
          "alpha": 1,
          "hex": "#1d1d1a"
        }
      }
    }
  }
}
