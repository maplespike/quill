---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingBody from "@/components/LandingBody.astro";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "fr" } },
  ];
}

const { locale } = Astro.params;
---

<BaseLayout
  title="Quill · Canada's open data, on tap for any AI"
  description="Connect any AI chatbot to all Canadian government data — 174 MCP tools, cited and verifiable. One line of config."
  lang={locale as "en" | "fr"}
>
  <LandingBody lang={locale} />
</BaseLayout>
