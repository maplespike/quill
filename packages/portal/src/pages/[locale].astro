---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingBody from "@/components/LandingBody.astro";
import statsData from "@/data/stats.json";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "fr" } },
  ];
}

const { locale } = Astro.params;
const isFr = locale === "fr";
---

<BaseLayout
  title={isFr
    ? "Quill · Les données publiques du Canada, à portée de toute IA"
    : "Quill · Canada's open data, on tap for any AI"}
  description={isFr
    ? `Connectez n'importe quel chatbot IA à toutes les données gouvernementales canadiennes — ${statsData.tools} outils MCP, cités et vérifiables. Une ligne de configuration.`
    : `Connect any AI chatbot to all Canadian government data — ${statsData.tools} MCP tools, cited and verifiable. One line of config.`}
  lang={locale as "en" | "fr"}
>
  <LandingBody lang={locale} />
</BaseLayout>
