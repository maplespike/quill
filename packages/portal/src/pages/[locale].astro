---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingBody from "@/components/LandingBody.astro";
import statsData from "@/data/stats.json";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "fr" } },
  ];
}

const { locale } = Astro.params;
const isFr = locale === "fr";
---

<BaseLayout
  title={isFr
    ? "Quill · Des sources du secteur public, accessibles aux outils d'IA"
    : "Quill · Public-sector sources for AI tools"}
  description={isFr
    ? `Connectez un chatbot IA aux outils de recherche du secteur public de Quill — ${statsData.tools} outils MCP. La couverture et les conditions varient selon la source.`
    : `Connect an AI chatbot to Quill's public-sector search tools — ${statsData.tools} MCP tools. Source coverage and terms vary.`}
  lang={locale as "en" | "fr"}
>
  <LandingBody lang={locale} />
</BaseLayout>
