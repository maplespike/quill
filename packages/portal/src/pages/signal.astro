---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { localeUrl } from "@/utils/localeUrl";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('signal.title')} lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <Badge variant="outline" className="mb-4 border-primary/30 bg-primary/5 text-primary">{t("Real-time engine signals", "Signaux moteur en temps réel")}</Badge>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Intelligence&nbsp;<span class="text-gradient">Signals</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        {t(
          `Cross-referenced signals from ${statsData.modules} data modules — lobbying spikes, regulatory changes, committee activity, and corporate influence patterns detected by the MapleSpike engine.`,
          `Signaux recoupés provenant de ${statsData.modules} modules de données — pics de lobbying, changements réglementaires, activité des comités et schémas d'influence des entreprises détectés par le moteur MapleSpike.`,
          
        )}
      </p>
    </div>
  </section>

  <!-- Signals -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div data-signal-state="empty" class="rounded-xl border border-border/60 bg-card/40 p-8 text-center">
        <p class="text-base font-medium">{t("No signals to show", "Aucun signal à afficher")}</p>
        <p class="mt-2 text-sm text-muted-foreground">
          {t(
            "Signals show here when the engine publishes them.",
            "Les signaux s'affichent ici lorsque le moteur les publie.",
          )}
        </p>
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-muted-foreground">
          {t(
            `Signals are generated by the MapleSpike cross-reference engine, correlating data across all ${statsData.modules} ingestion modules with trust-score validation ≥60%.`,
            `Les signaux sont générés par le moteur de recoupement de MapleSpike, corrélant les données de l'ensemble des ${statsData.modules} modules d'ingestion avec une validation de score de confiance ≥60 %.`,
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-t py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto grid max-w-4xl grid-cols-2 gap-8 md:grid-cols-4">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">0</div>
          <div class="mt-1 text-sm text-muted-foreground">{t("Active signals today", "Signaux actifs aujourd'hui")}</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">{statsData.modules}</div>
          <div class="mt-1 text-sm text-muted-foreground">{t("Monitored data modules", "Modules de données surveillés")}</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">273</div>
          <div class="mt-1 text-sm text-muted-foreground">{t("Tracked regulators", "Organismes de réglementation suivis")}</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">15m</div>
          <div class="mt-1 text-sm text-muted-foreground">{t("Avg detection latency", "Latence moyenne de détection")}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="aurora relative overflow-hidden border-t py-16 md:py-20">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl mb-4">
        {t("Get real-time government intelligence", "Obtenez de l'intelligence gouvernementale en temps réel")}
      </h2>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        {t(
          "Pro plan includes real-time cross-referencing, unlimited history, and priority API access. Start your free trial today — no credit card required.",
          "Le forfait Pro inclut le recoupement en temps réel, un historique illimité et un accès API prioritaire. Commencez votre essai gratuit aujourd'hui — aucune carte de crédit requise.",
        )}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={localeUrl('/signup?plan=pro', lang)} class="btn-sheen inline-flex h-12 items-center rounded-full px-8 text-base font-medium text-primary-foreground">{t("Start Free Trial", "Commencer l'essai gratuit")}</a>
        <a href={localeUrl('/pricing', lang)} class="inline-flex h-12 items-center rounded-full border px-8 text-base font-medium hover:bg-foreground/[0.04] transition-colors">{t("Compare Plans", "Comparer les forfaits")}</a>
      </div>
    </div>
  </section>
</BaseLayout>
