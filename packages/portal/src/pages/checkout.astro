---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmbeddedCheckoutIsland from "@/components/EmbeddedCheckout";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const t = (en: string, fr: string) => pick(lang, en, fr);
const planParam = Astro.url.searchParams.get("plan") || "pro";
const ALLOWED = new Set(["pro", "business"]);
const planId = ALLOWED.has(planParam) ? planParam : "pro";
---

<BaseLayout
  title={t("Secure checkout — Quill by Maplespike", "Paiement sécurisé — Quill by Maplespike")}
  description={t(
    "Complete your Quill by Maplespike subscription without leaving the site. Card details are handled by Stripe.",
    "Complétez votre abonnement Quill by Maplespike sans quitter le site. Les données de carte sont traitées par Stripe."
  )}
  lang={lang}
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">
      {t("Secure checkout", "Paiement sécurisé")}
    </h1>
    <p class="mt-3 text-sm opacity-70">
      {t(
        "Payment is processed by Stripe. Maplespike never sees your card number.",
        "Le paiement est traité par Stripe. Maplespike ne voit jamais votre numéro de carte."
      )}
    </p>
    <div class="mt-8">
      <EmbeddedCheckoutIsland client:load planId={planId} />
    </div>
    <p class="mt-6 text-xs opacity-60">
      {t(
        "Prefer a hosted page? Use the pricing page — same subscription, either way.",
        "Vous préférez une page hébergée ? Utilisez la page des tarifs — même abonnement, peu importe."
      )}
    </p>
  </section>
</BaseLayout>
