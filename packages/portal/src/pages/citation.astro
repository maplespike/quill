---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { createI18n } from "@maplespike/i18n";
import { pick, pickBi, type Bi } from "@/utils/bilingual";

const citationExamples = [
  {
    label: { en: "Committee Evidence", fr: "Témoignages en comité" },
    example: { en: "House of Commons Standing Committee on Finance. Evidence, Meeting No. 42, 44th Parliament, 1st Session. March 15, 2026.", fr: "Comité permanent des finances de la Chambre des communes. Témoignages, réunion n° 42, 44e législature, 1re session. 15 mars 2026." },
    hash: "sha256:a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b",
    source: "ourcommons.ca",
  },
  {
    label: { en: "Lobbying Registry", fr: "Registre de lobbying" },
    example: { en: "Office of the Commissioner of Lobbying. Monthly Communication Report, Registrant #123456. February 2026.", fr: "Commissariat au lobbying. Rapport mensuel de communication, déclarant n° 123456. Février 2026." },
    hash: "sha256:b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c",
    source: "lobbycanada.gc.ca",
  },
  {
    label: { en: "Canada Gazette", fr: "Gazette du Canada" },
    example: { en: "Canada Gazette, Part I, Vol. 160, No. 12 — Proposed Regulations Amending the Food and Drug Regulations. March 22, 2026.", fr: "Gazette du Canada, partie I, vol. 160, n° 12 — Règlement modifiant le Règlement sur les aliments et drogues (projet). 22 mars 2026." },
    hash: "sha256:c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d",
    source: "gazette.gc.ca",
  },
  {
    label: { en: "Court Decision", fr: "Décision judiciaire" },
    example: { en: "Smith v. Canada (Attorney General), 2026 FC 456. Federal Court. March 10, 2026.", fr: "Smith c. Canada (Procureur général), 2026 CF 456. Cour fédérale. 10 mars 2026." },
    hash: "sha256:d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e",
    source: "canlii.org",
  },
];

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);
---

<BaseLayout
  title={i18n.t('citation.title')}
  description={t(
    "Quill citation policy — source provenance and SHA-256 integrity checks where available. Hashes do not establish source-data reuse rights.",
    "Politique de citation de Quill — provenance des sources et contrôles d'intégrité SHA-256 lorsqu'ils sont disponibles. Les hachages n'établissent pas les droits de réutilisation des données sources.",
  )}
  lang={lang}
>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          <span class="text-gradient">{i18n.t('citation.title')}</span>
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          {t(
            "Responses may expose a Quill record-integrity hash and source-artifact evidence when captured. These are separate hashes with separate scopes; neither alone proves a record came from a particular source. Check the original publisher's terms before reuse.",
            "Les réponses peuvent exposer un hachage d'intégrité d'enregistrement Quill et des preuves d'artefact source lorsqu'elles sont capturées. Ce sont des hachages distincts de portée différente; aucun ne prouve à lui seul qu'un enregistrement provient d'une source particulière. Consultez les conditions de l'éditeur d'origine avant toute réutilisation.",
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <Card className="text-center">
          <CardHeader>
            <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" /></svg>
            </div>
            <CardTitle className="text-lg">{t("Collect", "Collecter")}</CardTitle>
            <CardDescription>
              {t(
              "Data is fetched from government and other public-sector sources through APIs, CKAN portals, RSS feeds, and XML dumps. Source coverage and terms vary.",
              "Les données proviennent de sources gouvernementales et d'autres sources du secteur public, via des API, portails CKAN, flux RSS et extractions XML. La couverture et les conditions varient selon la source.",
              )}
            </CardDescription>
          </CardHeader>
        </Card>
        <Card className="text-center">
          <CardHeader>
            <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <CardTitle className="text-lg">{t("Verify", "Vérifier")}</CardTitle>
            <CardDescription>
              {t(
                "Quill's record hash covers canonicalized record JSON. Captured source-artifact hashes cover the HTTP-client response body; the evidence block reports retrieval time and response metadata when available. A matching request URL is labeled as such but does not verify that the response produced the record.",
                "Le hachage d'enregistrement de Quill couvre le JSON canonique de l'enregistrement. Les hachages d'artefact source capturés couvrent le corps de réponse HTTP fourni au client; le bloc de preuve indique l'heure de récupération et les métadonnées de réponse lorsqu'elles sont disponibles. Une URL de requête correspondante est indiquée comme telle, sans vérifier que la réponse a produit l'enregistrement.",
              )}
            </CardDescription>
          </CardHeader>
        </Card>
        <Card className="text-center">
          <CardHeader>
            <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" /></svg>
            </div>
            <CardTitle className="text-lg">{t("Cite", "Citer")}</CardTitle>
            <CardDescription>
              {t(
                "API responses may include citation hashes and verification commands. These support integrity checks; check the source's terms before reusing its material.",
                "Les réponses API peuvent inclure des hachages de citation et des commandes de vérification. Elles facilitent le contrôle d'intégrité; consultez les conditions de la source avant de réutiliser son contenu.",
              )}
            </CardDescription>
          </CardHeader>
        </Card>
      </div>

      <!-- Citation Hash Format -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">{t("Citation Hash Format", "Format du hachage de citation")}</h2>
      <Card className="mb-12">
        <CardHeader>
          <CardTitle className="text-base font-mono">sha256:&lt;64-hex-characters&gt;</CardTitle>
          <CardDescription>
            {t(
              "When supplied, a record-integrity citation uses SHA-256 with the",
              "Lorsqu'il est fourni, un hachage d'intégrité d'enregistrement utilise SHA-256 avec le préfixe",
            )} <code>sha256:</code>. {t(
              "It covers Quill's canonical JSON representation of that record, not the original HTTP response bytes.",
              "Il couvre la représentation JSON canonique de cet enregistrement par Quill, et non les octets de réponse HTTP d'origine.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <div class="rounded-md bg-muted p-4">
            <p class="text-sm font-mono text-muted-foreground break-all">
              sha256:a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b
            </p>
          </div>
          <p class="text-sm text-muted-foreground">
            {t(
              "When a citation includes a source URL and content hash, you can compare a retrieved copy with that hash to check whether the hashed content matches. This does not establish source authenticity or reuse rights.",
              "Lorsqu'une citation inclut une URL source et un hachage de contenu, vous pouvez comparer une copie récupérée à ce hachage pour vérifier si le contenu haché correspond. Cela n'établit ni l'authenticité de la source ni les droits de réutilisation.",
            )}
          </p>
        </CardContent>
      </Card>

      <!-- Verify Command -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">{t("Verifying a Citation", "Vérifier une citation")}</h2>
      <Card className="mb-12">
        <CardHeader>
          <CardTitle className="text-base">{t("Shell Verification", "Vérification en ligne de commande")}</CardTitle>
          <CardDescription>
            {t(
              "Some citation responses include a",
              "Certaines réponses de citation incluent un champ",
            )} <code>verify_command</code> {t(
              "field with a shell command to reproduce the record hash. This does not fetch or authenticate the upstream source artifact.",
              "avec une commande shell pour reproduire le hachage de l'enregistrement. Cela ne récupère ni n'authentifie l'artefact source en amont.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="rounded-md bg-muted p-4">
            <code class="text-sm text-muted-foreground break-all block">
              curl -s "https://api.maplespike.ca/v1/data/record/123" | sha256sum | cut -d' ' -f1<br />
              # Expected: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b
            </code>
          </div>
        </CardContent>
      </Card>

      <!-- Trust Score -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">{t("Trust Scores", "Scores de confiance")}</h2>
      <Card className="mb-12">
        <CardHeader>
          <CardTitle className="text-base">{t("How Trust Is Measured", "Comment la confiance est mesurée")}</CardTitle>
          <CardDescription>
            {t(
              "Where available, a trust score (0–100%) summarizes Quill's confidence signals for a record. It is not a legal or publisher verification.",
                "Lorsqu'il est disponible, un score de confiance (0–100 %) résume les indicateurs de confiance de Quill pour un enregistrement. Il ne s'agit pas d'une vérification juridique ou de l'éditeur.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-md border border-green-500/30 bg-green-500/5 p-4">
              <p class="text-sm font-semibold text-green-500 mb-1">90–100 % — {t("Verified", "Vérifié")}</p>
              <p class="text-xs text-muted-foreground">{t(
                "Example quality-score category only; a hash match verifies record integrity, not source identity or reuse rights.",
                "Exemple de catégorie de score de qualité uniquement; une correspondance de hachage vérifie l'intégrité de l'enregistrement, pas l'identité de la source ni les droits de réutilisation.",
              )}</p>
            </div>
            <div class="rounded-md border border-yellow-500/30 bg-yellow-500/5 p-4">
              <p class="text-sm font-semibold text-yellow-500 mb-1">60–89 % — {t("Sourced", "Sourcé")}</p>
              <p class="text-xs text-muted-foreground">{t(
                "Example category only; score signals are not an independent verification of publisher or source claims.",
                "Exemple de catégorie uniquement; les indicateurs du score ne constituent pas une vérification indépendante des déclarations de l'éditeur ou de la source.",
              )}</p>
            </div>
            <div class="rounded-md border border-red-500/30 bg-red-500/5 p-4">
              <p class="text-sm font-semibold text-red-500 mb-1">&lt;60 % — {t("Low Confidence", "Confiance faible")}</p>
              <p class="text-xs text-muted-foreground">{t(
                "Example category only; consult the supplied evidence and original source directly.",
                "Exemple de catégorie uniquement; consultez directement les preuves fournies et la source d'origine.",
              )}</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground">
            {t(
              "The minimum trust threshold for API responses is",
              "Le seuil de confiance minimal pour les réponses API est de",
            )} <strong>60 %</strong>. {t(
              "Records below this threshold are excluded from search results by default.",
              "Les enregistrements sous ce seuil sont exclus des résultats de recherche par défaut.",
            )}
          </p>
        </CardContent>
      </Card>

      <!-- Example Citations -->
      <h2 class="text-2xl font-bold tracking-tight mb-6">{i18n.t('citation.title')}</h2>
      <div class="space-y-6">
        {citationExamples.map((example) => (
          <Card key={example.label.en}>
            <CardHeader>
              <div class="flex items-center justify-between gap-2">
                <CardTitle className="text-base">{tb(example.label)}</CardTitle>
                <Badge variant="outline" className="font-mono text-[10px]">{example.source}</Badge>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              <p class="text-sm text-muted-foreground">{tb(example.example)}</p>
              <div class="rounded-md bg-muted p-3">
                <p class="text-xs font-mono text-muted-foreground break-all">{example.hash}</p>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      <!-- API Usage -->
      <h2 class="text-2xl font-bold tracking-tight mt-16 mb-6">{i18n.t('citation.source')}</h2>
      <Card>
        <CardHeader>
          <CardTitle className="text-base">{i18n.t('api_explorer.title')}</CardTitle>
          <CardDescription>
            {t(
              "Look up a citation by its SHA-256 hash using the API endpoint, when a hash is available.",
              "Recherchez une citation par son hachage SHA-256 à l'aide du point de terminaison API, lorsqu'un hachage est disponible.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <div class="rounded-md bg-muted p-4">
            <code class="text-sm text-muted-foreground block">
              GET /v1/citation/{`{sha256_hash}`}
            </code>
          </div>
          <div class="rounded-md bg-muted p-4">
            <p class="text-xs text-muted-foreground font-semibold mb-2">{t("Example response:", "Exemple de réponse :")}</p>
            <pre class="text-xs text-muted-foreground overflow-x-auto">{`{
  "success": true,
  "data": {
    "citation": {
      "source_name": "House of Commons",
      "source_url": "https://ourcommons.ca/...",
      "hash": "sha256:a1b2c3d4...",
      "license": "The publisher license was not declared in the metadata returned to Quill. Consult the publisher's terms.",
      "license_basis": "no-publisher-declaration",
      "retrieved_at": "2026-03-15T14:30:00Z"
    },
    "verify_command": "curl -s \"...\" | sha256sum | cut -d' ' -f1"
  }
}`}</pre>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- CTA -->
  <section class="aurora relative overflow-hidden border-t py-16 md:py-20">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl mb-4">
        {t("Start building with verifiable data", "Commencez à construire avec des données vérifiables")}
      </h2>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        {t(
          "Where available, SHA-256 citations help check data integrity. Check original publisher terms before reusing source material.",
          "Lorsqu'elles sont disponibles, les citations SHA-256 aident à contrôler l'intégrité des données. Consultez les conditions de l'éditeur d'origine avant de réutiliser le contenu source.",
        )}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/signup" class="btn-sheen inline-flex h-12 items-center rounded-full px-8 text-base font-medium text-primary-foreground">{t("Get Your Free API Key", "Obtenez votre clé API gratuite")}</a>
        <a href="/api-explorer" class="inline-flex h-12 items-center rounded-full border px-8 text-base font-medium hover:bg-foreground/[0.04] transition-colors">{t("Try the API Explorer", "Essayer l'explorateur API")}</a>
      </div>
    </div>
  </section>
</BaseLayout>
