---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('status.title')} description={t(
  "Real-time status of MapleSpike API, edge AI worker, MCP server, and data pipeline.",
  "État en temps réel de l'API MapleSpike, du travailleur IA de périphérie, du serveur MCP et du pipeline de données.",
)} lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="flex items-center gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
            {t("System", "État du")} <span class="text-gradient">{t("Status", "système")}</span>
          </h1>
          <p class="mt-2 text-muted-foreground">
            {t(
              "Real-time health of MapleSpike services. Auto-refreshes every 30 seconds.",
              "État en temps réel des services MapleSpike. Actualisation automatique toutes les 30 secondes.",
            )}
          </p>
        </div>
        <Badge variant="outline" className="ml-auto text-xs font-mono" id="last-check">
          {t("Checking…", "Vérification…")}
        </Badge>
      </div>
    </div>
  </section>

  <!-- Overall Status Banner -->
  <section class="py-6 md:py-8">
    <div class="container mx-auto px-4">
      <div id="overall-banner" class="rounded-xl border p-6 transition-colors">
        <div class="flex items-center gap-4">
          <div id="overall-spinner" class="h-4 w-4 animate-spin rounded-full border-2 border-muted-foreground border-t-transparent"></div>
          <div class="flex-1">
            <div id="overall-text" class="text-lg font-semibold">{t("Checking all services…", "Vérification de tous les services…")}</div>
            <div id="overall-sub" class="text-sm text-muted-foreground mt-0.5">{t("Fetching health from all endpoints", "Récupération de l'état de tous les points de terminaison")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Cards -->
  <section class="pb-8 md:pb-12">
    <div class="container mx-auto px-4">
      <div class="grid gap-4 md:grid-cols-2">
        <!-- API Server -->
        <Card className="service-card" data-service="api">
          <CardHeader>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="service-icon flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                </div>
                <div>
                  <CardTitle className="text-base">{t("API Server", "Serveur API")}</CardTitle>
                  <CardDescription className="text-xs">api.maplespike.ca</CardDescription>
                </div>
              </div>
              <Badge variant="outline" className="service-status text-xs">{t("Checking…", "Vérification…")}</Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Endpoint", "Point de terminaison")}</span><code class="text-xs font-mono">GET /v1/health</code></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Latency", "Latence")}</span><span class="service-latency font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Version", "Version")}</span><span class="service-version font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Dependencies", "Dépendances")}</span><span class="service-deps text-xs">—</span></div>
            </div>
          </CardContent>
        </Card>

        <!-- Edge AI Worker -->
        <Card className="service-card" data-service="edge">
          <CardHeader>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="service-icon flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2a10 10 0 0 0-10 10 10 10 0 0 0 10 10 10 10 0 0 0 10-10 10 10 0 0 0-10-10z"/><path d="M12 6v6l4 2"/></svg>
                </div>
                <div>
                  <CardTitle className="text-base">{t("Edge AI Worker", "Travailleur IA de périphérie")}</CardTitle>
                  <CardDescription className="text-xs">{t("Cloudflare Workers AI", "IA des Workers Cloudflare")}</CardDescription>
                </div>
              </div>
              <Badge variant="outline" className="service-status text-xs">{t("Checking…", "Vérification…")}</Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Endpoint", "Point de terminaison")}</span><code class="text-xs font-mono">GET /v1/health</code></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Latency", "Latence")}</span><span class="service-latency font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Model", "Modèle")}</span><span class="service-version font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Neuron budget", "Budget de neurones")}</span><span class="service-deps text-xs">—</span></div>
            </div>
          </CardContent>
        </Card>

        <!-- MCP Server -->
        <Card className="service-card" data-service="mcp">
          <CardHeader>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="service-icon flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
                </div>
                <div>
                  <CardTitle className="text-base">MCP {t("Server", "Serveur")}</CardTitle>
                  <CardDescription className="text-xs">mcp.maplespike.ca</CardDescription>
                </div>
              </div>
              <Badge variant="outline" className="service-status text-xs">{t("Checking…", "Vérification…")}</Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Endpoint", "Point de terminaison")}</span><code class="text-xs font-mono">{t("TCP reachability", "Joignabilité TCP")}</code></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Latency", "Latence")}</span><span class="service-latency font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Tools", "Outils")}</span><span class="service-version font-mono text-xs">{statsData.tools}</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Protocol", "Protocole")}</span><span class="service-deps text-xs">SSE + stdio</span></div>
            </div>
          </CardContent>
        </Card>

        <!-- Portal / Pages -->
        <Card className="service-card" data-service="portal">
          <CardHeader>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="service-icon flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                </div>
                <div>
                  <CardTitle className="text-base">{t("Portal", "Portail")}</CardTitle>
                  <CardDescription className="text-xs">maplespike.ca ({t("Cloudflare Pages", "Pages Cloudflare")})</CardDescription>
                </div>
              </div>
              <Badge variant="outline" className="service-status text-xs">{t("Checking…", "Vérification…")}</Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Endpoint", "Point de terminaison")}</span><code class="text-xs font-mono">GET /</code></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Latency", "Latence")}</span><span class="service-latency font-mono text-xs">—</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Pages", "Pages")}</span><span class="service-version font-mono text-xs">22</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">{t("Hosting", "Hébergement")}</span><span class="service-deps text-xs">CF Pages</span></div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Data freshness, municipal health, and coverage. Aggregate fields only. -->
      <div id="status-data-root" class="mt-6 space-y-6">
        <Card>
          <CardHeader>
            <CardTitle className="text-base">{t("Data freshness", "Fraîcheur des données")}</CardTitle>
            <CardDescription className="text-xs">{t(
              "Timestamps and freshness windows from GET /v1/status. This page is also prepared for status.maplespike.ca.",
              "Horodatages et fenêtres de fraîcheur de GET /v1/status. Cette page est aussi prête pour status.maplespike.ca.",
            )}</CardDescription>
          </CardHeader>
          <CardContent>
            <div id="freshness-panel">
              <p class="text-sm text-muted-foreground text-center py-4">{t("Loading freshness…", "Chargement de la fraîcheur…")}</p>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="text-base">{t("Municipal source health", "Santé des sources municipales")}</CardTitle>
            <CardDescription className="text-xs">{t(
              "Per-city cache state from GET /v1/municipal/health. Counts and timestamps only.",
              "État du cache par ville depuis GET /v1/municipal/health. Totaux et horodatages seulement.",
            )}</CardDescription>
          </CardHeader>
          <CardContent>
            <div id="municipal-health-panel">
              <p class="text-sm text-muted-foreground text-center py-4">{t("Loading source health…", "Chargement de la santé des sources…")}</p>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="text-base">{t("Municipal coverage", "Couverture municipale")}</CardTitle>
            <CardDescription className="text-xs">{t(
              "Cached datasets and success timestamps from GET /v1/municipal/coverage.",
              "Jeux en cache et horodatages de succès depuis GET /v1/municipal/coverage.",
            )}</CardDescription>
          </CardHeader>
          <CardContent>
            <div id="municipal-coverage-panel">
              <p class="text-sm text-muted-foreground text-center py-4">{t("Loading coverage…", "Chargement de la couverture…")}</p>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Dependency Detail Table -->
      <Card className="mt-6">
        <CardHeader>
          <CardTitle className="text-base">{t("API Dependency Breakdown", "Ventilation des dépendances de l'API")}</CardTitle>
          <CardDescription className="text-xs">{t(
            "Storage, cache, and engine status from the API health endpoint",
            "État du stockage, du cache et du moteur à partir du point de terminaison de santé de l'API",
          )}</CardDescription>
        </CardHeader>
        <CardContent>
          <div id="dep-table" class="space-y-2">
            <p class="text-sm text-muted-foreground text-center py-4">{t("Loading dependency details…", "Chargement des détails des dépendances…")}</p>
          </div>
        </CardContent>
      </Card>

      <!-- Incident History (placeholder for future) -->
      <Card className="mt-6">
        <CardHeader>
          <CardTitle className="text-base">{t("Incident History", "Historique des incidents")}</CardTitle>
          <CardDescription className="text-xs">{t(
            "Recent service disruptions and maintenance windows",
            "Interruptions de service et fenêtres de maintenance récentes",
          )}</CardDescription>
        </CardHeader>
        <CardContent>
          <div id="incident-list" class="space-y-3">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/30">
              <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span>
              <div class="flex-1">
                <div class="text-sm font-medium">{t("No recent incidents", "Aucun incident récent")}</div>
                <div class="text-xs text-muted-foreground">{t("All systems operational", "Tous les systèmes sont opérationnels")}</div>
              </div>
              <span class="text-xs text-muted-foreground font-mono">—</span>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Info note -->
      <p class="mt-6 text-center text-xs text-muted-foreground">
        {t(
          "Status checks run client-side from your browser. Results may differ from server-side monitoring. For programmatic health checks, use",
          "Les vérifications d'état s'exécutent côté client dans votre navigateur. Les résultats peuvent différer de la surveillance côté serveur. Pour des vérifications programmatiques, utilisez",
        )} <code class="font-mono">GET https://api.maplespike.ca/v1/health</code>, <code class="font-mono">/v1/status</code>, <code class="font-mono">/v1/municipal/health</code>, {t("and", "et")} <code class="font-mono">/v1/municipal/coverage</code>.
      </p>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (function () {
      "use strict";

      // Client-side locale for dynamic status strings
      var FR = window.__LANG === "fr";
      var S = {
        operational: FR ? "Opérationnel" : "Operational",
        reachable: FR ? "Joignable" : "Reachable",
        unreachable: FR ? "Injoignable" : "Unreachable",
        error: FR ? "Erreur" : "Error",
        healthy: FR ? " en santé" : " healthy",
        neurons: FR ? " neurones utilisés" : " neurons used",
        checking: FR ? "Vérification de tous les services…" : "Checking all services…",
        fetching: FR ? "Récupération de l'état de tous les points de terminaison" : "Fetching health from all endpoints",
        allOps: FR ? "Tous les systèmes sont opérationnels" : "All systems operational",
        online: FR ? " services en ligne" : " services online",
        partial: FR ? "Dégradation partielle du service" : "Partial service degradation",
        partialSub: FR ? " services en ligne — certains points de terminaison injoignables" : " services online — some endpoints unreachable",
        allDown: FR ? "Tous les services injoignables" : "All services unreachable",
        updated: FR ? "Mis à jour à " : "Updated ",
        timeLocale: FR ? "fr-CA" : "en-CA",
      };

      var cfg = window.MAPLESPIKE || {};
      var apiBase = cfg.apiBase || "https://api.maplespike.ca";
      var edgeBase = cfg.edgeUrl || "https://ai.maplespike.ca";
      var portalBase = window.location.origin;
      var mcpBase = "https://mcp.maplespike.ca";

      function escapeHtml(str) {
        var div = document.createElement("div");
        div.textContent = String(str);
        return div.innerHTML;
      }

      var lastCheckEl = document.getElementById("last-check");
      var overallBanner = document.getElementById("overall-banner");
      var overallText = document.getElementById("overall-text");
      var overallSub = document.getElementById("overall-sub");
      var overallSpinner = document.getElementById("overall-spinner");
      var depTable = document.getElementById("dep-table");
      if (!overallBanner || !overallText || !overallSub || overallBanner.dataset.pollBound) return;
      overallBanner.dataset.pollBound = 'true';

      function setStatusBadge(card, status, label) {
        if (!card || !card.isConnected) return;
        var badge = card.querySelector(".service-status");
        badge.textContent = label || status;
        badge.className = "service-status text-xs " + (
          status === "ok" ? "bg-green-500/10 text-green-600 border-green-500/20" :
          status === "degraded" ? "bg-yellow-500/10 text-yellow-600 border-yellow-500/20" :
          status === "down" ? "bg-red-500/10 text-red-600 border-red-500/20" :
          "bg-muted text-muted-foreground"
        );
      }

      function setLatency(card, ms) {
        if (!card || !card.isConnected) return;
        card.querySelector(".service-latency").textContent = ms != null ? ms + "ms" : "—";
      }

      function setVersion(card, ver) {
        var el = card.querySelector(".service-version");
        if (ver) el.textContent = ver;
      }

      function setDeps(card, deps) {
        var el = card.querySelector(".service-deps");
        if (deps) el.textContent = deps;
      }

      async function checkApi() {
        var card = document.querySelector('[data-service="api"]');
        var start = performance.now();
        try {
          var resp = await fetch(apiBase + "/v1/health", { signal: AbortSignal.timeout(8000) });
          var elapsed = Math.round(performance.now() - start);
          if (resp.ok) {
            var body = await resp.json();
            var data = body.data || body;
            setStatusBadge(card, "ok", S.operational);
            setLatency(card, elapsed);
            setVersion(card, data.version || "—");
            var deps = data.dependencies || [];
            var okCount = deps.filter(function (d) { return d.status === "ok"; }).length;
            setDeps(card, okCount + "/" + deps.length + S.healthy);

            // Populate dependency table
            if (depTable && deps.length > 0) {
              depTable.innerHTML = deps.map(function (d) {
                var color = d.status === "ok" ? "green" : d.status === "degraded" ? "yellow" : "red";
                return '<div class="flex items-center gap-3 p-2.5 rounded-lg bg-muted/30">' +
                  '<span class="h-2 w-2 rounded-full bg-' + color + '-500 shrink-0"></span>' +
                  '<span class="flex-1 text-sm font-medium">' + escapeHtml(d.name) + '</span>' +
                  '<span class="text-xs font-mono text-muted-foreground">' + (d.latencyMs || 0) + 'ms</span>' +
                  (d.error ? '<span class="text-xs text-red-500">' + escapeHtml(d.error) + '</span>' : "") +
                  '</div>';
              }).join("");
            }
            return "ok";
          } else {
            setStatusBadge(card, "down", S.error + " " + resp.status);
            setLatency(card, Math.round(performance.now() - start));
            return "down";
          }
        } catch (e) {
          setStatusBadge(card, "down", S.unreachable);
          setLatency(card, null);
          return "down";
        }
      }

      async function checkEdge() {
        var card = document.querySelector('[data-service="edge"]');
        var start = performance.now();
        try {
          var resp = await fetch(edgeBase + "/v1/health", { signal: AbortSignal.timeout(8000) });
          var elapsed = Math.round(performance.now() - start);
          if (resp.ok) {
            var body = await resp.json();
            var data = body.data || body;
            setStatusBadge(card, "ok", S.operational);
            setLatency(card, elapsed);
            setVersion(card, data.homelab_model || "llama-3.3-70b");
            var budget = data.neuron_budget || {};
            setDeps(card, budget.used + "/" + budget.limit + S.neurons);
            return "ok";
          } else {
            setStatusBadge(card, "down", S.error + " " + resp.status);
            setLatency(card, elapsed);
            return "down";
          }
        } catch (e) {
          setStatusBadge(card, "down", S.unreachable);
          setLatency(card, null);
          return "down";
        }
      }

      async function checkMcp() {
        var card = document.querySelector('[data-service="mcp"]');
        var start = performance.now();
        try {
          await fetch(mcpBase + "/sse", {
            method: "GET",
            signal: AbortSignal.timeout(5000),
            mode: "no-cors"
          });
          var elapsed = Math.round(performance.now() - start);
          setStatusBadge(card, "ok", S.reachable);
          setLatency(card, elapsed);
          return "ok";
        } catch (e) {
          setStatusBadge(card, "down", S.unreachable);
          setLatency(card, null);
          return "down";
        }
      }

      async function checkPortal() {
        var card = document.querySelector('[data-service="portal"]');
        var start = performance.now();
        try {
          var resp = await fetch(portalBase + "/", { signal: AbortSignal.timeout(8000) });
          var elapsed = Math.round(performance.now() - start);
          if (resp.ok) {
            setStatusBadge(card, "ok", S.operational);
            setLatency(card, elapsed);
            return "ok";
          } else {
            setStatusBadge(card, "down", S.error + " " + resp.status);
            setLatency(card, elapsed);
            return "down";
          }
        } catch (e) {
          setStatusBadge(card, "down", S.unreachable);
          setLatency(card, null);
          return "down";
        }
      }

      async function runChecks() {
        if (!overallBanner.isConnected) return;
        if (overallSpinner) overallSpinner.style.display = "block";
        overallText.textContent = S.checking;
        overallSub.textContent = S.fetching;

        var results = await Promise.all([checkApi(), checkEdge(), checkMcp(), checkPortal()]);
        if (!overallBanner.isConnected) return;

        var okCount = results.filter(function (r) { return r === "ok"; }).length;
        var totalCount = results.length;

        if (overallSpinner) overallSpinner.style.display = "none";

        if (okCount === totalCount) {
          overallBanner.className = "rounded-xl border p-6 transition-colors border-green-500/30 bg-green-500/5";
          overallText.textContent = S.allOps;
          overallSub.textContent = okCount + "/" + totalCount + S.online;
        } else if (okCount > 0) {
          overallBanner.className = "rounded-xl border p-6 transition-colors border-yellow-500/30 bg-yellow-500/5";
          overallText.textContent = S.partial;
          overallSub.textContent = okCount + "/" + totalCount + S.partialSub;
        } else {
          overallBanner.className = "rounded-xl border p-6 transition-colors border-red-500/30 bg-red-500/5";
          overallText.textContent = S.allDown;
          overallSub.textContent = "0/" + totalCount + S.online;
        }

        if (lastCheckEl) {
          lastCheckEl.textContent = S.updated + new Date().toLocaleTimeString(S.timeLocale);
        }
      }

      // Initial check
      var statusInterval = null;

      function startStatusPolling() {
        if (!overallBanner.isConnected) return;
        runChecks();
        if (statusInterval) clearInterval(statusInterval);
        statusInterval = setInterval(runChecks, 30000);
      }

      function stopStatusPolling() {
        if (statusInterval) {
          clearInterval(statusInterval);
          statusInterval = null;
        }
      }

      // Handle Astro view transitions — clear and restart interval on navigation.
      document.addEventListener("astro:before-swap", function () {
        stopStatusPolling();
        document.removeEventListener("astro:page-load", startStatusPolling);
      }, { once: true });
      document.addEventListener("astro:page-load", startStatusPolling);
    })();
  </script>
  <script>
    import { bootStatusData } from "@/lib/status-data-client";
    bootStatusData();
  </script>
</BaseLayout>
