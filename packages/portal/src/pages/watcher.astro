---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import WatcherDashboard from "@/components/dashboard/WatcherDashboard";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('watcher.title')} description={t(
  "Real-time monitoring of data source changes across MapleSpike",
  "Surveillance en temps réel des changements de sources de données dans MapleSpike",
)} lang={lang}>
  <section class="aurora relative overflow-hidden border-b"><div class="absolute inset-0 bg-grid" aria-hidden="true"></div><div class="relative z-10 container mx-auto px-4 py-8 md:py-12">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{i18n.t('watcher.title')}</h1>
        <p class="mt-1 text-muted-foreground">
          {t(
            "Real-time monitoring of data source changes across all MapleSpike modules.",
            "Surveillance en temps réel des changements de sources de données dans tous les modules MapleSpike.",
          )}
        </p>
      </div>
      <div class="flex gap-2">
        <Badge variant="outline" className="text-green-500 border-green-500">{i18n.t('watcher.status.active')}</Badge>
      </div>
    </div>

    <WatcherDashboard client:load lang={lang} />

    <Card>
      <CardHeader>
        <CardTitle>{i18n.t('workspace.integration')}</CardTitle>
        <CardDescription>
          {t(
            "Use the API endpoints to query change events and manage webhooks programmatically.",
            "Utilisez les points de terminaison API pour interroger les événements de changement et gérer les webhooks par programmation.",
          )}
        </CardDescription>
      </CardHeader>
      <CardContent>
        <pre class="bg-muted p-4 rounded-lg text-sm overflow-x-auto"><code>GET  /v1/watcher/status
GET  /v1/watcher/events?sourceId=lobbying&limit=10
GET  /v1/webhooks
POST /v1/webhooks         &lbrace;"url":"https://...","label":"my webhook"&rbrace;
POST /v1/webhooks/:id/test
GET  /v1/webhooks/:id/deliveries</code></pre>
        <p class="text-xs text-muted-foreground mt-2">
          {t(
            "Change events are stored in the SqliteWatcherStore. Webhook notifications are dispatched automatically when changes are detected.",
            "Les événements de changement sont stockés dans SqliteWatcherStore. Les notifications de webhook sont envoyées automatiquement lorsqu'un changement est détecté.",
          )}
        </p>
      </CardContent>
    </Card>
    </div>
  </section>
</BaseLayout>
