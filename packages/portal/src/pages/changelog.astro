---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChangelogAccordion from "@/components/ChangelogAccordion";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout
  title={i18n.t('changelog.title')}
  description={t(
    `Complete changelog for MapleSpike — 267 commits, 5 releases, ${statsData.modules} ingestion modules, ${statsData.tools} MCP tools. Every change tracked from April 2026.`,
    `Journal des modifications complet de MapleSpike — 267 validations, 5 versions, ${statsData.modules} modules d'ingestion, ${statsData.tools} outils MCP. Chaque changement suivi depuis avril 2026.`,
  )}
  lang={lang}
>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          <span class="text-gradient">{i18n.t('changelog.title')}</span>
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          {t(
            "267 commits across 5 releases — 318K lines of TypeScript added, 68K removed. Built by 3 contributors over 36 days. Track every update, feature, and fix to the MapleSpike platform.",
            "267 validations réparties sur 5 versions — 318 K lignes de TypeScript ajoutées, 68 K supprimées. Construit par 3 contributeurs en 36 jours. Suivez chaque mise à jour, fonctionnalité et correctif de la plateforme MapleSpike.",
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- Accordion releases -->
  <section class="py-16 md:py-24">
    <ChangelogAccordion client:load />
  </section>

  <!-- CTA -->
  <section class="aurora relative overflow-hidden border-t py-16 md:py-20">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl mb-4">
        {t("Start building with MapleSpike today", "Commencez à construire avec MapleSpike dès aujourd'hui")}
      </h2>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        {t(
          `Free tier includes 1,000 API calls per month and full access to all ${statsData.tools} MCP tools. No credit card required.`,
          `Le palier gratuit inclut 1 000 appels API par mois et un accès complet aux ${statsData.tools} outils MCP. Aucune carte de crédit requise.`,
          
        )}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/signup" class="btn-sheen inline-flex h-12 items-center rounded-full px-8 text-base font-medium text-primary-foreground">{t("Get Started Free", "Commencer gratuitement")}</a>
        <a href="/docs" class="inline-flex h-12 items-center rounded-full border px-8 text-base font-medium hover:bg-foreground/[0.04] transition-colors">{t("Read the Docs", "Lire la documentation")}</a>
      </div>
    </div>
  </section>
</BaseLayout>
