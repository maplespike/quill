---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { localeUrl } from "@/utils/localeUrl";
import { createI18n } from "@maplespike/i18n";
import { pick, pickBi, type Bi } from "@/utils/bilingual";
import StripeCheckoutButton from "@/components/billing/StripeCheckoutButton";
import plansData from "@/data/plans.json";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);

// Single source of truth: src/data/plans.json (generated by scripts/generate-plans.mjs
// from /v1/billing/plans). NEVER hardcode price/limits here — regenerate instead.
const planById = new Map(plansData.plans.map((p) => [p.plan_id, p]));
const freePlan = planById.get("free")!;
const proPlan = planById.get("pro")!;
const bizPlan = planById.get("business")!;
const fmtMoney = (cents: number) => `$${Math.round(cents / 100)}`;
const fmtInt = (n: number | null | undefined, fr: boolean) =>
  n == null ? (fr ? "Illimité" : "Unlimited") : n.toLocaleString(fr ? "fr-CA" : "en-CA");
const callsFeature = (plan: { credits_per_month: number | null }): Bi => ({
  en: `${fmtInt(plan.credits_per_month, false)} API calls per month`,
  fr: `${fmtInt(plan.credits_per_month, true)} appels API par mois`,
});
const buyCta = (planName: string, plan: { price_cents: number }): Bi => ({
  en: `Buy ${planName} — ${fmtMoney(plan.price_cents)} CAD/mo`,
  fr: `Acheter ${planName} — ${fmtInt(plan.price_cents / 100, true)} $ CA/mois`,
});
const modulesToolsBi = (): Bi => ({
  en: `All ${statsData.modules} data modules + ${statsData.tools} MCP tools`,
  fr: `Les ${statsData.modules} modules de données + ${statsData.tools} outils MCP`,
});

const tiers: {
  name: Bi;
  price: string;
  period: string;
  description: Bi;
  badge: Bi;
  badgeVariant: "outline" | "default" | "secondary";
  features: Bi[];
  cta: Bi;
  href: string;
  highlighted: boolean;
  kind: "signup" | "stripe-pro" | "stripe-business";
}[] = [
  {
    name: { en: "Free", fr: "Gratuit" },
    price: fmtMoney(freePlan.price_cents),
    period: "/mo",
    description: {
      en: "For individual researchers and AI enthusiasts exploring Canadian government data with their chatbot.",
      fr: "Pour les chercheurs individuels et les passionnés d'IA qui explorent les données gouvernementales canadiennes avec leur chatbot.",
    },
    badge: { en: "Starter", fr: "Départ" },
    badgeVariant: "outline",
    features: [
      callsFeature(freePlan),
      modulesToolsBi(),
      { en: "Works with any AI chatbot (Claude, ChatGPT, Gemini, etc.)", fr: "Fonctionne avec tout chatbot IA (Claude, ChatGPT, Gemini, etc.)" },
      { en: "7-day historical data window", fr: "Fenêtre de données historiques de 7 jours" },
      { en: "REST API access (rate-limited)", fr: "Accès à l'API REST (limité)" },
      { en: "Community Discord support", fr: "Support communautaire Discord" },
    ],
    cta: { en: "Get Started", fr: "Commencer" },
    href: "/signup",
    highlighted: false,
    /** "free" → no payment, just sign up */
    kind: "signup" as const,
  },
  {
    name: { en: "Pro", fr: "Pro" },
    price: fmtMoney(proPlan.price_cents),
    period: "/mo",
    description: {
      en: "For journalists, analysts, and teams who need real-time government intelligence.",
      fr: "Pour les journalistes, analystes et équipes qui ont besoin d'une veille gouvernementale en temps réel.",
    },
    badge: { en: "Popular", fr: "Populaire" },
    badgeVariant: "default",
    features: [
      callsFeature(proPlan),
      { en: "Real-time signal detection via engine", fr: "Détection de signaux en temps réel via le moteur" },
      { en: "Full historical data access (all years)", fr: "Accès complet aux données historiques (toutes années)" },
      { en: "MCP server integration for AI agents", fr: "Intégration du serveur MCP pour les agents IA" },
      { en: "Priority support with 4hr response SLA", fr: "Support prioritaire avec SLA de réponse de 4 h" },
      { en: "SDK access (TypeScript + Python)", fr: "Accès aux SDK (TypeScript + Python)" },
      { en: "SHA-256 record-integrity verification where hashes are supplied", fr: "Vérification d'intégrité SHA-256 lorsqu'un hachage est fourni" },
    ],
    cta: buyCta("Pro", proPlan),
    href: "/signup?plan=pro",
    highlighted: true,
    kind: "stripe-pro" as const,
  },
  {
    name: { en: "Business", fr: "Entreprise" },
    price: fmtMoney(bizPlan.price_cents),
    period: "/mo",
    description: {
      en: "For government departments, media organizations, and large-scale compliance teams.",
      fr: "Pour les ministères, les organisations médiatiques et les grandes équipes de conformité.",
    },
    badge: { en: "Enterprise", fr: "Entreprise" },
    badgeVariant: "secondary",
    features: [
      callsFeature(bizPlan),
      { en: "Dedicated ingestion pipeline configuration", fr: "Configuration dédiée du pipeline d'ingestion" },
      { en: "On-premise K3s deployment option", fr: "Option de déploiement K3s sur site" },
      { en: "Custom data module development", fr: "Développement de modules de données personnalisés" },
      { en: "99.95% uptime SLA with dedicated support", fr: "SLA de disponibilité de 99,95 % avec support dédié" },
      { en: "SSO/SAML authentication", fr: "Authentification SSO/SAML" },
      { en: "White-label portal option", fr: "Option de portail à marque blanche" },
      { en: "Quarterly strategy reviews", fr: "Revues stratégiques trimestrielles" },
    ],
    cta: buyCta("Business", bizPlan),
    href: "/contact",
    highlighted: false,
    kind: "stripe-business" as const,
  },
];

const allFeatures: Bi[] = [
  { en: "Data modules", fr: "Modules de données" },
  { en: "API calls", fr: "Appels API" },
  { en: "MCP for AI chatbots", fr: "MCP pour chatbots IA" },
  { en: "Historical access", fr: "Accès historique" },
  { en: "Real-time signals", fr: "Signaux en temps réel" },
  { en: "SDK access", fr: "Accès SDK" },
  { en: "Support", fr: "Support" },
  { en: "SLA", fr: "SLA" },
  { en: "Record-integrity metadata", fr: "Métadonnées d'intégrité des enregistrements" },
];
const featureValues: Record<string, Bi[]> = {
  "Data modules": [{ en: `${statsData.modules} modules`, fr: `${statsData.modules} modules` }, { en: `${statsData.modules} modules`, fr: `${statsData.modules} modules` }, { en: `${statsData.modules} + custom`, fr: `${statsData.modules} + sur mesure` }],
  "API calls": [
    { en: `${fmtInt(freePlan.credits_per_month, false)}/mo`, fr: `${fmtInt(freePlan.credits_per_month, true)}/mois` },
    { en: `${fmtInt(proPlan.credits_per_month, false)}/mo`, fr: `${fmtInt(proPlan.credits_per_month, true)}/mois` },
    { en: `${fmtInt(bizPlan.credits_per_month, false)}/mo`, fr: `${fmtInt(bizPlan.credits_per_month, true)}/mois` },
  ],
  "MCP for AI chatbots": [{ en: "Yes", fr: "Oui" }, { en: "Yes", fr: "Oui" }, { en: "Yes", fr: "Oui" }],
  "Historical access": [{ en: "7 days", fr: "7 jours" }, { en: "Full", fr: "Complet" }, { en: "Full", fr: "Complet" }],
  "Real-time signals": [{ en: "No", fr: "Non" }, { en: "Yes", fr: "Oui" }, { en: "Yes", fr: "Oui" }],
  "SDK access": [{ en: "No", fr: "Non" }, { en: "TS + Python", fr: "TS + Python" }, { en: "TS + Python", fr: "TS + Python" }],
  "Support": [{ en: "Community", fr: "Communauté" }, { en: "Priority 4hr", fr: "Prioritaire 4 h" }, { en: "Dedicated", fr: "Dédié" }],
  "SLA": [{ en: "No", fr: "Non" }, { en: "99.9%", fr: "99,9 %" }, { en: "99.95%", fr: "99,95 %" }],
  "Record-integrity metadata": [{ en: "Where supplied", fr: "Si fourni" }, { en: "Where supplied", fr: "Si fourni" }, { en: "Where supplied", fr: "Si fourni" }],
};
---

<BaseLayout title={i18n.t('pricing.page_title')} description={t(
  "Simple, transparent pricing for every scale — from free to enterprise access to Canada's unified data layer.",
  "Une tarification simple et transparente pour tous les besoins — du gratuit à l'accès entreprise à la couche de données unifiée du Canada.",
)} ogImage="/og-image-pricing.png" lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center reveal-on-scroll">
      <Badge variant="outline" className="mb-4 border-primary/30 bg-primary/5 text-primary"
        >{t("Simple, transparent pricing", "Tarification simple et transparente")}</Badge
      >
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {t("Pricing for every", "Tarification pour tous les")}&nbsp;<span class="text-gradient">{t("scale", "besoins")}</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        {t(
          "From solo researchers to enterprise government intelligence teams — access Canada's unified data layer at a plan that fits.",
          "Des chercheurs indépendants aux équipes gouvernementales de veille — accédez à la couche de données unifiée du Canada avec un forfait adapté.",
        )}
      </p>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="py-16 md:py-20">
    <div class="container mx-auto px-4 reveal-on-scroll">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-3 stagger-children">
        {tiers.map((tier) => (
          <Card
            className={cn(
              "card-hover relative flex flex-col",
              tier.highlighted &&
                "border-primary/50 ring-1 ring-primary/20 shadow-lg shadow-primary/5"
            )}
          >
            {tier.highlighted && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <Badge className="btn-sheen px-4 py-1 text-xs">
                  {t("Most Popular", "Le plus populaire")}
                </Badge>
              </div>
            )}
            <CardHeader>
              <div class="flex items-center justify-between">
                <CardTitle className="text-xl">{tb(tier.name)}</CardTitle>
                <Badge variant={tier.badgeVariant}>{tb(tier.badge)}</Badge>
              </div>
              <div class="mt-2">
                <span class="text-4xl font-bold">{tier.price}</span>
                {tier.period && (
                  <span class="text-sm text-muted-foreground">{tier.period}</span>
                )}
              </div>
              <CardDescription className="mt-2">{tb(tier.description)}</CardDescription>
            </CardHeader>
            <CardContent className="flex-1">
              <ul class="space-y-3">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 shrink-0 text-primary"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{tb(feature)}</span>
                  </li>
                ))}
              </ul>
            </CardContent>
            <CardFooter>
              {tier.kind === "stripe-pro" && (
                <div class="w-full space-y-2">
                  <StripeCheckoutButton
                    planId="pro"
                    lang={lang}
                    client:load
                    className="w-full"
                  />
                  <a
                    href={`${localeUrl('/checkout', lang)}?plan=pro`}
                    class="block text-center text-xs underline opacity-70 hover:opacity-100"
                  >
                    {t("or pay on this page", "ou payez sur cette page")}
                  </a>
                </div>
              )}
              {tier.kind === "stripe-business" && (
                <div class="w-full space-y-2">
                  <StripeCheckoutButton
                    planId="business"
                    lang={lang}
                    client:load
                    className="w-full"
                  />
                  <a
                    href={`${localeUrl('/checkout', lang)}?plan=business`}
                    class="block text-center text-xs underline opacity-70 hover:opacity-100"
                  >
                    {t("or pay on this page", "ou payez sur cette page")}
                  </a>
                </div>
              )}
              {tier.kind === "signup" && (
                <a href={tier.href} class="press-feedback inline-flex w-full transition-transform duration-[160ms] ease-out">
                  <Button
                    variant={tier.highlighted ? "default" : "outline"}
                    className={cn("w-full", tier.highlighted && "btn-sheen")}
                  >
                    {tb(tier.cta)}
                  </Button>
                </a>
              )}
            </CardFooter>
          </Card>
        ))}
      </div>
      <p class="mt-8 text-center text-xs text-muted-foreground">
        {t(
          "Sign in with a passkey, GitHub, or a wallet. Passkeys stay on the device that creates them — ",
          "Connectez-vous avec une clé d'accès, GitHub ou un portefeuille. Les clés d'accès restent sur l'appareil qui les crée — "
        )}
        <a href="/docs/guide/identity-model.html" class="text-primary underline underline-offset-2 hover:no-underline">
          {t("learn how account identity works", "découvrez le fonctionnement de l'identité de compte")}
        </a>.
      </p>
    </div>
  </section>

  <!-- Feature Comparison Table -->
  <section class="border-t py-16 md:py-20">
    <div class="container mx-auto px-4 reveal-on-scroll">
      <h2 class="mb-12 text-center text-3xl font-bold">{t("Full feature comparison", "Comparaison complète des forfaits")}</h2>
      <div class="mx-auto max-w-4xl overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b">
              <th class="py-4 pr-8 text-left font-medium text-muted-foreground">{t("Feature", "Fonctionnalité")}</th>
              {tiers.map((tier) => (
                <th class="py-4 px-6 text-center font-medium">
                  {tb(tier.name)}
                  {tier.name.en === "Pro" && (
                    <Badge variant="default" className="ml-2 text-xs">{t("Popular", "Populaire")}</Badge>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {allFeatures.map((feature) => (
              <tr class="border-b last:border-0">
                <td class="py-4 pr-8 text-left font-medium">{tb(feature)}</td>
                {featureValues[feature.en].map((value) => (
                  <td class="py-4 px-6 text-center">
                    {value.en === "Yes" || value.en === "No" ? (
                      value.en === "Yes" ? (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="mx-auto text-primary"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      ) : (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="mx-auto text-muted-foreground/40"
                        >
                          <line x1="18" x2="6" y1="6" y2="18" />
                          <line x1="6" x2="18" y1="6" y2="18" />
                        </svg>
                      )
                    ) : (
                      <span class="text-sm">{tb(value)}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-12 text-center">
        <p class="mb-4 text-sm text-muted-foreground">
          {t(
            "All plans include access to source provenance and record-integrity features where the endpoint supplies them. Publisher terms information is shown when present in source metadata; check original terms before reuse.",
            "Tous les forfaits donnent accès aux fonctionnalités de provenance et d'intégrité des enregistrements lorsque le point de terminaison les fournit. Les informations sur les conditions de l'éditeur sont affichées lorsqu'elles figurent dans les métadonnées sources; consultez les conditions originales avant toute réutilisation.",
          )}
        </p>
        <p class="text-sm text-muted-foreground">
          {t("Need something different?", "Besoin d'autre chose?")}{" "}
          <a href="/contact" class="text-primary hover:underline">{t("Contact our team", "Contactez notre équipe")}</a>
          {" "}{t("for custom pricing.", "pour une tarification personnalisée.")}
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t py-16 md:py-20">
    <div class="container mx-auto px-4 reveal-on-scroll">
      <h2 class="mb-12 text-center text-3xl font-bold">{t("Frequently asked questions", "Questions fréquentes")}</h2>
      <div class="mx-auto grid max-w-3xl gap-8 md:grid-cols-2">
        <div>
          <h3 class="mb-2 font-semibold">{t("Can I switch plans anytime?", "Puis-je changer de forfait en tout temps?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "Yes. Upgrade or downgrade at any time. Changes take effect on your next billing cycle.",
              "Oui. Passez à un forfait supérieur ou inférieur en tout temps. Les changements prennent effet à votre prochain cycle de facturation.",
            )}
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold">{t("Is there a free trial for Pro?", "Y a-t-il un essai gratuit pour Pro?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "Absolutely. 14-day free trial with full Pro access. No credit card required.",
              "Absolument. Essai gratuit de 14 jours avec accès Pro complet. Sans carte de crédit.",
            )}
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold">{t("What data modules are included?", "Quels modules de données sont inclus?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "The Free tier includes discovery and metadata access (catalog, citations, compliance) across all sources. Pro and Business unlock full data queries and AI analysis on every module.",
              "Le forfait Gratuit comprend l'accès à la découverte et aux métadonnées (catalogue, citations, conformité) sur toutes les sources. Pro et Entreprise débloquent les requêtes de données complètes et l'analyse IA sur chaque module.",
            )}
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold">{t("Do you offer academic pricing?", "Offrez-vous un tarif académique?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "Yes. Contact us with your institution details for a 50% academic discount on Pro.",
              "Oui. Contactez-nous avec les détails de votre établissement pour un rabais académique de 50 % sur Pro.",
            )}
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold">{t("How does SHA-256 citation work?", "Comment fonctionne la citation SHA-256?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "Where provided, a content hash and source URL can support an integrity check. Their presence does not establish source authenticity or reuse rights.",
              "Lorsqu'ils sont fournis, un hachage de contenu et une URL source peuvent permettre un contrôle d'intégrité. Leur présence n'établit ni l'authenticité de la source ni les droits de réutilisation.",
            )}
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold">{t("What payment methods do you accept?", "Quels modes de paiement acceptez-vous?")}</h3>
          <p class="text-sm text-muted-foreground">
            {t(
              "All paid plans are processed securely by Stripe (credit card). Prices are in CAD.",
              "Tous les forfaits payants sont traités en toute sécurité par Stripe (carte de crédit). Les prix sont en dollars canadiens.",
            )}{" "}
            <a href="/terms" class="text-primary hover:underline">{t("Terms", "Conditions")}</a>{" "}
            {t(
              "for the full refund and cancellation policy.",
              "pour la politique complète de remboursement et d'annulation.",
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <footer class="border-t py-8">
    <div class="container mx-auto px-4 text-center text-sm text-muted-foreground space-x-4">
      <a href="/privacy" class="text-primary hover:underline">{t("Privacy Policy", "Politique de confidentialité")}</a>
      <a href="/terms" class="text-primary hover:underline">{t("Terms of Service", "Conditions d'utilisation")}</a>
      <a href="/terms#refunds" class="text-primary hover:underline">{t("Refund Policy", "Politique de remboursement")}</a>
    </div>
  </footer>
</BaseLayout>
