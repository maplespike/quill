---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import BrowserExtraction from "@/components/dashboard/BrowserExtraction";
import { createI18n } from "@maplespike/i18n";
import { localeUrl } from "@/utils/localeUrl";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('extraction.title')} description={t(
  "Extract data from government portals that have no API — your browser renders the page and we cache the results for all users.",
  "Extrayez des données de portails gouvernementaux sans API — votre navigateur rend la page et nous mettons les résultats en cache pour tous les utilisateurs.",
)} lang={lang}>
  <section class="container mx-auto px-4 py-16 md:py-20">
    <div class="mb-8">
      <a href={localeUrl('/dashboard', lang)} class="text-sm text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        {i18n.t('common.back')}
      </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="text-gradient">{i18n.t('extraction.title')}</span>
        </h1>
        <p class="mt-2 text-muted-foreground max-w-2xl">
          {t(
            "Extract data from government portals that have no API — your browser renders the page and we cache the results for all users.",
            "Extrayez des données de portails gouvernementaux sans API — votre navigateur rend la page et nous mettons les résultats en cache pour tous les utilisateurs.",
          )}
        </p>
      </div>
    </div>

    <!-- Dashboard Tabs -->
    <div class="mb-8 flex gap-1 rounded-lg border bg-card/50 p-1">
      <a
        href={localeUrl('/dashboard', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors",
          "text-muted-foreground hover:text-foreground hover:bg-accent",
        ]}
      >
        {i18n.t('dashboard.tab.overview')}
      </a>
      <a
        href={localeUrl('/dashboard/extraction', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors",
          "bg-primary text-primary-foreground",
        ]}
      >
        {i18n.t('dashboard.tab.extraction')}
      </a>
      <a
        href={localeUrl('/dashboard/owasp', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors",
          "text-muted-foreground hover:text-foreground hover:bg-accent",
        ]}
      >
        {i18n.t('dashboard.tab.owasp')}
      </a>
    </div>

    <Card>
      <CardHeader>
        <CardTitle>{i18n.t('extraction.title')}</CardTitle>
        <CardDescription>
          {t(
            "Your browser renders government pages locally and extracts data file links. Results are cached server-side for 7 days for all subsequent users.",
            "Votre navigateur rend localement les pages gouvernementales et extrait les liens de fichiers de données. Les résultats sont mis en cache côté serveur pendant 7 jours pour tous les utilisateurs suivants.",
          )}
        </CardDescription>
      </CardHeader>
      <CardContent>
        <BrowserExtraction client:load lang={lang} />
      </CardContent>
    </Card>
  </section>
</BaseLayout>
