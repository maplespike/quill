---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout
  title={i18n.t('claims.title')}
  description={t(
    "A live index of claim bundles registered by Quill. A record hash checks canonical record integrity; inspect the provenance evidence and verify source material with the publisher.",
    "Un index en direct des lots de revendications enregistrés par Quill. Un hachage vérifie l'intégrité de l'enregistrement canonique; examinez les preuves de provenance et vérifiez le contenu source auprès de l'éditeur.",
  )}
  lang={lang}
>
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/60 bg-card/40 px-3 py-1 text-xs font-medium text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--moss)]"></span>
          {t("Public discovery — no API key required", "Découverte publique — aucune clé API requise")}
        </div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          <span class="text-gradient">{i18n.t('claims.title')}</span>
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          {t(
            "Explore claim hashes and their evidence records. A matching record hash checks canonical record integrity only; it does not prove source identity, completeness, or reuse rights.",
            "Consultez les hachages des revendications et leurs dossiers de preuve. Un hachage d'enregistrement correspondant vérifie uniquement l'intégrité canonique; il ne prouve ni l'identité de la source, ni l'exhaustivité, ni les droits de réutilisation.",
          )}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <div id="claims-status" class="mb-6 flex items-center gap-2 text-sm text-muted-foreground">
        <span class="h-2 w-2 animate-pulse rounded-full bg-[var(--maple)]"></span>
        <span id="claims-loading">{i18n.t('claims.loading')}</span>
      </div>

      <div id="claims-error" class="hidden rounded-xl border border-red-500/30 bg-red-500/5 p-4 text-sm text-red-500"></div>

      <div id="claims-empty" class="hidden rounded-xl border border-border/60 bg-card/40 p-8 text-center">
        <div class="text-2xl mb-2">🗂️</div>
        <p class="text-sm text-muted-foreground">{i18n.t('claims.empty')}</p>
      </div>

      <div id="claims-list" class="hidden space-y-3"></div>

      <Card className="mt-12">
        <CardHeader>
          <CardTitle className="text-base">📚 {i18n.t('claims.how.title')}</CardTitle>
          <CardDescription>
            {t(
              "The verifier includes provenance_evidence: the record-hash scope, HTTP response artifacts captured by the shared ingestion client, declared transformation steps, and publisher-terms metadata when observed. Null, empty, or not-recorded states mean evidence was not captured; they are not rights conclusions. See the source publisher for its terms.",
              "Le vérificateur inclut provenance_evidence : la portée du hachage, les réponses HTTP capturées par le client d'ingestion partagé, les étapes de transformation déclarées et les métadonnées des conditions de l'éditeur lorsqu'elles sont observées. Les états nuls, vides ou non consignés signifient que la preuve n'a pas été capturée; ils ne constituent pas une conclusion sur les droits. Consultez les conditions de l'éditeur source.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="overflow-x-auto rounded-md bg-muted p-3">
            <code class="text-xs text-muted-foreground block">
              curl -s https://api.maplespike.ca/v1/claims/verify/&lt;sha256&gt;
            </code>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <script is:inline>
    (function () {
      "use strict";

      var cfg = window.MAPLESPIKE || {};
      var apiBase = (cfg.apiBase || "https://api.maplespike.ca") + "/v1";
      var statusEl = document.getElementById("claims-status");
      var loadingEl = document.getElementById("claims-loading");
      var errorEl = document.getElementById("claims-error");
      var emptyEl = document.getElementById("claims-empty");
      var listEl = document.getElementById("claims-list");

      function i18n(key) {
        var dict = {
          en: {
            "claims.empty": "No claims registered yet. Run an ingestion or call an MCP tool that registers claim bundles, then check back.",
            "claims.error": "Could not load the claim index. Try again shortly, or use the API directly: GET /v1/claims/latest",
            "claims.source": "Source",
            "claims.retrieved": "Source retrieval time",
            "claims.verify": "Inspect evidence",
            "claims.loading": "Loading…",
            "claims.live": "indexed from",
            "claims.bundle": "claim bundle",
            "claims.bundles": "claim bundles",
          },
          fr: {
            "claims.empty": "Aucune revendication enregistrée pour le moment. Lancez une ingestion ou appelez un outil MCP qui enregistre des lots, puis revenez plus tard.",
            "claims.error": "Impossible de charger l'index. Réessayez bientôt ou utilisez directement GET /v1/claims/latest",
            "claims.source": "Source",
            "claims.retrieved": "Heure de récupération de la source",
            "claims.verify": "Examiner les preuves",
            "claims.loading": "Chargement…",
            "claims.live": "indexé à partir de",
            "claims.bundle": "lot de revendication",
            "claims.bundles": "lots de revendications",
          },
        };
        var lang = (window.__LANG === "fr") ? "fr" : "en";
        return dict[lang][key] || key;
      }

      function sanitizeUrl(value) {
        try {
          var parsed = new URL(value, window.location.origin);
          if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return "#";
          return parsed.href;
        } catch (e) {
          return "#";
        }
      }

      function arrow() {
        var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("width", "10");
        svg.setAttribute("height", "10");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("fill", "none");
        svg.setAttribute("stroke", "currentColor");
        svg.setAttribute("stroke-width", "2");
        svg.setAttribute("stroke-linecap", "round");
        svg.setAttribute("stroke-linejoin", "round");
        var p1 = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p1.setAttribute("d", "M7 17 17 7");
        var p2 = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p2.setAttribute("d", "M7 7h10v10");
        svg.appendChild(p1);
        svg.appendChild(p2);
        return svg;
      }

      function renderRow(claim) {
        var hash = String(claim.sha256 || "");
        var verifyUrl = "/verify?hash=" + encodeURIComponent(hash);
        var host = "";
        if (claim.source_url) {
          try { host = new URL(sanitizeUrl(claim.source_url)).hostname; } catch (e) { host = ""; }
        }

        var card = document.createElement("article");
        card.className = "rounded-xl border border-border/60 bg-card/40 p-4";
        var title = document.createElement("p");
        title.className = "text-sm font-medium leading-snug text-foreground";
        title.textContent = claim.claim || "(no claim statement)";
        card.appendChild(title);

        var metadata = document.createElement("div");
        metadata.className = "mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground";
        var source = document.createElement("span");
        source.textContent = i18n("claims.source") + ": " + (claim.source_name || "—") + (host ? " · " + host : "");
        var timestamp = document.createElement("span");
        timestamp.textContent = i18n("claims.retrieved") + ": " + (claim.retrieved_at ? new Date(claim.retrieved_at).toLocaleString("en-CA") : "Not recorded");
        metadata.appendChild(source);
        metadata.appendChild(timestamp);
        card.appendChild(metadata);

        var hashRow = document.createElement("div");
        hashRow.className = "mt-3 border-t border-border/40 pt-2.5 font-mono text-xs text-muted-foreground break-all";
        hashRow.textContent = hash;
        card.appendChild(hashRow);

        var action = document.createElement("a");
        action.href = verifyUrl;
        action.className = "mt-3 inline-flex items-center gap-1.5 rounded-lg border border-border/60 bg-card px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-[var(--maple)]/40 hover:text-foreground";
        action.textContent = i18n("claims.verify");
        action.appendChild(arrow());
        card.appendChild(action);
        return card;
      }

      function showError(message) {
        loadingEl.textContent = "";
        statusEl.classList.add("hidden");
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }

      fetch(apiBase + "/claims/latest", { headers: { Accept: "application/json" } })
        .then(function (response) {
          if (!response.ok) throw new Error("HTTP " + response.status);
          return response.json();
        })
        .then(function (payload) {
          loadingEl.textContent = "";
          statusEl.classList.add("hidden");
          var claims = payload && payload.data && Array.isArray(payload.data.claims) ? payload.data.claims : [];
          if (claims.length === 0) {
            emptyEl.classList.remove("hidden");
            return;
          }
          listEl.classList.remove("hidden");
          claims.forEach(function (claim) { listEl.appendChild(renderRow(claim)); });
        })
        .catch(function () { showError(i18n("claims.error")); });
    })();
  </script>
</BaseLayout>
