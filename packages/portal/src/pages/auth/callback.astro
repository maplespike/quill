---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createI18n } from "@maplespike/i18n";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);

if (Astro.url.searchParams.has("error")) {
  const error = Astro.url.searchParams.get("error");
}
---

<BaseLayout title="Completing sign-in" description="Finalizing authentication..." lang={lang}>
  <section class="container mx-auto px-4 py-24 min-h-[60vh] flex items-center justify-center">
    <div class="text-center space-y-6 max-w-md">
      <div class="mx-auto h-12 w-12 rounded-full border-4 border-primary border-t-transparent animate-spin"></div>

      <h1 class="text-2xl font-bold tracking-tight">
        Completing sign-in
        <span class="text-gradient">…</span>
      </h1>

      <p class="text-muted-foreground" id="auth-status">
        Exchanging one-time code for an authenticated session.
      </p>

      <p id="auth-error" class="hidden text-sm text-destructive"></p>

      <div id="api-key-reveal" class="hidden text-left space-y-3 rounded-lg border border-primary/30 bg-primary/5 p-4" role="region" aria-label="Your API key">
        <p class="text-sm font-medium">Save your API key</p>
        <p class="text-sm text-muted-foreground">Copy this key now. It is also stored in this browser.</p>
        <code id="api-key-reveal-value" class="block break-all font-mono text-sm"></code>
        <button type="button" id="api-key-reveal-copy" class="text-xs text-muted-foreground hover:text-foreground">Copy</button>
        <pre id="api-key-reveal-curl" class="whitespace-pre-wrap break-all rounded-md border bg-muted/40 p-3 font-mono text-xs"></pre>
        <p class="text-xs text-muted-foreground">Manage or rotate this key on the <a href="/dashboard" class="underline">dashboard</a>.</p>
        <a id="api-key-reveal-continue" href="/workspace?new=1" class="inline-flex w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Continue</a>
      </div>

      <a
        href="/signup"
        id="auth-retry"
        class="hidden inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-4 py-2 border border-input bg-background hover:bg-accent transition-colors"
      >
        Try a different sign-in method
      </a>
    </div>
  </section>

  <script>
    (function () {
      "use strict";

      const statusEl = document.getElementById("auth-status");
      const errorEl = document.getElementById("auth-error");
      const retryEl = document.getElementById("auth-retry");

      function setError(msg: string) {
        if (statusEl) statusEl.textContent = "Authentication failed";
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.classList.remove("hidden");
        }
        if (retryEl) retryEl.classList.remove("hidden");
      }

      // Handle error param (callback failure before reaching exchange)
      const params = new URLSearchParams(window.location.search);
      const errorParam = params.get("error");
      if (errorParam) {
        const map: Record<string, string> = {
          invalid_state: "OAuth state mismatch — possible CSRF attack. Please retry.",
          login_failed: "OAuth login failed. Please try again.",
          access_denied: "You declined the OAuth provider's permissions.",
        };
        setError(map[errorParam] || `Authentication error: ${errorParam}`);
        return;
      }

      const code = params.get("code");
      if (!code) {
        setError("Missing authentication code.");
        return;
      }

      // Resolve API base (same logic as SignupForm)
      const cfg =
        typeof window !== "undefined" ? window.MAPLESPIKE || {} : {};
      let apiBase = cfg.apiBase;
      if (!apiBase && typeof window !== "undefined") {
        const host = window.location.hostname;
        const parts = host.split(".");
        const base =
          parts.length > 2 && ["api", "portal", "www", "mcp", "dev", "data", "quill"].includes(parts[0])
            ? parts.slice(1).join(".")
            : host;
        apiBase = `${window.location.protocol}//api.${base}`;
      }
      if (!apiBase) apiBase = "https://api.maplespike.ca";

      fetch(`${apiBase}/v1/auth/oauth/exchange?code=${encodeURIComponent(code)}`)
        .then(async (res) => {
          const data = await res.json();
          if (!data.success) {
            throw new Error(data.error?.message || "Exchange failed");
          }
          return data.data;
        })
        .then((payload) => {
          // Store JWT as maplespike_token
          const token = payload?.token;
          if (!token) {
            setError("No token in response.");
            return;
          }

          const provider = payload?.provider || "oauth";
          const userId = payload?.name || provider;

          // Use the existing global auth manager
          if (window.QuillAuth?.setAuth) {
            window.QuillAuth.setAuth(token, userId, provider);
          } else {
            // Fallback: write directly to localStorage
            localStorage.setItem("maplespike_token", token);
            localStorage.setItem("maplespike_userId", userId);
            localStorage.setItem("maplespike_method", provider);
          }

          // Also store API key if provided
          if (payload?.apiKey?.key) {
            localStorage.setItem("quill-api-key", payload.apiKey.key);
          }

          // A new account must see the full key before any redirect. The
          // continue link goes to the workspace welcome, which shows it again.
          if (payload?.isNewUser && payload?.apiKey?.key) {
            const reveal = document.getElementById("api-key-reveal");
            const value = document.getElementById("api-key-reveal-value");
            const curl = document.getElementById("api-key-reveal-curl");
            const spinner = document.querySelector(".animate-spin");
            if (value) value.textContent = payload.apiKey.key;
            if (curl) {
              curl.textContent = `curl -s -H "x-api-key: ${payload.apiKey.key}" ${apiBase}/v1/llms.txt`;
            }
            document.getElementById("api-key-reveal-copy")?.addEventListener("click", () => {
              void navigator.clipboard?.writeText(payload.apiKey.key);
            });
            if (spinner) spinner.classList.add("hidden");
            if (reveal) reveal.classList.remove("hidden");
            if (statusEl) statusEl.textContent = "Your API key is ready.";
            return;
          }

          if (!statusEl) return;
          statusEl.textContent = payload?.isNewUser
            ? "Welcome to MapleSpike — redirecting to your dashboard…"
            : "Signed in — redirecting to your dashboard…";

          setTimeout(() => {
            // For first-time OAuth users include ?new=1 so /workspace
            // can show a one-time welcome banner. The flag is cleared
            // from the URL right after the banner renders.
            const dest = payload?.isNewUser ? "/workspace?new=1" : "/dashboard";
            window.location.replace(dest);
          }, 600);
        })
        .catch((err) => {
          setError(err instanceof Error ? err.message : "Unknown error");
        });
    })();
  </script>
</BaseLayout>
