---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import AgentChat from "@/components/dashboard/AgentChat";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('ask.title')} description={t(
  "Ask natural language questions about Canadian government data. AI-powered answers with verified citations.",
  "Posez des questions en langage naturel sur les données gouvernementales canadiennes. Réponses propulsées par IA avec citations vérifiées.",
)} lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-20"><div class="absolute inset-0 bg-grid" aria-hidden="true"></div><div class="relative z-10">
    <div class="container mx-auto px-4 text-center">
      <Badge variant="outline" class="mb-4 border-primary/30 bg-primary/5 text-primary">{i18n.t('ask.title')}</Badge>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {i18n.t('ask.title')}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        {t(
          "Natural language queries across 206 government data modules. Every answer includes verified citations and SHA-256 source hashes.",
          "Requêtes en langage naturel dans 206 modules de données gouvernementales. Chaque réponse inclut des citations vérifiées et des hachages de source SHA-256.",
        )}
      </p>
    </div>
    </div>
  </section>

  <!-- Chat Interface -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="w-full ask-page-tabs" id="ask-tabs-root">
        <div class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground mb-6">
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-background text-foreground shadow-sm" data-asktab="ask">{i18n.t('ask.title')}</button>
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 text-muted-foreground hover:text-foreground" data-asktab="history">{i18n.t('common.search')}</button>
        </div>
        <div class="ask-tab-panel" data-asktab="ask">
          <!-- Edge AI worker chat — direct fetch to /v1/ai/ask -->
          <AgentChat client:load lang={lang} />
        </div>
        <div class="ask-tab-panel hidden" data-asktab="history">
          <Card>
            <CardHeader>
              <CardTitle>{i18n.t('ask.title')}</CardTitle>
              <CardDescription>{i18n.t('ask.placeholder')}</CardDescription>
            </CardHeader>
            <CardContent>
              <div id="history-list" class="space-y-3">
                <p class="text-sm text-muted-foreground text-center py-8">
                  {t(
                    "Chat history is stored locally in your browser. Sign in to start a conversation.",
                    "L'historique des conversations est stocké localement dans votre navigateur. Connectez-vous pour démarrer une conversation.",
                  )}
                </p>
              </div>
            </CardContent>
          </Card>
      </div>
      </div>
    </div>
  </section>


  <script>
    (function () {
      "use strict";

      // Tab switching — preserved from original ask page
      document.querySelectorAll("[data-asktab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var tab = this.getAttribute("data-asktab");
          document.querySelectorAll("[data-asktab]").forEach(function (b) {
            b.className =
              "inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 " +
              (b === btn
                ? "bg-background text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground");
          });
          document.querySelectorAll(".ask-tab-panel").forEach(function (p) {
            p.classList.toggle("hidden", p.getAttribute("data-asktab") !== tab);
          });
        });
      });
    })();
  </script>
</BaseLayout>
