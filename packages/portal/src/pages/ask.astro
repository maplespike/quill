---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Textarea } from "@/components/ui/textarea";
---

<BaseLayout title="Ask" description="Ask natural language questions about Canadian government data. AI-powered answers with verified citations.">
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-20"><div class="absolute inset-0 bg-grid" aria-hidden="true"></div><div class="relative z-10">
    <div class="container mx-auto px-4 text-center">
      <Badge variant="outline" class="mb-4 border-primary/30 bg-primary/5 text-primary">AI-powered queries</Badge>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Ask&nbsp;<span class="text-gradient">MapleSpike</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Natural language queries across 144 government data modules. Every answer includes
        verified citations and SHA-256 source hashes.
      </p>
    </div>
  </section>

  <!-- Chat Interface -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="w-full ask-page-tabs" id="ask-tabs-root">
        <div class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground mb-6">
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-background text-foreground shadow-sm" data-asktab="ask">Ask</button>
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 text-muted-foreground hover:text-foreground" data-asktab="history">History</button>
        </div>
        <div class="ask-tab-panel" data-asktab="ask">
          <!-- Chat Card -->
          <Card class="mb-6">
            <CardContent class="p-0 flex flex-col">
              <!-- Messages Area -->
              <div
                id="chat-messages"
                class="flex flex-col gap-4 p-6 min-h-[360px] max-h-[480px] overflow-y-auto"
              >
                <!-- Empty State -->
                <div id="chat-empty" class="flex flex-col items-center justify-center text-center py-12">
                  <div class="text-3xl mb-4 opacity-60">✦</div>
                  <h3 class="text-lg font-semibold text-muted-foreground mb-2">
                    Ask anything about Canadian government
                  </h3>
                  <p class="text-sm text-muted-foreground max-w-md mb-6">
                    Questions answered using MapleSpike's 142 data modules. Every response
                    includes citations for verification.
                  </p>
                  <div class="flex flex-wrap gap-2 justify-center" id="suggestion-chips">
                    <button class="suggestion-chip" data-prompt="What did the ethics committee discuss recently?">
                      Ethics committee activity
                    </button>
                    <button class="suggestion-chip" data-prompt="Show me lobbying activity by RBC">
                      Lobbying by RBC
                    </button>
                    <button class="suggestion-chip" data-prompt="Recent OAG audits and findings">
                      Recent OAG audits
                    </button>
                    <button class="suggestion-chip" data-prompt="What committees is Pierre Poilievre on?">
                      Poilievre committees
                    </button>
                    <button class="suggestion-chip" data-prompt="Sole-source contracts awarded in 2025">
                      Sole-source contracts 2025
                    </button>
                    <button class="suggestion-chip" data-prompt="In-camera meetings this month">
                      In-camera meetings
                    </button>
                  </div>
                </div>
              </div>

              <!-- Input Area -->
              <div class="border-t p-4 bg-muted/30">
                <div class="flex items-end gap-2">
                  <Textarea
                    id="ask-input"
                    placeholder="Ask about Parliament, lobbying, regulations..."
                    class="min-h-[48px] max-h-[160px] flex-1 resize-none"
                    rows="1"
                  ></Textarea>
                  <Button id="ask-send-btn" class="shrink-0 h-10 px-5">
                    Ask
                  </Button>
                </div>
                <div class="flex items-center justify-between mt-3">
                  <span class="text-xs text-muted-foreground">
                    Powered by MapleSpike MCP · Cited responses
                  </span>
                  <Badge class="bg-green-500/10 text-green-600 border-green-500/20 text-xs">
                    Verified
                  </Badge>
                </div>
              </div>
            </CardContent>
          </Card>

          <!-- Quick Info -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card>
              <CardHeader class="p-4">
                <CardTitle class="text-sm flex items-center gap-2"> Data Sources</CardTitle>
              </CardHeader>
              <CardContent class="px-4 pb-4 pt-0">
                <p class="text-xs text-muted-foreground">
                  Queries search across 144 modules: Parliament, lobbying, courts,
                  immigration, regulations, procurement, and more.
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader class="p-4">
                <CardTitle class="text-sm flex items-center gap-2"> Verified Citations</CardTitle>
              </CardHeader>
              <CardContent class="px-4 pb-4 pt-0">
                <p class="text-xs text-muted-foreground">
                  Every answer includes SHA-256 citation hashes and trust scores (≥60%)
                  for independent source verification.
                </p>
              </CardContent>
            </Card>
            <Card>
              <CardHeader class="p-4">
                <CardTitle class="text-sm flex items-center gap-2"> Cross-Reference</CardTitle>
              </CardHeader>
              <CardContent class="px-4 pb-4 pt-0">
                <p class="text-xs text-muted-foreground">
                  Engine correlates data across modules — linking lobbying to committees,
                  contracts to GIC appointments, and more.
                </p>
              </CardContent>
            </Card>
          </div>
      </div>
        <div class="ask-tab-panel hidden" data-asktab="history">
          <Card>
            <CardHeader>
              <CardTitle>Query History</CardTitle>
              <CardDescription>Your previous AI queries</CardDescription>
            </CardHeader>
            <CardContent>
              <div id="history-list" class="space-y-3">
                <p class="text-sm text-muted-foreground text-center py-8">
                  No query history yet. Your questions will appear here.
                </p>
              </div>
            </CardContent>
          </Card>
      </div>
      </div>
    </div>
  </section>

  <style>
    .suggestion-chip {
      display: inline-flex;
      align-items: center;
      padding: 8px 16px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-family: "JetBrains Mono", monospace;
      background: hsl(var(--muted));
      border: 1px solid hsl(var(--border));
      color: hsl(var(--muted-foreground));
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .suggestion-chip:hover {
      border-color: hsl(var(--primary));
      color: hsl(var(--foreground));
      background: hsl(var(--primary) / 0.1);
    }
    .chat-message {
      display: flex;
      gap: 12px;
      animation: fadeInUp 0.3s ease;
    }
    .chat-message.user {
      flex-direction: row-reverse;
    }
    .chat-message .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 700;
      flex-shrink: 0;
    }
    .chat-message.user .avatar {
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
    }
    .chat-message.assistant .avatar {
      background: hsl(var(--muted-foreground) / 0.2);
      color: hsl(var(--foreground));
    }
    .chat-message .bubble {
      max-width: 80%;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 0.88rem;
      line-height: 1.6;
    }
    .chat-message.user .bubble {
      background: hsl(var(--primary) / 0.1);
      border: 1px solid hsl(var(--primary) / 0.2);
      border-bottom-right-radius: 4px;
    }
    .chat-message.assistant .bubble {
      background: hsl(var(--muted));
      border: 1px solid hsl(var(--border));
      border-bottom-left-radius: 4px;
    }
    .chat-message .citations {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid hsl(var(--border));
    }
    .chat-message .citations summary {
      font-size: 0.72rem;
      color: hsl(var(--muted-foreground));
      cursor: pointer;
      font-family: "JetBrains Mono", monospace;
    }
    .chat-message .cite-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      margin-top: 6px;
      background: hsl(var(--muted) / 0.5);
      border-radius: 6px;
      font-size: 0.78rem;
    }
    .typing-dots {
      display: flex;
      gap: 4px;
      padding: 8px 0;
    }
    .typing-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: hsl(var(--muted-foreground));
      animation: typingDot 1.4s infinite;
    }
    .typing-dots span:nth-child(2) {
      animation-delay: 0.2s;
    }
    .typing-dots span:nth-child(3) {
      animation-delay: 0.4s;
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes typingDot {
      0%, 60%, 100% {
        opacity: 0.3;
        transform: scale(1);
      }
      30% {
        opacity: 1;
        transform: scale(1.3);
      }
    }
  </style>

  <script>
    (function () {
      "use strict";

      const messagesEl = document.getElementById("chat-messages");
      const emptyState = document.getElementById("chat-empty");
      const input = document.getElementById("ask-input");
      const sendBtn = document.getElementById("ask-send-btn");
      const suggestions = document.querySelectorAll(".suggestion-chip");
      const historyList = document.getElementById("history-list");

      const cfg = window.MAPLESPIKE || {};
      const base = cfg.apiBase || "http://127.0.0.1:8082";
      const API_ENDPOINT = base + "/v1/ai/ask";
      const GOV_SEARCH = base + "/v1/gov/search";

      // Mock responses as fallback
      const MOCK = {
        "ethics": {
          answer:
            '**Recent ETHI Committee Activity**\n\nThe House of Commons Ethics Committee (ETHI) has examined:\n\n• **Conflict of Interest Act** amendments — reviewing disclosure requirements\n• **Lobbying compliance** — testimony from major consulting firms\n• **In-camera sessions** — 2 flagged by MapleSpike\'s detection system\n• **Ethics Commissioner testimony** — ongoing investigations update\n\n4 meetings held this session including 2 behind closed doors.',
          citations: [
            { source: "ourcommons.ca", title: "ETHI Meeting 124", url: "https://www.ourcommons.ca/DocumentViewer/en/44-1/ETHI/meeting-124/evidence", hash: "sha256:a1b2c3d4..." },
            { source: "ciec-ccie.gc.ca", title: "Ethics Commissioner", url: "https://ciec-ccie.gc.ca/", hash: "sha256:e5f6a7b8..." },
          ],
        },
        "lobbying": {
          answer:
            '**RBC Lobbying Activity**\n\nRoyal Bank of Canada has active lobbying across multiple departments:\n\n• **OSFI guidelines** — B-20 mortgage rules, capital adequacy\n• **Housing policy** — affordability measures, CMHC programs\n• **Digital currency** — CBDC framework consultation\n• **Climate disclosure** — sustainable finance taxonomy\n\n**12** registered lobbyists · **34** communications (6 months)',
          citations: [
            { source: "lobbycanada.gc.ca", title: "RBC Lobbying Registry", url: "https://lobbycanada.gc.ca/", hash: "sha256:b2c3d4e5..." },
          ],
        },
        "oag": {
          answer:
            '**OAG Spring 2025 Reports**\n\nThe Auditor General released reports on:\n\n1. **ArriveCan procurement** — irregularities identified\n2. **Indigenous Services Canada** — health delivery gaps\n3. **CRA tax compliance** — enforcement gaps\n4. **Climate adaptation** — spending oversight\n\nAll reports tabled in Parliament. PACP reviewing findings.',
          citations: [
            { source: "oag-bvg.gc.ca", title: "Spring 2025 Reports", url: "https://www.oag-bvg.gc.ca/", hash: "sha256:d4e5f6a7..." },
          ],
        },
        "default": {
          answer:
            'Based on available government data sources, I found relevant information.\n\n**Summary:**\nMapleSpike covers 144 Canadian government sources including committees, lobbying, Canada Gazette, court decisions, and more.\n\nTry narrowing your query — mention a committee code (ETHI, FINA), company name, or specific department.',
          citations: [
            { source: "ourcommons.ca", title: "House of Commons", url: "https://www.ourcommons.ca/", hash: "sha256:f6a7b8c9..." },
          ],
        },
      };

      function getMock(query) {
        const q = query.toLowerCase();
        if (q.includes("ethics") || q.includes("ethi")) return MOCK.ethics;
        if (q.includes("lobby") || q.includes("rbc")) return MOCK.lobbying;
        if (q.includes("oag") || q.includes("audit")) return MOCK.oag;
        return MOCK.default;
      }

      function addMessage(role, text, citations) {
        const msg = document.createElement("div");
        msg.className = "chat-message " + role;

        const avatar = document.createElement("div");
        avatar.className = "avatar";
        avatar.textContent = role === "user" ? "U" : "AI";

        const bubble = document.createElement("div");
        bubble.className = "bubble";

        const textDiv = document.createElement("div");
        textDiv.style.whiteSpace = "pre-wrap";
        textDiv.innerHTML = text;
        bubble.appendChild(textDiv);

        if (citations && citations.length > 0) {
          const details = document.createElement("details");
          details.className = "citations";
          const summary = document.createElement("summary");
          summary.textContent = citations.length + " citation" + (citations.length > 1 ? "s" : "");
          details.appendChild(summary);

          citations.forEach(function (c) {
            const item = document.createElement("div");
            item.className = "cite-item";
            item.innerHTML =
              '<span style="color:hsl(var(--primary));font-weight:500;">' +
              escapeHtml(c.source) +
              "</span>" +
              '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.72rem;color:hsl(var(--muted-foreground));">' +
              escapeHtml(c.title) +
              "</span>" +
              '<span style="font-size:0.65rem;color:hsl(var(--muted-foreground));font-family:monospace;">' +
              escapeHtml(c.hash) +
              "</span>" +
              '<a href="' +
              escapeHtml(c.url) +
              '" target="_blank" style="color:hsl(var(--muted-foreground));text-decoration:none;">↗</a>';
            details.appendChild(item);
          });
          bubble.appendChild(details);
        }

        if (role === "assistant") {
          msg.appendChild(avatar);
          msg.appendChild(bubble);
        } else {
          msg.appendChild(bubble);
          msg.appendChild(avatar);
        }

        messagesEl.appendChild(msg);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }

      function showTyping() {
        const el = document.createElement("div");
        el.className = "chat-message assistant";
        el.id = "typing-msg";
        const avatar = document.createElement("div");
        avatar.className = "avatar";
        avatar.textContent = "AI";
        const bubble = document.createElement("div");
        bubble.className = "bubble";
        const dots = document.createElement("div");
        dots.className = "typing-dots";
        for (let i = 0; i < 3; i++) {
          const span = document.createElement("span");
          dots.appendChild(span);
        }
        bubble.appendChild(dots);
        el.appendChild(avatar);
        el.appendChild(bubble);
        messagesEl.appendChild(el);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }

      function hideTyping() {
        const el = document.getElementById("typing-msg");
        if (el) el.remove();
      }

      async function sendQuery(text) {
        if (!text.trim()) return;
        emptyState.style.display = "none";
        addMessage("user", text);
        input.value = "";
        sendBtn.disabled = true;
        showTyping();

        let answer, citations;

        try {
          // Try AI Ask endpoint first (synthesized answer via Inference Gateway)
          const aiResp = await fetch(API_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ query: text, max_sources: 5 }),
            signal: AbortSignal.timeout(15000),
          });
          if (aiResp.ok) {
            const data = await aiResp.json();
            if (data?.data?.answer) {
              answer = data.data.answer;
              citations = (data.data.citations || []).map(function (c) {
                return { source: c.source, title: c.title, url: c.url, hash: c.hash || "" };
              });
            } else {
              throw new Error("No AI answer");
            }
          } else {
            throw new Error("HTTP " + aiResp.status);
          }
        } catch (_) {
          // Fallback: gov/search
          try {
            const resp = await fetch(GOV_SEARCH + "?query=" + encodeURIComponent(text) + "&limit=5", {
              signal: AbortSignal.timeout(8000),
            });
            if (resp.ok) {
              const data = await resp.json();
              const results = data?.data?.results;
              const all = [...(results?.pipeline || []), ...(results?.ckan || [])].slice(0, 5);
              if (all.length > 0) {
                answer =
                  '**Search results for "' +
                  escapeHtml(text) +
                  '"**\n\nFound ' +
                  all.length +
                  " relevant sources:\n\n" +
                  all
                    .map(function (r, i) {
                      return (
                        i +
                        1 +
                        ". **" +
                        (r.title || r.name || "Dataset") +
                        "**" +
                        (r.description
                          ? "\n   " + r.description.substring(0, 120)
                          : "") +
                        (r.url ? "\n   " + r.url : "")
                      );
                    })
                    .join("\n\n");
                citations = all.map(function (r) {
                  return {
                    source: r.organization?.title || r.source || "Government of Canada",
                    title: r.title || r.name || "Dataset",
                    url: r.url || "#",
                    hash: "",
                  };
                });
              } else {
                throw new Error("No results");
              }
            } else {
              throw new Error("HTTP " + resp.status);
            }
          } catch (_) {
            const mock = getMock(text);
            answer = mock.answer;
            citations = mock.citations;
          }
        }
        hideTyping();
        addMessage("assistant", answer, citations);
        sendBtn.disabled = false;

        // Save to history
        const entry = document.createElement("div");
        entry.className =
          "flex items-center justify-between p-3 rounded-lg border bg-muted/30";
        entry.innerHTML =
          '<span class="text-sm truncate flex-1">' +
          escapeHtml(text.substring(0, 80)) +
          '</span><span class="text-xs text-muted-foreground shrink-0">Just now</span>';
        historyList.prepend(entry);
        const placeholder = historyList.querySelector(".text-center");
        if (placeholder) placeholder.remove();
      }

      sendBtn.addEventListener("click", function () {
        sendQuery(input.value);
      });
      input.addEventListener("keydown", function (e) {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          sendQuery(input.value);
        }
      });
      suggestions.forEach(function (chip) {
        chip.addEventListener("click", function () {
          sendQuery(this.getAttribute("data-prompt"));
        });
      });

      // Auto-resize textarea
      input.addEventListener("input", function () {
        this.style.height = "auto";
        this.style.height = Math.min(this.scrollHeight, 160) + "px";
      });

      // Tab switching
      document.querySelectorAll("[data-asktab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var tab = this.getAttribute("data-asktab");
          document.querySelectorAll("[data-asktab]").forEach(function (b) {
            b.className =
              "inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 " +
              (b === btn
                ? "bg-background text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground");
          });
          document.querySelectorAll(".ask-tab-panel").forEach(function (p) {
            p.classList.toggle("hidden", p.getAttribute("data-asktab") !== tab);
          });
        });
      });

      function escapeHtml(str) {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }
    })();
  </script>
</BaseLayout>
