---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
---

<BaseLayout title="Canada's Government Data Intelligence Layer" lang="en">
  <!-- Hero -->
  <section class="hero aurora relative overflow-hidden">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>

    <div
      class="relative z-10 mx-auto grid min-h-[88vh] max-w-7xl grid-cols-1 items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:py-28"
    >
      <!-- Left: copy -->
      <div class="flex flex-col items-start text-left">
        <!-- Status badge -->
        <div
          class="mb-8 inline-flex items-center gap-2.5 rounded-full border border-primary/25 bg-primary/5 px-4 py-1.5 backdrop-blur"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
          </span>
          <span class="text-xs font-medium text-primary">Open Government Data</span>
          <span class="text-xs text-muted-foreground">·</span>
          <span class="text-xs font-medium text-muted-foreground">206 modules live</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl xl:text-6xl">
          Canada's
          <span class="text-gradient">Data Intelligence</span>
          Layer
        </h1>

        <!-- Sub -->
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          One unified layer for Canadian government data — committees, lobbying, procurement,
          regulatory filings, and policy intelligence. Every record cited. Every source verified.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button asChild class="btn-sheen h-12 px-8 text-base" size="lg">
            <a href="/signup">Get Started</a>
          </Button>
          <Button asChild variant="outline" class="h-12 px-8 text-base backdrop-blur" size="lg">
            <a href="/explorer">Explore Data</a>
          </Button>
        </div>

        <!-- Mini trust row -->
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted-foreground/70">
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            SHA-256 citations
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            OGL-Canada compliant
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            MCP + REST + SDK
          </span>
        </div>
      </div>

      <!-- Right: live data visualization -->
      <div class="relative hidden lg:block" aria-hidden="true">

        <!-- Main floating panel: live API call -->
        <div class="card-hover relative rounded-2xl border border-border/80 bg-card/80 p-6 backdrop-blur-xl shadow-2xl">
          <!-- Window header -->
          <div class="mb-4 flex items-center gap-2 border-b border-border/60 pb-3">
            <div class="flex gap-1.5">
              <span class="h-3 w-3 rounded-full bg-red-500/60"></span>
              <span class="h-3 w-3 rounded-full bg-amber-500/60"></span>
              <span class="h-3 w-3 rounded-full bg-green-500/60"></span>
            </div>
            <span class="ml-2 font-mono text-xs text-muted-foreground">api.maplespike.lan/v1/search</span>
            <span class="ml-auto flex items-center gap-1 text-xs text-green-400">
              <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
              200 OK
            </span>
          </div>

          <!-- JSON response snippet -->
          <pre class="overflow-hidden font-mono text-xs leading-relaxed"><code><span class="text-muted-foreground">// Live response — verified</span>
<span class="text-cyan-400">"results"</span><span class="text-muted-foreground">: [</span>
  <span class="text-muted-foreground">{</span>
    <span class="text-cyan-400">"source"</span><span class="text-muted-foreground">:</span> <span class="text-amber-300">"House of Commons"</span><span class="text-muted-foreground">,</span>
    <span class="text-cyan-400">"committee"</span><span class="text-muted-foreground">:</span> <span class="text-amber-300">"FINA"</span><span class="text-muted-foreground">,</span>
    <span class="text-cyan-400">"title"</span><span class="text-muted-foreground">:</span> <span class="text-amber-300">"PBO fiscal outlook"</span><span class="text-muted-foreground">,</span>
    <span class="text-cyan-400">"date"</span><span class="text-muted-foreground">:</span> <span class="text-amber-300">"2026-06-18"</span><span class="text-muted-foreground">,</span>
    <span class="text-cyan-400">"citation"</span><span class="text-muted-foreground">: {</span>
      <span class="text-cyan-400">"hash"</span><span class="text-muted-foreground">:</span> <span class="text-green-400">"sha256:9f2a…"</span><span class="text-muted-foreground">,</span>
      <span class="text-cyan-400">"verified"</span><span class="text-muted-foreground">:</span> <span class="text-green-400">true</span>
    <span class="text-muted-foreground">}</span>
  <span class="text-muted-foreground">},</span>
  <span class="text-muted-foreground">&#123; ... </span><span class="text-cyan-400">+143 more</span><span class="text-muted-foreground"> &#125;</span>
<span class="text-muted-foreground">]</span></code></pre>

          <!-- Latency footer -->
          <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 font-mono text-xs text-muted-foreground">
            <span>42ms</span>
            <span class="flex items-center gap-1">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              streaming
            </span>
          </div>
        </div>

        <!-- Floating stat card: top-right -->
        <div class="card-hover absolute -right-4 -top-6 rounded-xl border border-border/80 bg-card/90 px-4 py-3 backdrop-blur-xl shadow-xl">
          <div class="font-mono text-2xl font-bold text-foreground">206</div>
          <div class="text-xs text-muted-foreground">data modules</div>
        </div>

        <!-- Floating stat card: bottom-left -->
        <div class="card-hover absolute -bottom-6 -left-4 rounded-xl border border-border/80 bg-card/90 px-4 py-3 backdrop-blur-xl shadow-xl">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
            </span>
            <span class="font-mono text-sm font-semibold text-foreground">live</span>
          </div>
          <div class="text-xs text-muted-foreground">data streaming 24/7</div>
        </div>
      </div>
    </div>

    <!-- Ticker bar -->
    <div class="relative z-10 border-y border-border/40 bg-background/60 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-3 overflow-hidden px-4 py-3 sm:px-6 lg:px-8">
        <span class="shrink-0 font-mono text-xs font-semibold uppercase tracking-wider text-primary">live</span>
        <div class="flex animate-[scroll_30s_linear_infinite] gap-8 whitespace-nowrap text-sm text-muted-foreground">
          {
            [
              "House of Commons FINA · PBO fiscal outlook",
              "Lobbying Registry · 3 new registrations",
              "Canada Gazette · Vol 160, No 24",
              "SEDI · Insider trade: BMO · $2.4M",
              "Procurement · DND contract · $18.2M",
              "Senate ENEC · Climate bill S-243",
              "StatCan · CPI +2.9% YoY",
              "Ethics Commissioner · 2 new investigations",
              "Competition Bureau · Rogers/Shaw review",
              "OAG · Spring 2026 report tabled",
            ].map((item) => (
              <span class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-primary/50" />
                {item}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics strip -->
  <section class="border-b border-border/60 bg-card/30">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-4 sm:px-6 lg:px-8 md:grid-cols-4">
      {
        [
          { value: "206", label: "Data modules", sub: "13 jurisdictions" },
          { value: "174", label: "MCP tools", sub: "AI agent ready" },
          { value: "13", label: "Source packages", sub: "monorepo" },
          { value: "191K+", label: "Lines of TS", sub: "13 packages" },
        ].map((s) => (
          <div class="px-4 py-10 text-center">
            <div class="bg-gradient-to-b from-foreground to-foreground/60 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl">
              {s.value}
            </div>
            <div class="mt-1.5 text-sm font-medium text-foreground/80">{s.label}</div>
            <div class="text-xs text-muted-foreground">{s.sub}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Capability cards -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Every source, one layer
        </h2>
        <p class="mt-4 text-muted-foreground">
          From Parliament to municipal councils — federal, corporate, and regulatory data unified
          with provenance and citation built in.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          [
            {
              title: "Federal & Provincial",
              desc: "All 13 provinces and territories, federal departments, 36 government agencies, and corporate registries.",
              path: "M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M9 9h.01M15 9h.01",
            },
            {
              title: "Corporate & Influence",
              desc: "Lobbying registry, procurement, SEDI insider trades, SEDAR+ filings, Corporations Canada.",
              path: "M3 21h18M5 21V8.5L12 4l7 4.5V21M9 21v-5h6v5M9 12h.01M15 12h.01",
            },
            {
              title: "Compliance & Risk",
              desc: "OAG audits, PBO reports, Ethics Commissioner, lobbying commissioner, Competition Bureau.",
              path: "M12 3l7.5 3v6c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6L12 3Z M9.5 12.5l1.8 1.8 3.5-3.6",
            },
          ].map((card) => (
            <div class="card-hover group rounded-xl border bg-card p-7">
              <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-primary/30 bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={card.path} />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold">{card.title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="aurora relative overflow-hidden border-t">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 md:py-28">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Start querying Canadian public data
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
        Free tier includes 1,000 API calls a month across every module. No credit card required.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button asChild class="btn-sheen h-11 px-7 text-base" size="lg">
          <a href="/signup">Create an account</a>
        </Button>
        <Button asChild variant="outline" class="h-11 px-7 text-base" size="lg">
          <a href="/pricing">View pricing</a>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
