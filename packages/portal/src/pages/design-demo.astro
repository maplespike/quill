<script>
  // Wire up copy buttons within the design demo canvases only
  const copyButtons = document.querySelectorAll(".design-demo-canvas .codeblock [data-copy]");
  const COPY_RESET_MS = 1500;

  copyButtons.forEach((btn) => {
    let isResetting = false;

    btn.addEventListener("click", async () => {
      if (isResetting) return;

      const codeBlock = btn.closest(".codeblock");
      const liveRegion = codeBlock?.querySelector(".copy-live-region");
      const code = codeBlock?.querySelector("pre")?.textContent || "";
      const original = btn.textContent;

      isResetting = true;
      btn.setAttribute("aria-disabled", "true");

      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "Copied!";
        if (liveRegion) liveRegion.textContent = "Code copied to clipboard";
      } catch {
        btn.textContent = "Failed";
        if (liveRegion) liveRegion.textContent = "Copy failed";
      }

      setTimeout(() => {
        btn.textContent = original;
        btn.removeAttribute("aria-disabled");
        isResetting = false;
        if (liveRegion) liveRegion.textContent = "";
      }, COPY_RESET_MS);
    });
  });
</script>
