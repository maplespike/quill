                {mcpTools.map((t) => (
                  <tr class="border-b last:border-0 hover:bg-muted/50 mcp-row" data-cat={t.cat} data-name={t.name} data-desc={t.desc}>
                    <td class="p-3">
                      <span class="text-xs font-mono text-muted-foreground bg-muted px-2 py-0.5 rounded">{t.cat}</span>
                    </td>
                    <td class="p-3 font-mono text-xs">{t.name}</td>
                    <td class="p-3 text-muted-foreground">{t.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </CardContent>
        </Card>

        <p class="text-xs text-muted-foreground mt-3">Showing all {mcpTools.length} MCP tools. Use the search box or category dropdown to filter. The full tool list is also available in <a href="/llms.txt" class="text-[#0891B2] hover:underline">llms.txt</a> for machine consumption.</p>
      </section>

      <script is:inline>
        (function () {
          const search = document.getElementById('mcp-search');
          const category = document.getElementById('mcp-category');
          const tbody = document.getElementById('mcp-tbody');
          const countEl = document.getElementById('mcp-count');
          const filteredLabel = document.getElementById('mcp-filtered-label');
          if (!search || !category || !tbody) return;

          // Populate category dropdown from data-cat attributes
          const cats = [...new Set([...tbody.querySelectorAll('.mcp-row')].map(r => r.dataset.cat))].sort();
          cats.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            category.appendChild(opt);
          });

          function filter() {
            const q = search.value.toLowerCase().trim();
            const cat = category.value;
            let visible = 0;
            tbody.querySelectorAll('.mcp-row').forEach(function (row) {
              const name = (row.dataset.name || '').toLowerCase();
              const desc = (row.dataset.desc || '').toLowerCase();
              const rowCat = row.dataset.cat || '';
              const matchesText = !q || name.includes(q) || desc.includes(q);
              const matchesCat = !cat || rowCat === cat;
              if (matchesText && matchesCat) {
                row.style.display = '';
                visible++;
              } else {
                row.style.display = 'none';
              }
            });
            countEl.textContent = visible;
            filteredLabel.classList.toggle('hidden', !q && !cat);
          }

          search.addEventListener('input', filter);
          category.addEventListener('change', filter);
        })();
      </script>

