        </div>
        <h2 class="text-2xl font-bold mb-4">One shape. Specific categories.</h2>
        <p class="text-muted-foreground mb-6">All error responses carry <code class="px-1 py-0.5 bg-muted rounded text-xs font-mono">success: false</code>, a stable error code, and a human-readable message.</p>

        <Card>
          <CardContent class="p-0 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b">
                  <th class="text-left p-3 font-semibold text-muted-foreground">Code</th>
                  <th class="text-left p-3 font-semibold text-muted-foreground">Status</th>
                  <th class="text-left p-3 font-semibold text-muted-foreground">Retry</th>
                  <th class="text-left p-3 font-semibold text-muted-foreground">Meaning</th>
                </tr>
              </thead>
              <tbody>
                {errorCodes.map((e) => (
                  <tr class="border-b last:border-0 hover:bg-muted/50">
                    <td class="p-3 font-mono text-xs">{e.code}</td>
                    <td class="p-3">
                      <span class={`text-xs font-semibold px-2 py-0.5 rounded ${
                        e.status === "401" || e.status === "402" || e.status === "500"
                          ? "text-red-500 bg-red-500/10"
                          : e.status === "429"
                          ? "text-orange-500 bg-orange-500/10"
                          : e.status === "502"
                          ? "text-yellow-500 bg-yellow-500/10"
                          : "text-muted-foreground bg-muted"
                      }`}>{e.status}</span>
                    </td>
                    <td class="p-3">
                      <span class={e.retry === "Yes" ? "text-emerald-500" : "text-muted-foreground"}>{e.retry}</span>
                    </td>
                    <td class="p-3 text-muted-foreground">{e.meaning}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </CardContent>
        </Card>
      </section>

      <Separator class="mb-16" />

      <!-- ═══ 09: FAQ ═══ -->
      <section id="faq" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-4">
          <span class="text-primary">[</span>          <span class="text-primary/80">11</span><span class="text-primary">]</span>
          <span class="font-semibold text-foreground">FAQ</span>
        </div>
        <h2 class="text-2xl font-bold mb-6">Common questions</h2>

        {[
          { q: "Do I need a credit card to start?", a: "No. Free plan: 1,000 calls/month, every source, every SDK, citation hashes included. No card, no time limit." },
          { q: "What makes the citations verifiable?", a: "Every response includes source name, exact upstream URL, retrieval timestamp, and a SHA-256 content hash. You can re-fetch and confirm exactly what the agent saw." },
          { q: "Which AI frameworks are supported?", a: "MCP (Claude, Cursor, Windsurf, ChatGPT), Anthropic tool_use, OpenAI function calling. TypeScript and Python SDKs." },
          { q: "How fresh is the data?", a: "Depends on the source. Committee evidence: ~24h. Canada Gazette: within hours of publication. CanLII: daily. Every response ships with a freshness_seconds field." },
          { q: "What is the cross-reference engine?", a: "Search for any person or company and get their complete government footprint — lobbying meetings, committee testimony, GIC board appointments, procurement contracts, court cases, and campaign donations — in a unified timeline." },
          { q: "Is my API key secure?", a: "Keys are hashed with SHA-256 at rest — we only see them at verify time. HTTPS-only transit. Rotate from the workspace instantly." },
        ].map((faq) => (
          <Card class="mb-4">
            <CardContent class="p-4">
              <p class="font-semibold mb-1">{faq.q}</p>
              <p class="text-sm text-muted-foreground">{faq.a}</p>
            </CardContent>
          </Card>
        ))}
      </section>
    </main>
  </div>
</BaseLayout>
