            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;fresh&quot;</span>: true,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_name&quot;</span>: <span class="text-[#0891B2]">&quot;Nunavut Bureau of Statistics&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;jurisdiction&quot;</span>: <span class="text-[#0891B2]">&quot;nunavut&quot;</span><br />
            &nbsp;&nbsp;&#125;<br />
            &#125;<br /><br />
            <span class="text-muted-foreground">// Response (expired cache → 404)</span><br />
            &#123;<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;success&quot;</span>: false,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;error&quot;</span>: &#123;<br />
