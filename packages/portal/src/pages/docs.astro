---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { createI18n } from "@maplespike/i18n";
import { pick, pickBi, type Bi } from "@/utils/bilingual";
import { localeUrl } from "@/utils/localeUrl";
import statsData from "@/data/stats.json";
import toolsData from "@/data/tools.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);

const mcpTools: { cat: string; name: string; desc: { en: string; fr: string } }[] = toolsData.tools;

// MCP tool categories — canonical English keys kept for filtering, French labels for display.
const catFr: Record<string, string> = {
  General: "Général", Parliament: "Parlement", Regulatory: "Réglementation",
  Elections: "Élections", Corporate: "Entreprises", Procurement: "Approvisionnement",
  Oversight: "Surveillance", Influence: "Influence", Immigration: "Immigration",
  Defence: "Défense", Health: "Santé", Transport: "Transport",
  Indigenous: "Autochtones", Provincial: "Provincial", Municipal: "Municipal",
  Economic: "Économie", Environment: "Environnement", Housing: "Logement",
  International: "International", Social: "Social", "Public Safety": "Sécurité publique",
  Media: "Médias", Science: "Science", Community: "Communauté",
  Charity: "Organismes de bienfaisance", "Global Affairs": "Affaires mondiales",
  AI: "IA", Entity: "Entités", System: "Système",
};
const catLabel = (c: string) => (lang === "fr" ? catFr[c] || c : c);

const sections: { id: string; num: string; label: Bi; badge?: string }[] = [
  { id: "quickstart", num: "00", label: { en: "Quickstart", fr: "Démarrage rapide" }, badge: "LIVE" },
  { id: "authentication", num: "01", label: { en: "Authentication", fr: "Authentification" } },
  { id: "request-response", num: "02", label: { en: "Request + Response", fr: "Requête + réponse" } },
  { id: "endpoints", num: "03", label: { en: "API Reference", fr: "Référence API" } },
  { id: "ai-endpoints", num: "04", label: { en: "AI Endpoints", fr: "Points de terminaison IA" }, badge: "EDGE" },
  { id: "extraction", num: "05", label: { en: "Browser Extraction", fr: "Extraction navigateur" } },
  { id: "token-optimization", num: "06", label: { en: "Token Optimization", fr: "Optimisation des jetons" } },
  { id: "citation-contract", num: "07", label: { en: "Citation Contract", fr: "Contrat de citation" } },
  { id: "mcp-tools", num: "08", label: { en: "MCP Tools", fr: "Outils MCP" }, badge: `${mcpTools.length} TOOLS` },
  { id: "rate-limits", num: "09", label: { en: "Rate Limits", fr: "Limites de débit" } },
  { id: "errors", num: "10", label: { en: "Errors", fr: "Erreurs" } },
  { id: "faq", num: "11", label: { en: "FAQ", fr: "FAQ" } },
  { id: "data-sources", num: "12", label: { en: "Data Sources & Licences", fr: "Sources de données et licences" } },
];

const apiEndpoints: { method: string; path: string; desc: Bi }[] = [
  // Core
  { method: "GET", path: "/v1/health", desc: { en: "System status and usage stats", fr: "État du système et statistiques d'utilisation" } },
  { method: "GET", path: "/v1/openapi.json", desc: { en: "Full OpenAPI 3.1 specification", fr: "Spécification OpenAPI 3.1 complète" } },
  { method: "GET", path: "/v1/me", desc: { en: "Current tenant info and API keys", fr: "Informations du locataire et clés API actuelles" } },
  { method: "GET", path: "/v1/usage", desc: { en: "Current billing period usage", fr: "Utilisation de la période de facturation actuelle" } },
  // Data
  { method: "GET", path: "/v1/gov/releases", desc: { en: "Latest government data releases", fr: "Dernières publications de données gouvernementales" } },
  { method: "GET", path: "/v1/gov/search?query=", desc: { en: "Full-text search across all sources", fr: "Recherche plein texte dans toutes les sources" } },
  { method: "GET", path: "/v1/citation/:hash", desc: { en: "Retrieve citation by SHA-256 hash", fr: "Récupérer une citation par hachage SHA-256" } },
  { method: "GET", path: "/v1/signals", desc: { en: "Cross-reference signals (requires engine)", fr: "Signaux de recoupement (nécessite le moteur)" } },
  // AI (edge worker)
  { method: "POST", path: "/v1/ai/ask", desc: { en: "Ask a question, get a sourced answer (edge AI)", fr: "Posez une question, obtenez une réponse sourcée (IA de périphérie)" } },
  { method: "POST", path: "/v1/ai/search", desc: { en: "Semantic search with edge embeddings", fr: "Recherche sémantique avec plongements de périphérie" } },
  { method: "GET", path: "/v1/ai/models", desc: { en: "List available AI models", fr: "Lister les modèles IA disponibles" } },
  { method: "POST", path: "/v1/ai/analyze", desc: { en: "Analyze a document/transcript for topics, entities, summary (Pro+)", fr: "Analyser un document/transcription : sujets, entités, résumé (Pro+)" } },
  // Auth
  { method: "POST", path: "/v1/register", desc: { en: "Create account and API key", fr: "Créer un compte et une clé API" } },
  { method: "GET", path: "/v1/verify/:token", desc: { en: "Verify email address", fr: "Vérifier l'adresse courriel" } },
  { method: "POST", path: "/v1/auth/refresh", desc: { en: "Refresh JWT token", fr: "Actualiser le jeton JWT" } },
  { method: "POST", path: "/v1/auth/logout", desc: { en: "Clear session", fr: "Fermer la session" } },
  // Keys
  { method: "GET", path: "/v1/keys", desc: { en: "List API keys", fr: "Lister les clés API" } },
  { method: "POST", path: "/v1/keys", desc: { en: "Create a new API key", fr: "Créer une nouvelle clé API" } },
  { method: "DELETE", path: "/v1/keys/:id", desc: { en: "Delete an API key", fr: "Supprimer une clé API" } },
  { method: "POST", path: "/v1/keys/:id/rotate", desc: { en: "Rotate an API key", fr: "Faire pivoter une clé API" } },
  // Billing
  { method: "POST", path: "/v1/billing/checkout", desc: { en: "Create checkout session", fr: "Créer une session de paiement" } },
  { method: "GET", path: "/v1/billing/plans", desc: { en: "Available pricing plans", fr: "Forfaits disponibles" } },
  // Extraction (browser)
  { method: "GET", path: "/v1/extraction/tasks", desc: { en: "List browser extraction tasks for no-API portals", fr: "Lister les tâches d'extraction navigateur pour les portails sans API" } },
  { method: "POST", path: "/v1/extraction/results", desc: { en: "Submit extracted data from browser client", fr: "Soumettre les données extraites depuis le navigateur" } },
  { method: "GET", path: "/v1/extraction/cached/:source_id", desc: { en: "Get cached browser extraction results", fr: "Obtenir les résultats d'extraction navigateur en cache" } },
];

// MCP tool catalog — generated by scripts/generate-plans.mjs into
// src/data/tools.json (curated base + quill-mcp tool index + fr translations).
// NEVER hardcode tools here; edit src/data/tools-base.json or quill-mcp and re-run `pnpm gen:plans`.


const rateLimits = [
  { plan: { en: "Free", fr: "Gratuit" }, perSec: "2/s", perMonth: "1,000", overage: { en: "Hard cap (402)", fr: "Plafond strict (402)" } },
  { plan: { en: "Pro", fr: "Pro" }, perSec: "25/s", perMonth: "50,000", overage: { en: "$1/1K (planned)", fr: "1 $/1 K (prévu)" } },
  { plan: { en: "Business", fr: "Affaires" }, perSec: "100/s", perMonth: "250,000", overage: { en: "$0.80/1K (planned)", fr: "0,80 $/1 K (prévu)" } },
  { plan: { en: "Enterprise", fr: "Entreprise" }, perSec: "Custom", perMonth: "Custom", overage: { en: "Negotiated", fr: "Négocié" } },
];

const errorCodes = [
  { code: "auth_invalid", status: "401", retry: { en: "No", fr: "Non" }, meaning: { en: "Fix API key or JWT", fr: "Corriger la clé API ou le JWT" } },
  { code: "rate_limited", status: "429", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Respect Retry-After header", fr: "Respecter l'en-tête Retry-After" } },
  { code: "quota_exhausted", status: "402", retry: { en: "No", fr: "Non" }, meaning: { en: "Upgrade plan or wait for reset", fr: "Passer à un forfait supérieur ou attendre la réinitialisation" } },
  { code: "input_invalid", status: "400", retry: { en: "No", fr: "Non" }, meaning: { en: "Check input schema", fr: "Vérifier le schéma d'entrée" } },
  { code: "source_unavailable", status: "502", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Upstream source down, retry later", fr: "Source en amont indisponible, réessayer plus tard" } },
  { code: "not_found", status: "404", retry: { en: "No", fr: "Non" }, meaning: { en: "Resource doesn't exist", fr: "La ressource n'existe pas" } },
  { code: "server_error", status: "500", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Backoff, report if persistent", fr: "Reculer, signaler si persistant" } },
];
---

<BaseLayout title={i18n.t('docs.title')} description={t(            "Quill API documentation — quickstart guide, REST API reference, MCP configuration, and SDK usage. Source terms vary by publisher and dataset.",
            "Documentation de l'API Quill — démarrage rapide, référence REST, configuration MCP et utilisation des SDK. Les conditions varient selon l'éditeur et le jeu de données.",
)} ogImage="/og-image-docs.png" lang={lang}>
  <div class="docs-layout page-width">
    <!-- Sidebar -->
    <aside class="docs-sidebar hidden lg:block" aria-label={t('Documentation sections', 'Sections de la documentation')}>
      <div class="p-4">
        <div class="relative mb-4">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <Input placeholder={t("Search docs...", "Rechercher dans la documentation…")} className="pl-9 text-sm" />
        </div>
        <nav class="space-y-1" aria-label={t('On this page', 'Sur cette page')}>
          {sections.map((s) => (
            <a
              href={`#${s.id}`}
              class="flex items-center gap-2 px-3 py-2 text-sm rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            >
              <span class="text-xs font-mono text-primary/60">{s.num}</span>
              <span>{tb(s.label)}</span>
              {s.badge && (
                <span class="ml-auto text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-primary/10 text-primary">{s.badge}</span>
              )}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Main content -->
    <div class="docs-content">
      <!-- ═══ 00: QUICKSTART ═══ -->
      <section id="quickstart" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-2">
          <span class="text-primary">[</span>
          <span class="text-primary/80">00</span>
          <span class="text-primary">]</span>
          <span class="font-semibold text-foreground">{t("Quickstart", "Démarrage rapide")}</span>
          <Badge variant="default" className="text-[10px] px-1.5 py-0.5">LIVE</Badge>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl mb-4">
          {t('Build with the public record.', 'Créez avec les dossiers publics.')}
        </h1>
        <p class="text-muted-foreground mb-3">{t(`${statsData.modules} data modules. MCP and REST. Source metadata where available.`, `${statsData.modules} modules de données. MCP et REST. Métadonnées de source lorsqu’elles sont disponibles.`)}</p>
        <p class="text-muted-foreground mb-8">{t(
          "Get an API key, make your first call, and see the citation contract — in under 5 minutes.",
          "Obtenez une clé API, effectuez votre premier appel et découvrez le contrat de citation — en moins de 5 minutes.",
        )}</p>

        <Card className="mb-6">
          <CardContent className="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
            <span class="text-muted-foreground">// {t("30-second quickstart", "Démarrage rapide en 30 secondes")}</span><br /><br />
            <span class="text-muted-foreground">$</span> curl -s https://api.maplespike.ca/v1/gov/search \<br />
            &nbsp;&nbsp;-H <span class="text-[#D4A017]">&quot;X-API-Key: ms_live_...&quot;</span> \<br />
            &nbsp;&nbsp;-G -d <span class="text-[#D4A017]">&quot;query=housing&quot;</span> \<br />
            &nbsp;&nbsp;-d <span class="text-[#D4A017]">&quot;jurisdiction=federal&quot;</span> \<br />
            &nbsp;&nbsp;-d <span class="text-[#D4A017]">&quot;_limit=2&quot;</span> | jq .<br /><br />
            &#123;<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;success&quot;</span>: true,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;data&quot;</span>: &#123; <span class="text-[#D4A017]">&quot;releases&quot;</span>: [...] &#125;,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;citation&quot;</span>: &#123;<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_name&quot;</span>: <span class="text-[#0891B2]">&quot;open.canada.ca&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;data_hash&quot;</span>: <span class="text-[#0891B2]">&quot;sha256:a1f3...&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;license&quot;</span>: <span class="text-[#0891B2]">&quot;The publisher license was not declared in the metadata returned to Quill. Consult the publisher's terms.&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;license_basis&quot;</span>: <span class="text-[#0891B2]">&quot;no-publisher-declaration&quot;</span><br />
            &nbsp;&nbsp;&#125;<br />
            &#125;
          </CardContent>
        </Card>

        <Card className="border-primary/20 bg-primary/5">
          <CardContent className="p-4 text-sm">
            <strong class="text-primary">{t("No key?", "Pas de clé ?")}</strong>
            <span class="text-muted-foreground"> {t(
              "Get one free at",
              "Obtenez-en une gratuitement à l'",
            )} <a href="/signup" class="text-[#0891B2] hover:underline">{t("signup", "inscription")}</a> {t(
              "— 1,000 calls/month included. Or pass",
              "— 1 000 appels/mois inclus. Ou passez",
            )} <code class="px-1 py-0.5 bg-muted rounded text-xs font-mono">_mock=true</code> {t("for sample data with no upstream hit.", "pour des données d'exemple sans appel en amont.")}</span>
          </CardContent>
        </Card>
      </section>

      <Separator className="mb-16" />

      <!-- ═══ 01: AUTHENTICATION ═══ -->
      <section id="authentication" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-4">
          <span class="text-primary">[</span><span class="text-primary/80">01</span><span class="text-primary">]</span>
          <span class="font-semibold text-foreground">{t("Authentication", "Authentification")}</span>
        </div>
        <h2 class="text-2xl font-bold mb-4">{t("Multiple ways to authenticate", "Plusieurs façons de s'authentifier")}</h2>
        <p class="text-muted-foreground mb-6">{t(
          "Four authentication methods, one JWT token format. All methods issue the same JWT — pick the one that fits your use case.",
          "Quatre méthodes d'authentification, un seul format de jeton JWT. Toutes les méthodes émettent le même JWT — choisissez celle qui convient à votre cas d'utilisation.",
        )}</p>

        <h3 class="text-lg font-semibold mt-6 mb-2">{t("API Key (recommended for servers)", "Clé API (recommandée pour les serveurs)")}</h3>
        <p class="text-sm text-muted-foreground mb-3">{t(
          "Create a key from the",
          "Créez une clé à partir de l'",
        )} <a href="/signup" class="text-[#0891B2] hover:underline">{t("signup", "inscription")}</a>, {t(
          "then send it as the",
          "puis envoyez-la dans l'en-tête",
        )} <code class="px-1 py-0.5 bg-muted rounded text-xs font-mono">X-API-Key</code> :</p>
        <Card className="mb-6">
          <CardContent className="p-3 font-mono text-sm">
            <span class="text-muted-foreground">$</span> curl -H <span class="text-[#D4A017]">&quot;X-API-Key: ms_live_...&quot;</span> https://api.maplespike.ca/v1/health
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">{t("OAuth (recommended for web apps)", "OAuth (recommandé pour les applications Web)")}</h3>
        <p class="text-sm text-muted-foreground mb-3">{t(
          "Sign in with GitHub, Google, or any OIDC provider:",
          "Connectez-vous avec GitHub, Google ou tout fournisseur OIDC :",
        )}</p>
        <Card className="mb-6">
          <CardContent className="p-3 font-mono text-sm">
            <span class="text-muted-foreground"># {t("List configured providers", "Lister les fournisseurs configurés")}</span><br />
            <span class="text-muted-foreground">$</span> curl https://api.maplespike.ca/v1/auth/oauth/providers
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">{t("Web3 Wallet", "Portefeuille Web3")}</h3>
        <p class="text-sm text-muted-foreground mb-3">{t(
          "Sign a SIWE (EIP-4361) message with your wallet:",
          "Signez un message SIWE (EIP-4361) avec votre portefeuille :",
        )}</p>
        <Card className="mb-6">
          <CardContent className="p-3 font-mono text-sm">
            POST /v1/auth/web3/challenge {'{'}{' '}<span class="text-[#D4A017]">&quot;address&quot;</span>: <span class="text-[#0891B2]">&quot;0x...&quot;</span>{' '}{'}'}
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">{t("Passkey / FIDO2", "Clé d'accès / FIDO2")}</h3>
        <p class="text-sm text-muted-foreground mb-3">{t(
          "Register a passkey (Touch ID, Windows Hello, YubiKey):",
          "Enregistrez une clé d'accès (Touch ID, Windows Hello, YubiKey) :",
        )}</p>
        <Card className="mb-6">
          <CardContent className="p-3 font-mono text-sm">
            POST /v1/auth/passkey/register/begin {'{'}{' '}<span class="text-[#D4A017]">&quot;userId&quot;</span>: <span class="text-[#0891B2]">&quot;...&quot;</span>{' '}{'}'}
          </CardContent>
        </Card>

        <p class="text-xs text-muted-foreground">{t(
          "All methods issue JWTs with the same format. Use the token as a Bearer header or session cookie. Keys are hashed with SHA-256 at rest.",
          "Toutes les méthodes émettent des JWT au même format. Utilisez le jeton comme en-tête Bearer ou cookie de session. Les clés sont hachées avec SHA-256 au repos.",
        )}</p>
      </section>

      <Separator className="mb-16" />

      <!-- ═══ 02: REQUEST + RESPONSE ═══ -->
      <section id="request-response" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-4">
          <span class="text-primary">[</span><span class="text-primary/80">02</span><span class="text-primary">]</span>
          <span class="font-semibold text-foreground">{t("Request + Response", "Requête + réponse")}</span>
        </div>
        <h2 class="text-2xl font-bold mb-4">{t("One envelope. Every endpoint.", "Une seule enveloppe. Chaque point de terminaison.")}</h2>
        <p class="text-muted-foreground mb-6">{t(
          "Responses use a common envelope; available quality, citation, and usage fields depend on the endpoint and source.",
          "Les réponses utilisent une enveloppe commune; les champs de qualité, de citation et d'utilisation disponibles dépendent du point de terminaison et de la source.",
        )}</p>

        <Card>
          <CardContent className="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
            &#123;<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;success&quot;</span>: true,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;data&quot;</span>: &#123; /* structured payload */ &#125;,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;quality&quot;</span>: &#123;<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;freshness_seconds&quot;</span>: 47,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;confidence&quot;</span>: <span class="text-green-500">&quot;high&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;certainty_score&quot;</span>: 0.923<br />
            &nbsp;&nbsp;&#125;,<br />
            &nbsp;&nbsp;<span class="text-[#D4A017]">&quot;citation&quot;</span>: &#123;<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_name&quot;</span>: <span class="text-[#0891B2]">&quot;open.canada.ca&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_url&quot;</span>: <span class="text-[#0891B2]">&quot;https://...&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;data_hash&quot;</span>: <span class="text-[#0891B2]">&quot;sha256:a1f3...&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;license&quot;</span>: <span class="text-[#0891B2]">&quot;The publisher license was not declared in the metadata returned to Quill. Consult the publisher's terms.&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;license_basis&quot;</span>: <span class="text-[#0891B2]">&quot;no-publisher-declaration&quot;</span><br />
            &nbsp;&nbsp;&#125;<br />
            &#125;
          </CardContent>
        </Card>
      </section>

      <Separator className="mb-16" />

      <!-- ═══ 03: ENDPOINTS ═══ -->
      <section id="endpoints" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-4">
          <span class="text-primary">[</span><span class="text-primary/80">03</span><span class="text-primary">]</span>
          <span class="font-semibold text-foreground">{t("API Reference", "Référence API")}</span>
        </div>
        <h2 class="text-2xl font-bold mb-4">{t("REST endpoints", "Points de terminaison REST")}</h2>
        <p class="mb-4 text-muted-foreground">
          <a href={localeUrl('/api-reference', lang)} class="text-primary hover:underline">{t("Open the HTML API reference", "Ouvrir la référence API HTML")}</a>
          {t(" — it renders the OpenAPI specification at /v1/openapi.json.", " — elle affiche la spécification OpenAPI à /v1/openapi.json.")}
        </p>

        <Card>
          <CardContent className="p-0 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b">
