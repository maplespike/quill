            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_name&quot;</span>: <span class="text-[#0891B2]">&quot;open.canada.ca&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;source_url&quot;</span>: <span class="text-[#0891B2]">&quot;https://...&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;data_hash&quot;</span>: <span class="text-[#0891B2]">&quot;sha256:a1f3...&quot;</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">&quot;license&quot;</span>: <span class="text-[#0891B2]">&quot;OGL-C&quot;</span><br />
