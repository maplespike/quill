<BaseLayout title="API Documentation" description="Full MapleSpike API documentation — quickstart guide, REST API reference, MCP configuration for AI agents, and SDK usage.">
  <div class="flex">
    <!-- Sidebar -->
    <aside class="hidden lg:block w-64 shrink-0 border-r min-h-[calc(100vh-4rem)] sticky top-16 self-start">
      <div class="p-4">
        <div class="relative mb-4">
