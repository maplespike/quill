      <Separator class="mb-16" />

      <!-- ═══ 01: AUTHENTICATION ═══ -->
      <section id="authentication" class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-3 text-sm font-mono text-muted-foreground mb-4">
          <span class="text-primary">[</span><span class="text-primary/80">01</span><span class="text-primary">]</span>
          <span class="font-semibold text-foreground">Authentication</span>
        </div>
        <h2 class="text-2xl font-bold mb-4">Multiple ways to authenticate</h2>
        <p class="text-muted-foreground mb-6">Four authentication methods, one JWT token format. All methods issue the same JWT — pick the one that fits your use case.</p>

        <h3 class="text-lg font-semibold mt-6 mb-2">API Key (recommended for servers)</h3>
        <p class="text-sm text-muted-foreground mb-3">Create a key from the <a href="/signup" class="text-[#0891B2] hover:underline">signup</a>, then send it as the <code class="px-1 py-0.5 bg-muted rounded text-xs font-mono">X-API-Key</code> header:</p>
        <Card class="mb-6">
          <CardContent class="p-3 font-mono text-sm">
            <span class="text-muted-foreground">$</span> curl -H <span class="text-[#D4A017]">&quot;X-API-Key: ms_live_...&quot;</span> https://api.maplespike.lan/v1/health
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">OAuth (recommended for web apps)</h3>
        <p class="text-sm text-muted-foreground mb-3">Sign in with GitHub, Google, or any OIDC provider:</p>
        <Card class="mb-6">
          <CardContent class="p-3 font-mono text-sm">
            <span class="text-muted-foreground"># List configured providers</span><br />
            <span class="text-muted-foreground">$</span> curl https://api.maplespike.lan/v1/auth/oauth/providers
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">Web3 Wallet</h3>
        <p class="text-sm text-muted-foreground mb-3">Sign a SIWE (EIP-4361) message with your wallet:</p>
        <Card class="mb-6">
          <CardContent class="p-3 font-mono text-sm">
            POST /v1/auth/web3/challenge {'{'}{' '}<span class="text-[#D4A017]">&quot;address&quot;</span>: <span class="text-[#0891B2]">&quot;0x...&quot;</span>{' '}{'}'}
          </CardContent>
        </Card>

        <h3 class="text-lg font-semibold mt-6 mb-2">Passkey / FIDO2</h3>
        <p class="text-sm text-muted-foreground mb-3">Register a passkey (Touch ID, Windows Hello, YubiKey):</p>
        <Card class="mb-6">
          <CardContent class="p-3 font-mono text-sm">
            POST /v1/auth/passkey/register/begin {'{'}{' '}<span class="text-[#D4A017]">&quot;userId&quot;</span>: <span class="text-[#0891B2]">&quot;...&quot;</span>{' '}{'}'}
          </CardContent>
        </Card>

        <p class="text-xs text-muted-foreground">All methods issue JWTs with the same format. Use the token as a Bearer header or session cookie. Keys are hashed with SHA-256 at rest.</p>
      </section>

