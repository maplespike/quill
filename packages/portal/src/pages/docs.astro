const rateLimits = [
  { plan: { en: "Free", fr: "Gratuit" }, perSec: "2/s", perMonth: "1,000", overage: { en: "Hard cap (402)", fr: "Plafond strict (402)" } },
  { plan: { en: "Pro", fr: "Pro" }, perSec: "25/s", perMonth: "50,000", overage: { en: "$1/1K (planned)", fr: "1 $/1 K (prévu)" } },
  { plan: { en: "Business", fr: "Affaires" }, perSec: "100/s", perMonth: "250,000", overage: { en: "$0.80/1K (planned)", fr: "0,80 $/1 K (prévu)" } },
  { plan: { en: "Enterprise", fr: "Entreprise" }, perSec: "Custom", perMonth: "Custom", overage: { en: "Negotiated", fr: "Négocié" } },
];

const errorCodes = [
  { code: "auth_invalid", status: "401", retry: { en: "No", fr: "Non" }, meaning: { en: "Fix API key or JWT", fr: "Corriger la clé API ou le JWT" } },
  { code: "rate_limited", status: "429", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Respect Retry-After header", fr: "Respecter l'en-tête Retry-After" } },
  { code: "quota_exhausted", status: "402", retry: { en: "No", fr: "Non" }, meaning: { en: "Upgrade plan or wait for reset", fr: "Passer à un forfait supérieur ou attendre la réinitialisation" } },
  { code: "input_invalid", status: "400", retry: { en: "No", fr: "Non" }, meaning: { en: "Check input schema", fr: "Vérifier le schéma d'entrée" } },
  { code: "source_unavailable", status: "502", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Upstream source down, retry later", fr: "Source en amont indisponible, réessayer plus tard" } },
  { code: "not_found", status: "404", retry: { en: "No", fr: "Non" }, meaning: { en: "Resource doesn't exist", fr: "La ressource n'existe pas" } },
  { code: "server_error", status: "500", retry: { en: "Yes", fr: "Oui" }, meaning: { en: "Backoff, report if persistent", fr: "Reculer, signaler si persistant" } },
