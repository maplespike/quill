  { method: "GET", path: "/v1/verify/:token", desc: "Verify email address" },
  { method: "POST", path: "/v1/auth/refresh", desc: "Refresh JWT token" },
  { method: "POST", path: "/v1/auth/logout", desc: "Clear session" },
