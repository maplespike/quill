---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import Overview from "@/components/dashboard/Overview";
import BillingPlans from "@/components/dashboard/BillingPlans";
import ApiKeysManager from "@/components/dashboard/ApiKeysManager";
import AISettings from "@/components/dashboard/AISettings";
import { createI18n } from "@maplespike/i18n";
import { localeUrl } from "@/utils/localeUrl";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
---

<BaseLayout title={i18n.t('dashboard.title')} description="Live MapleSpike API dashboard with usage stats and billing" lang={lang}>
  <section class="container mx-auto px-4 py-16 md:py-20">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4 reveal-on-scroll">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Developer <span class="text-gradient">{i18n.t('dashboard.title')}</span>
        </h1>
        <p class="mt-1.5 text-muted-foreground">
          {i18n.t('dashboard.overview')}
        </p>
      </div>
      <div class="flex gap-3">
        <Button variant="outline" asChild><a href={localeUrl('/docs', lang)} class="press-feedback inline-flex">{i18n.t('nav.docs')}</a></Button>
        <Button asChild className="btn-sheen"><a href={localeUrl('/signup', lang)} class="press-feedback inline-flex">{i18n.t('api_key.create')}</a></Button>
      </div>
    </div>

    <!-- Dashboard Tabs -->
    <div class="mb-8 flex gap-1 rounded-lg border bg-card/50 p-1 reveal-on-scroll">
      <a
        href={localeUrl('/dashboard', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors duration-200 ease-out",
          Astro.url.pathname === "/dashboard" || Astro.url.pathname.startsWith('/en/dashboard')
            ? "bg-primary text-primary-foreground"
            : "text-muted-foreground hover:text-foreground hover:bg-accent",
        ]}
      >
        {i18n.t('dashboard.tab.overview')}
      </a>
      <a
        href={localeUrl('/dashboard/extraction', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors duration-200 ease-out",
          "text-muted-foreground hover:text-foreground hover:bg-accent",
        ]}
      >
        {i18n.t('dashboard.tab.extraction')}
      </a>
      <a
        href={localeUrl('/dashboard/owasp', lang)}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-medium transition-colors duration-200 ease-out",
          "text-muted-foreground hover:text-foreground hover:bg-accent",
        ]}
      >
        {i18n.t('dashboard.tab.owasp')}
      </a>
    </div>

    <Overview client:load lang={lang} />

    <div class="mb-8 reveal-on-scroll">
      <Card className="card-hover">
        <CardHeader>
          <CardTitle>{i18n.t('dashboard.tab.billing')}</CardTitle>
          <CardDescription>{i18n.t('billing.feature.api_access')}</CardDescription>
        </CardHeader>
        <CardContent>
          <BillingPlans client:load lang={lang} />
        </CardContent>
      </Card>
    </div>

    <Card className="card-hover reveal-on-scroll">
      <CardHeader>
        <CardTitle>{i18n.t('settings.ai.title')}</CardTitle>
        <CardDescription>Bring your own AI key or use the cluster's hosted model</CardDescription>
      </CardHeader>
      <CardContent>
        <AISettings client:load lang={lang} />
      </CardContent>
    </Card>

    <Card className="card-hover reveal-on-scroll">
      <CardHeader>
        <CardTitle>{i18n.t('api_key.title')}</CardTitle>
        <CardDescription>{i18n.t('api_key.create')}</CardDescription>
      </CardHeader>
      <CardContent>
        <ApiKeysManager client:load lang={lang} />
      </CardContent>
    </Card>

  </section>
</BaseLayout>
