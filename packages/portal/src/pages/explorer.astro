---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import statsData from "@/data/stats.json";
import {
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
} from "@/components/ui/table";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('explorer.title')} description={t(
  `Browse and search Canadian government data across all ${statsData.modules} modules`,
  `Parcourez et recherchez les données gouvernementales canadiennes dans les ${statsData.modules} modules`,
)} lang={lang}>
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 reveal-on-scroll">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {t('The data explorer.', 'L’explorateur de données.')}
      </h1>
      <p class="mt-2 text-lg text-muted-foreground">
        {t(
          `Search across ${statsData.modules} data modules spanning federal, provincial, and municipal government sources.`,
          `Recherchez dans ${statsData.modules} modules de données couvrant les sources gouvernementales fédérales, provinciales et municipales.`,
        )}
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16 md:py-24">
    <div class="mb-8 reveal-on-scroll">

    <!-- Search and Filters -->
    <Card className="mb-8 card-hover">
      <CardHeader>
        <CardTitle>{t("Search", "Recherche")}</CardTitle>
        <CardDescription>
          {t(
            "Search across all data modules or filter by specific categories.",
            "Recherchez dans tous les modules de données ou filtrez par catégories précises.",
          )}
        </CardDescription>
      </CardHeader>
      <CardContent>
        <form id="explorer-form" class="space-y-4" method="GET" action={lang === 'fr' ? '/fr/explorer' : '/explorer'}>
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <label for="query" class="sr-only">{t('Search public data', 'Rechercher des données publiques')}</label>
              <Input id="query" name="query" type="search" placeholder={t("Search committees, lobbying records, legislation...", "Rechercher des comités, des dossiers de lobbying, de la législation…")} className="pl-10" />
            </div>
            <Button type="submit" className="press-feedback">{t("Search", "Rechercher")}</Button>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <div class="space-y-1">
              <label for="category" class="text-xs font-medium text-muted-foreground">{t("Category", "Catégorie")}</label>
              <select id="category" name="category" class="flex h-10 w-full min-w-[180px] rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                <option value="">{t("All Categories", "Toutes les catégories")}</option>
                <option value="federal">{t("Federal Government", "Gouvernement fédéral")}</option>
                <option value="provincial">{t("Provincial & Territorial", "Provincial et territorial")}</option>
                <option value="municipal">{t("Municipal", "Municipal")}</option>
                <option value="corporate">{t("Corporate & Influence", "Entreprises et influence")}</option>
                <option value="regulatory">{t("Regulatory & Oversight", "Réglementation et surveillance")}</option>
                <option value="legal">{t("Legal & Justice", "Droit et justice")}</option>
                <option value="parliament">{t("Parliament & Committees", "Parlement et comités")}</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="jurisdiction" class="text-xs font-medium text-muted-foreground">{t("Jurisdiction", "Compétence")}</label>
              <select id="jurisdiction" name="jurisdiction" class="flex h-10 w-full min-w-[160px] rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                <option value="">{t("All Jurisdictions", "Toutes les compétences")}</option>
                <option value="federal">{t("Federal", "Fédéral")}</option>
                <option value="on">Ontario</option>
                <option value="qc">{t("Quebec", "Québec")}</option>
                <option value="bc">{t("British Columbia", "Colombie-Britannique")}</option>
                <option value="ab">Alberta</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="sort" class="text-xs font-medium text-muted-foreground">{t("Sort By", "Trier par")}</label>
              <select id="sort" name="sort" class="flex h-10 w-full min-w-[140px] rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                <option value="relevance">{t("Relevance", "Pertinence")}</option>
                <option value="date_desc">{t("Newest First", "Plus récents d'abord")}</option>
                <option value="date_asc">{t("Oldest First", "Plus anciens d'abord")}</option>
                <option value="module">{t("Module", "Module")}</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="per_page" class="text-xs font-medium text-muted-foreground">{t("Results", "Résultats")}</label>
              <select id="per_page" name="per_page" class="flex h-10 w-full min-w-[100px] rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>
        </form>
      </CardContent>
    </Card>

    </div>

    <!-- Results Summary -->
    <div class="explorer-results-summary flex flex-wrap gap-3 items-center justify-between mb-4 reveal-on-scroll">
      <p class="text-sm text-muted-foreground">
        {t("Showing", "Affichage de")} <span id="results-shown" class="font-medium text-foreground">1&ndash;10</span> {t("of", "sur")}
        <span id="results-total" class="font-medium text-foreground">12,847</span> {t("results", "résultats")}
        <span id="results-status" class="ml-2 hidden text-xs"></span>
      </p>
      <div class="flex items-center gap-2">
        <Button variant="outline" size="sm" disabled>{t("Previous", "Précédent")}</Button>
        <Button variant="outline" size="sm">{t("Next", "Suivant")}</Button>
      </div>
    </div>

    <!-- Results Table -->
    <Card className="card-hover reveal-on-scroll">
      <CardContent className="p-0">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead className="w-[40%]">{t("Title", "Titre")}</TableHead>
              <TableHead>{t("Module", "Module")}</TableHead>
              <TableHead>{t("Source", "Source")}</TableHead>
              <TableHead>{t("Date", "Date")}</TableHead>
              <TableHead>{t("Trust", "Confiance")}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody id="explorer-results">
            <TableRow className="transition-colors duration-200 ease-out hover:bg-muted/30">
              <TableCell>
                <a href="/explorer/result/1" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("House of Commons — Standing Committee on Finance (FINA) — Meeting No. 142", "Chambre des communes — Comité permanent des finances (FINA) — Réunion n° 142")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Evidence of ministerial briefing on fiscal update and economic projections for 2026–2027.", "Témoignages de la séance d'information ministérielle sur la mise à jour économique et les projections financières pour 2026–2027.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">{t("Committees", "Comités")}</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("House of Commons", "Chambre des communes")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-15</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">96%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 96%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/2" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Lobbying Registry — Monthly Communication Report — January 2026", "Registre de lobbying — Rapport mensuel de communication — Janvier 2026")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Registered lobbying communications between designated public office holders and in-house lobbyists.", "Communications de lobbying enregistrées entre les titulaires de charge publique désignés et les lobbyistes internes.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">{t("Lobbying", "Lobbying")}</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("OCL Registry", "Registre du commissariat au lobbying")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-14</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">98%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 98%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/3" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Canada Gazette — Part I — Proposed Regulations — Clean Fuel Standard Amendments", "Gazette du Canada — Partie I — Règlements proposés — Modifications au Règlement sur les carburants propres")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Proposed regulatory amendments to the Clean Fuel Standard published for public comment.", "Modifications réglementaires proposées au Règlement sur les carburants propres publiées pour commentaires publics.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">{t("Gazette", "Gazette")}</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("Canada Gazette", "Gazette du Canada")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-12</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">99%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 99%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/4" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Governor-in-Council Appointments — February 2026 Report", "Nominations par décret — Rapport de février 2026")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("New appointments and renewals to federal boards, commissions, and tribunals.", "Nouvelles nominations et renouvellements aux conseils, commissions et tribunaux fédéraux.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">GIC</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("Infobase API", "API Infobase")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-10</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">94%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 94%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/6" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("OAG — 2026 Spring Reports — Volume 1 — Climate Change Adaptation", "BVG — Rapports du printemps 2026 — Volume 1 — Adaptation aux changements climatiques")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Auditor General audit of federal climate change adaptation programs and expenditures.", "Audit du vérificateur général des programmes et dépenses fédéraux d'adaptation aux changements climatiques.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">OAG</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("OAG Website", "Site Web du BVG")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-07</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">97%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 97%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/7" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Competition Bureau — Merger Review — Rogers–Shaw Post-Closing Compliance", "Bureau de la concurrence — Examen du regroupement — Conformité post-clôture Rogers–Shaw")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Compliance monitoring update on merger remedies and divestiture requirements.", "Mise à jour de la surveillance de la conformité concernant les mesures correctives et les exigences de cession du regroupement.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">{t("Competition", "Concurrence")}</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("Competition Bureau", "Bureau de la concurrence")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-05</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">92%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 92%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/8" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("CanLII — Federal Court of Appeal — 2026 FCA 89 — Environmental Review", "CanLII — Cour d'appel fédérale — 2026 CAF 89 — Examen environnemental")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Appeal decision regarding federal environmental assessment jurisdiction.", "Décision d'appel concernant la compétence fédérale en matière d'évaluation environnementale.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">CanLII</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">CanLII</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-03</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">95%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 95%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/9" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Statistics Canada — Labour Force Survey — April 2026", "Statistique Canada — Enquête sur la population active — Avril 2026")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Monthly LFS results including unemployment rate, participation rate, and employment by industry.", "Résultats mensuels de l'EPA, dont le taux de chômage, le taux de participation et l'emploi par industrie.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">StatCan</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("StatCan WDS", "SDS de Statistique Canada")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-05-01</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">99%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 99%"></div></div>
                </div>
              </TableCell>
            </TableRow>
            <TableRow>
              <TableCell>
                <a href="/explorer/result/10" class="font-medium text-primary transition-colors duration-200 hover:underline">{t("Procurement — TPSGC — IT Services Contract Award — March 2026", "Approvisionnement — SPAC — Octroi de contrat de services TI — Mars 2026")}</a>
                <p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">{t("Contract award notice for enterprise IT services with 3-year term and option periods.", "Avis d'octroi de contrat pour des services TI d'entreprise avec une durée de 3 ans et des périodes d'option.")}</p>
              </TableCell>
              <TableCell><Badge variant="secondary" className="text-xs">{t("Procurement", "Approvisionnement")}</Badge></TableCell>
              <TableCell className="text-sm text-muted-foreground">{t("CanadaBuys", "AchatsCanada")}</TableCell>
              <TableCell className="text-sm text-muted-foreground whitespace-nowrap">2026-04-28</TableCell>
              <TableCell>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium text-emerald-500">93%</span>
                  <div class="h-1.5 w-12 rounded-full bg-muted overflow-hidden"><div class="h-full rounded-full bg-emerald-500" style="width: 93%"></div></div>
                </div>
              </TableCell>
            </TableRow>
          </TableBody>
        </Table>
      </CardContent>
    </Card>

    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between reveal-on-scroll">
      <p class="text-sm text-muted-foreground">
        {t("Page", "Page")} <span class="font-medium text-foreground">1</span> {t("of", "de")}
        <span class="font-medium text-foreground">1</span>
      </p>
      <div class="flex items-center gap-2">
        <Button variant="outline" size="sm" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          {t("Previous", "Précédent")}
        </Button>
        <Button variant="outline" size="sm" className="bg-primary text-primary-foreground">1</Button>
        <Button variant="outline" size="sm" disabled>{t("Next", "Suivant")}</Button>
      </div>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (function () {
      "use strict";

      // Live search against the real API via the portal's same-origin /api
      // reverse proxy (server.py). If the API is unreachable we fall back to
      // the server-rendered showcase rows above — never fabricated data.
      var cfg = window.MAPLESPIKE || {};
      var apiBase = (cfg.apiBase || "") ? cfg.apiBase + "/v1" : "/api/v1";

      var form = document.getElementById("explorer-form");
      var tbody = document.getElementById("explorer-results");
      var shownEl = document.getElementById("results-shown");
      var totalEl = document.getElementById("results-total");
      var statusEl = document.getElementById("results-status");
      if (!form || !tbody || form.dataset.searchBound) return;
      form.dataset.searchBound = 'true';

      var FR = window.__LANG === "fr";
      function L(en, fr) { return FR ? fr : en; }
      var STR = {
        noResults: L("No results for “", "Aucun résultat pour «"),
        noResults2: L("” — try a broader term, or check the live API status.", "» — essayez un terme plus large, ou vérifiez l'état de l'API en direct."),
        untitled: L("Untitled record", "Enregistrement sans titre"),
        govSource: L("Government of Canada", "Gouvernement du Canada"),
        live: L("Live", "En direct"),
        searching: L("Searching…", "Recherche…"),
        liveBadge: L("· live", "· en direct"),
        unavailable: L("· unavailable (API)", "· indisponible (API)"),
        unreachable: L("· API unreachable — showing showcase data", "· API injoignable — affichage des données de démonstration"),
        showing: L("1–10", "1–10"),
        total: L("12,847", "12 847"),
        govModule: L("Government", "Gouvernement"),
      };

      // Preserve the SSR showcase rows as the initial (no-query) state and as
      // the honest fallback when the live search API is unreachable.
      var showcaseHtml = tbody.innerHTML;

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      // Only http(s) and same-origin relative links survive; anything else
      // (javascript:, data:, etc.) is dropped to keep the table inert.
      function safeHref(u) {
        try {
          var parsed = new URL(u, window.location.origin);
          if (parsed.protocol === "http:" || parsed.protocol === "https:") return parsed.href;
        } catch (e) { /* not a URL */ }
        return "#";
      }

      function renderResults(results, query) {
        if (!results || results.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="px-4 py-10 text-center text-sm text-muted-foreground">' +
            STR.noResults + esc(query) + STR.noResults2 +
            "</td></tr>";
          shownEl.textContent = "0";
          totalEl.textContent = "0";
          return;
        }
        var rows = results.map(function (r) {
          var title = r.title || STR.untitled;
          var href = safeHref(r.url || "");
          var desc = r.description || "";
          var module = r.category || r.source || STR.govModule;
          var source = r.source || STR.govSource;
          var date = r.date ? String(r.date).slice(0, 10) : "—";
          return (
            '<tr class="transition-colors duration-200 ease-out hover:bg-muted/30">' +
              '<td><a href="' + esc(href) + '" target="_blank" rel="noopener noreferrer" class="font-medium text-primary transition-colors duration-200 hover:underline">' + esc(title) + "</a>" +
              (desc ? '<p class="text-xs text-muted-foreground mt-0.5 line-clamp-1">' + esc(desc) + "</p>" : "") +
              "</td>" +
              '<td><span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium">' + esc(module) + "</span></td>" +
              '<td class="text-sm text-muted-foreground">' + esc(source) + "</td>" +
              '<td class="text-sm text-muted-foreground whitespace-nowrap">' + esc(date) + "</td>" +
              '<td><span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-500"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>' + STR.live + "</span></td>" +
            "</tr>"
          );
        }).join("");
        tbody.innerHTML = rows;
        shownEl.textContent = String(results.length);
        totalEl.textContent = String(results.length);
      }

      function setStatus(text, kind) {
        statusEl.classList.remove("hidden");
        statusEl.textContent = text;
        statusEl.className = "ml-2 text-xs font-medium " + (kind === "live" ? "text-emerald-500" : "text-amber-500");
      }

      async function search(query, limit) {
        var params = new URLSearchParams();
        params.set("q", query);
        params.set("limit", String(limit || 25));
        // NOTE: /v1/gov/search reads q/jurisdiction/limit only; the category
        // filter is applied client-side to the rendered module label, never sent.
        var jurEl = document.getElementById("jurisdiction");
        if (jurEl && jurEl.value) params.set("jurisdiction", jurEl.value);

        setStatus(STR.searching, "live");
        try {
          var resp = await fetch(apiBase + "/gov/search?" + params.toString());
          var body = await resp.json();
          var data = body.data || body;
          if (data.provenance && data.provenance.status === "live") {
            setStatus(STR.liveBadge, "live");
          } else {
            setStatus(STR.unavailable, "warn");
          }
          renderResults(data.results || [], query);
        } catch (err) {
          // Honest fallback: restore the server-rendered showcase rows rather
          // than showing a fabricated empty state.
          tbody.innerHTML = showcaseHtml;
          shownEl.textContent = STR.showing;
          totalEl.textContent = STR.total;
          setStatus(STR.unreachable, "warn");
        }
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var q = form.querySelector("[name=query]").value.trim();
        var per = form.querySelector("[name=per_page]");
        search(q, per ? Number(per.value) : 25);
      });

      // Deep-link support: /explorer?query=... runs a live search on load.
      var initial = new URLSearchParams(window.location.search).get("query");
      if (initial) {
        form.querySelector("[name=query]").value = initial;
        search(initial, 25);
      }
    })();
  </script>
</BaseLayout>
