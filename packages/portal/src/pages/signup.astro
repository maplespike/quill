---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SignupForm from "@/components/SignupForm";
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { createI18n } from "@maplespike/i18n";
import { pick, pickBi, type Bi } from "@/utils/bilingual";
import { cn } from "@/lib/utils";
import plansData from "@/data/plans.json";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);

const features: { title: Bi; description: Bi; icon: string }[] = [
  {
    title: { en: `${statsData.modules} Data Modules`, fr: `${statsData.modules} modules de données` },
    description: {
      en: `Access all ${statsData.modules} Canadian federal, provincial, territorial, and municipal government data sources through a single API.`,
      fr: `Accédez aux ${statsData.modules} sources de données gouvernementales canadiennes — fédérales, provinciales, territoriales et municipales — via une seule API.`,
    },
    icon: "database",
  },
  {
    title: { en: "Record Integrity", fr: "Intégrité des dossiers" },
    description: {
      en: "Source provenance and SHA-256 integrity metadata are available where supplied by the endpoint. Hashes do not establish source-data reuse rights.",
      fr: "La provenance des sources et les métadonnées d'intégrité SHA-256 sont disponibles lorsqu'elles sont fournies par le point de terminaison. Les hachages n'établissent pas les droits de réutilisation des données sources.",
    },
    icon: "shield",
  },
  {
    title: { en: `${statsData.tools} MCP Tools`, fr: `${statsData.tools} outils MCP` },
    description: {
      en: "Model Context Protocol tools for AI agents — committees, lobbying, court decisions, and more.",
      fr: "Outils du protocole de contexte de modèle pour les agents IA — comités, lobbyisme, décisions judiciaires, et plus.",
    },
    icon: "cpu",
  },
  {
    title: { en: "TypeScript & Python SDKs", fr: "SDK TypeScript et Python" },
    description: {
      en: "Typed client libraries for TypeScript (@maplespike/sdk) and Python (maplespike) with full documentation.",
      fr: "Bibliothèques client typées pour TypeScript (@maplespike/sdk) et Python (maplespike) avec documentation complète.",
    },
    icon: "code",
  },
  {
    title: { en: "Real-Time Data", fr: "Données en temps réel" },
    description: {
      en: "Live data from government-operated APIs, RSS feeds, CKAN portals, and XML dumps — updated continuously.",
      fr: "Données en direct d'API gouvernementales, de fils RSS, de portails CKAN et d'extractions XML — mises à jour en continu.",
    },
    icon: "clock",
  },
  {
    title: { en: "OpenAPI Spec", fr: "Spécification OpenAPI" },
    description: {
      en: "Full OpenAPI 3.1 specification at /v1/openapi.json for code generation and API exploration.",
      fr: "Spécification OpenAPI 3.1 complète à /v1/openapi.json pour la génération de code et l'exploration de l'API.",
    },
    icon: "file",
  },
];

const iconPaths: Record<string, string> = {
  database: "M4 7v4c0 2 8 3 20 3s20-1 20-3V7M4 11v4c0 2 8 3 20 3s20-1 20-3v-4",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10",
  cpu: "M9 3v2M15 3v2M5 8h2M5 14h2M17 8h2M17 14h2M9 19v2M15 19v2M5 5l2 2M17 5l2 2M5 17l2-2M17 17l2-2M10 9h4v6h-4z",
  code: "M16 18l6-6-6-6M8 6l-6 6 6 6",
  clock: "M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2M12 6v6l4 2",
  file: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8",
};

// Plan numbers come from src/data/plans.json (generated by
// scripts/generate-plans.mjs from /v1/billing/plans) — the same single
// source /pricing uses. NEVER hardcode price/limits here.
const planById = new Map(plansData.plans.map((p) => [p.plan_id, p]));
const freePlan = planById.get("free")!;
const proPlan = planById.get("pro")!;
const fmtMoney = (cents: number) => `$${Math.round(cents / 100)}`;
const fmtInt = (n: number | null | undefined, fr: boolean) =>
  n == null ? (fr ? "Illimité" : "Unlimited") : n.toLocaleString(fr ? "fr-CA" : "en-CA");
const callsBi = (plan: { credits_per_month: number | null }): Bi => ({
  en: `${fmtInt(plan.credits_per_month, false)} API calls/month`,
  fr: `${fmtInt(plan.credits_per_month, true)} appels API/mois`,
});
const rateBi = (plan: { rate_limit_per_min: number | null }): Bi => ({
  en: `${plan.rate_limit_per_min ?? "?"} req/min rate limit`,
  fr: `${plan.rate_limit_per_min ?? "?"} req/min limite de débit`,
});

const planCards: { name: Bi; desc: Bi; price: string; features: Bi[]; badge?: Bi; highlighted?: boolean; href: string; cta: Bi }[] = [
  {
    name: { en: "Free", fr: "Gratuit" },
    desc: { en: "For exploration and prototyping", fr: "Pour l'exploration et le prototypage" },
    price: fmtMoney(freePlan.price_cents),
    features: [
      callsBi(freePlan),
      rateBi(freePlan),
      { en: "Basic data access", fr: "Accès de base aux données" },
    ],
    href: "#signup-form",
    cta: { en: "Get your API key", fr: "Obtenez votre clé API" },
  },
  {
    name: { en: "Pro", fr: "Pro" },
    desc: { en: "For researchers and journalists", fr: "Pour les chercheurs et les journalistes" },
    price: fmtMoney(proPlan.price_cents),
    badge: { en: "BEST VALUE", fr: "MEILLEUR RAPPORT" },
    highlighted: true,
    features: [
      callsBi(proPlan),
      rateBi(proPlan),
      { en: "Full data access + MCP tools", fr: "Accès complet aux données + outils MCP" },
      { en: "Priority support", fr: "Support prioritaire" },
    ],
    href: "/pricing",
    cta: { en: "View pricing & buy", fr: "Voir la tarification et acheter" },
  },
  {
    name: { en: "Enterprise", fr: "Entreprise" },
    desc: { en: "For organizations and teams", fr: "Pour les organisations et les équipes" },
    price: "Custom",
    features: [
      { en: "Unlimited API calls", fr: "Appels API illimités" },
      { en: "Custom rate limits", fr: "Limites de débit personnalisées" },
      { en: "Dedicated support", fr: "Support dédié" },
      { en: "On-premise deployment", fr: "Déploiement sur site" },
    ],
    href: "/contact",
    cta: { en: "Contact us", fr: "Contactez-nous" },
  },
];
---

<BaseLayout
  title={i18n.t('signup.title')}
  description={t(
    "Get your free Quill API key. Search public-sector data sources through one API. 1,000 calls/month free, no credit card required. Source terms vary.",
    "Obtenez votre clé API Quill gratuite. Recherchez des sources de données du secteur public via une seule API. 1 000 appels/mois gratuits, sans carte de crédit. Les conditions varient selon la source.",
  )}
  lang={lang}
>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          {t("Get your free", "Obtenez votre")} <span class="text-gradient">{t("API key", "clé API gratuite")}</span>
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          {t(
            "1,000 calls per month free. No credit card required. Search a catalog of federal, provincial, territorial, municipal, and other public-sector sources through one API. Source coverage and terms vary.",
            "1 000 appels par mois gratuits. Sans carte de crédit. Recherchez dans un catalogue de sources fédérales, provinciales, territoriales, municipales et d'autres sources du secteur public via une seule API. La couverture et les conditions varient selon la source.",
          )}
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Badge variant="outline" className="border-primary/30 bg-primary/5 text-primary text-xs">{statsData.modules} {t("Data Modules", "modules de données")}</Badge>
          <Badge variant="outline" className="border-primary/30 bg-primary/5 text-primary text-xs">{statsData.tools} {t("MCP Tools", "outils MCP")}</Badge>
          <Badge variant="secondary" className="text-xs">        {t("SHA-256 Integrity", "Intégrité SHA-256")}</Badge>
          <Badge variant="secondary" className="text-xs">{t("TypeScript & Python SDKs", "SDK TypeScript et Python")}</Badge>
        </div>
      </div>
    </div>
  </section>

  <!-- Features grid + Signup form -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Left: Features -->
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-8">{t("Everything you get", "Tout ce que vous obtenez")}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {features.map((feature) => (
              <Card key={feature.title.en} className="card-hover border-border/60">
                <CardHeader className="p-4">
                  <div class="flex items-start gap-3">
                    <div class="shrink-0 mt-0.5 flex h-8 w-8 items-center justify-center rounded-md bg-primary/10">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-primary"
                      >
                        <path d={iconPaths[feature.icon]} />
                      </svg>
                    </div>
                    <div>
                      <CardTitle className="text-sm font-semibold">{tb(feature.title)}</CardTitle>
                      <CardDescription className="text-xs mt-1">{tb(feature.description)}</CardDescription>
                    </div>
                  </div>
                </CardHeader>
              </Card>
            ))}
          </div>
        </div>

        <!-- Right: Signup form -->
        <div id="signup-form">
          <SignupForm client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing comparison -->
  <section class="border-t py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-2xl font-bold tracking-tight mb-8 text-center">{t("Choose your plan", "Choisissez votre forfait")}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {planCards.map((card) => (
          <Card className={card.highlighted
            ? "card-hover border-primary/50 ring-1 ring-primary/20 shadow-lg shadow-primary/5 relative"
            : "card-hover border-border/60 relative"}>
            {card.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <Badge className="btn-sheen">{tb(card.badge)}</Badge>
              </div>
            )}
            <CardHeader>
              <CardTitle className="text-lg">{tb(card.name)}</CardTitle>
              <CardDescription>{tb(card.desc)}</CardDescription>
              <p class="text-3xl font-bold mt-4">
                {card.price}
                <span class="text-sm font-normal text-muted-foreground">{t("/month", "/mois")}</span>
              </p>
            </CardHeader>
            <CardContent className="space-y-3">
              {card.features.map((feature) => (
                <div class="flex items-center gap-2 text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12" /></svg>
                  <span class="text-muted-foreground">{tb(feature)}</span>
                </div>
              ))}
            </CardContent>
            <CardFooter>
              <a href={card.href} class="w-full">
                <Button
                  variant={card.highlighted ? "default" : "outline"}
                  className={cn("w-full", card.highlighted && "btn-sheen")}
                >
                  {tb(card.cta)}
                </Button>
              </a>
            </CardFooter>
          </Card>
        ))}
      </div>
      <p class="text-center text-sm text-muted-foreground mt-8">
        {t(
          "All plans include OpenAPI and SDK access. Citation and SHA-256 integrity metadata are available where supplied by the endpoint.",
          "Tous les forfaits incluent l'accès à OpenAPI et aux SDK. Les métadonnées de citation et d'intégrité SHA-256 sont disponibles lorsqu'elles sont fournies par le point de terminaison.",
        )}
      </p>
    </div>
  </section>
</BaseLayout>
