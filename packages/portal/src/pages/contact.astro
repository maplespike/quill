---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Badge } from "@/components/ui/badge";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('contact.title')} description={t("Get in touch with the MapleSpike team", "Communiquez avec l'équipe MapleSpike")} lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <Badge variant="outline" className="mb-4 border-primary/30 bg-primary/5 text-primary">{t("Get in touch", "Communiquez avec nous")}</Badge>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {i18n.t('contact.title')}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        {t(
          "Have questions about our government data intelligence platform? We are here to help.",
          "Des questions sur notre plateforme d'intelligence des données gouvernementales? Nous sommes là pour vous aider.",
        )}
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16 md:py-20">
    <div class="mx-auto max-w-2xl">

      <Card>
        <CardHeader>
          <CardTitle>{t("Send us a message", "Envoyez-nous un message")}</CardTitle>
          <CardDescription>
            {t(
              "Fill out the form below and our team will get back to you within 48 hours.",
              "Remplissez le formulaire ci-dessous et notre équipe vous répondra sous 48 heures.",
            )}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form
            class="space-y-6"
            method="POST"
            action="/api/contact"
            data-contact-form
          >
            <div class="space-y-2">
              <label
                for="name"
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                {t("Full Name", "Nom complet")}
              </label>
              <Input id="name" name="name" placeholder={t("Your full name", "Votre nom complet")} required />
            </div>

            <div class="space-y-2">
              <label
                for="email"
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                {t("Email Address", "Adresse courriel")}
              </label>
              <Input
                id="email"
                name="email"
                type="email"
                placeholder="you@organization.ca"
                required
              />
            </div>

            <div class="space-y-2">
              <label
                for="subject"
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                {t("Subject", "Sujet")}
              </label>
              <Input
                id="subject"
                name="subject"
                placeholder={t("How can we help?", "Comment pouvons-nous vous aider?")}
                required
              />
            </div>

            <div class="space-y-2">
              <label
                for="message"
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                {t("Message", "Message")}
              </label>
              <Textarea
                id="message"
                name="message"
                placeholder={t(
                  "Tell us about your use case, data needs, or any questions...",
                  "Parlez-nous de votre cas d'usage, de vos besoins en données ou de vos questions...",
                )}
                className="min-h-[160px]"
                required
              />
            </div>

            <Button type="submit" className="w-full">
              {t("Send Message", "Envoyer le message")}
            </Button>

            <p class="text-xs text-muted-foreground text-center">
              {t(
                "By submitting this form, you agree to our privacy policy. We will never share your information with third parties.",
                "En soumettant ce formulaire, vous acceptez notre politique de confidentialité. Nous ne partagerons jamais vos informations avec des tiers.",
              )}
            </p>
          </form>
        </CardContent>
      </Card>

      <!-- Additional contact methods -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-hover rounded-xl border border-border/60 bg-card p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="font-semibold mb-1">{t("Email Us", "Écrivez-nous")}</h3>
          <p class="text-sm text-muted-foreground">
            <a href="mailto:hello@maplespike.ca" class="text-primary hover:underline">hello@maplespike.ca</a>
          </p>
        </div>

        <div class="card-hover rounded-xl border border-border/60 bg-card p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="font-semibold mb-1">{t("Visit Us", "Visitez-nous")}</h3>
          <p class="text-sm text-muted-foreground">
            {t("Ottawa, Ontario", "Ottawa, Ontario")}<br />{t("Canada", "Canada")}
          </p>
        </div>

        <div class="card-hover rounded-xl border border-border/60 bg-card p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="font-semibold mb-1">{t("Call Us", "Appelez-nous")}</h3>
          <p class="text-sm text-muted-foreground">
            <a href="tel:+16135550100" class="text-primary hover:underline">+1 (613) 555-0100</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
