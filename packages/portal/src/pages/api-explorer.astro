---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { createI18n } from "@maplespike/i18n";
import { pick } from "@/utils/bilingual";
import { localeUrl } from "@/utils/localeUrl";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
---

<BaseLayout title={i18n.t('api_explorer.title')} description={t(
  "Test MapleSpike API endpoints, view OpenAPI spec, and run live queries against Canadian government data.",
  "Testez les points de terminaison de l'API MapleSpike, consultez la spécification OpenAPI et exécutez des requêtes en direct sur les données gouvernementales canadiennes.",
)} lang={lang}>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-20">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10">
      <div class="container mx-auto px-4 text-center">
        <Badge variant="outline" className="mb-4 border-primary/30 bg-primary/5 text-primary">{t("Developer playground", "Terrain de jeu développeur")}</Badge>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          API&nbsp;<span class="text-gradient">Explorer</span>
        </h1>
        <p class="mx-auto mt-3 text-sm">
          <a href={localeUrl('/api-reference', lang)} class="text-primary hover:underline">{t("Read the HTML API reference", "Lire la référence API HTML")}</a>
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
          {t(
            "Test endpoints, inspect responses, and explore the MapleSpike API. All requests go directly against the live API.",
            "Testez les points de terminaison, inspectez les réponses et explorez l'API MapleSpike. Toutes les requêtes vont directement vers l'API en direct.",
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- API Playground -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      <!-- API Key & Endpoint -->
      <div class="grid gap-6 md:grid-cols-3 mb-8">
        <Card className="md:col-span-2">
          <CardHeader>
            <CardTitle className="text-lg">{t("Endpoint", "Point de terminaison")}</CardTitle>
            <CardDescription>{t("Enter API endpoint path relative to base URL", "Saisissez le chemin du point de terminaison API relatif à l'URL de base")}</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex items-center gap-2">
              <Badge variant="secondary" className="font-mono text-xs shrink-0" id="method-badge">GET</Badge>
              <Input
                type="text"
                id="api-endpoint"
                placeholder="/v1/gov/search?query=housing&limit=5"
                className="font-mono text-sm flex-1"
              />
              <Button id="send-request-btn">{t("Send", "Envoyer")}</Button>
            </div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle className="text-lg">API Key</CardTitle>
            <CardDescription>{t("Your authentication key", "Votre clé d'authentification")}</CardDescription>
          </CardHeader>
          <CardContent>
            <Input type="password" id="api-key-input" placeholder="mp_..." className="font-mono text-sm" />
            <p class="text-xs text-muted-foreground mt-2">
              {t("Saved locally.", "Enregistrée localement.")} <a href="/workspace" class="text-primary hover:underline">{t("Get a key →", "Obtenir une clé →")}</a>
            </p>
          </CardContent>
        </Card>
      </div>

      <!-- Method & Body -->
      <div class="w-full mb-8 api-explorer-tabs" id="api-explorer-tabs-root">
        <div class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground mb-4">
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-background text-foreground shadow-sm" data-tab="get">GET</button>
          <button class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 text-muted-foreground hover:text-foreground" data-tab="post">POST</button>
        </div>
        <div class="tab-panel" data-tab="get">
          <Card>
            <CardHeader>
              <CardTitle className="text-lg">{t("Query Parameters", "Paramètres de requête")}</CardTitle>
              <CardDescription>{t("Add URL query parameters", "Ajouter des paramètres de requête URL")}</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-3" id="get-params">
                <div class="flex items-center gap-2">
                  <Input placeholder={t("Parameter name", "Nom du paramètre")} className="w-48 font-mono text-sm" />
                  <Input placeholder={t("Value", "Valeur")} className="flex-1 font-mono text-sm" />
                  <Button variant="ghost" size="sm">×</Button>
                </div>
              </div>
              <Button variant="outline" size="sm" className="mt-3">+ {t("Add parameter", "Ajouter un paramètre")}</Button>
            </CardContent>
          </Card>
        </div>
        <div class="tab-panel hidden" data-tab="post">
          <Card>
            <CardHeader>
              <CardTitle className="text-lg">{t("Request Body", "Corps de la requête")}</CardTitle>
              <CardDescription>{t("JSON payload for POST endpoints", "Charge utile JSON pour les points de terminaison POST")}</CardDescription>
            </CardHeader>
            <CardContent>
              <textarea
                id="request-body"
                class="flex min-h-[160px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm font-mono ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                placeholder='{"query": "lobbying", "limit": 10}'
              ></textarea>
            </CardContent>
          </Card>
        </div>
      </div>

      <!-- Response -->
      <Card className="mb-8">
        <CardHeader>
          <div class="flex items-center justify-between">
            <div>
              <CardTitle className="text-lg">{t("Response", "Réponse")}</CardTitle>
              <CardDescription>{t("API response will appear here", "La réponse API apparaîtra ici")}</CardDescription>
            </div>
            <div class="flex items-center gap-2" id="response-status">
              <Badge variant="outline" className="font-mono text-xs hidden" id="status-code">200</Badge>
              <span class="text-xs text-muted-foreground hidden" id="response-time"></span>
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <pre
            id="response-body"
            class="overflow-auto rounded-lg border bg-muted/50 p-4 font-mono text-xs leading-relaxed max-h-96"
          ><code class="text-muted-foreground">// {t("Send a request to see the response here", "Envoyez une requête pour voir la réponse ici")}</code></pre>
        </CardContent>
      </Card>

      <!-- Sample Requests -->
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">{t("Sample Requests", "Exemples de requêtes")}</CardTitle>
          <CardDescription>{t("Quick-start examples to copy and run", "Exemples de démarrage rapide à copier et exécuter")}</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            <div class="rounded-lg border bg-muted/30 p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium">{t("Search government data", "Rechercher des données gouvernementales")}</span>
                <Button variant="ghost" size="sm" className="copy-sample" data-code='curl -s "https://api.maplespike.ca/v1/gov/search?query=housing&limit=5"'>{t("Copy", "Copier")}</Button>
              </div>
              <pre class="font-mono text-xs text-muted-foreground overflow-x-auto"><code>curl -s "https://api.maplespike.ca/v1/gov/search?query=housing&limit=5"</code></pre>
            </div>
            <div class="rounded-lg border bg-muted/30 p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium">{t("Health check", "Vérification de l'état")}</span>
                <Button variant="ghost" size="sm" className="copy-sample" data-code="curl -s https://api.maplespike.ca/v1/health">{t("Copy", "Copier")}</Button>
              </div>
              <pre class="font-mono text-xs text-muted-foreground overflow-x-auto"><code>curl -s https://api.maplespike.ca/v1/health</code></pre>
            </div>
            <div class="rounded-lg border bg-muted/30 p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium">{t("Get data sources", "Obtenir les sources de données")}</span>
                <Button variant="ghost" size="sm" className="copy-sample" data-code="curl -s https://api.maplespike.ca/v1/sources">{t("Copy", "Copier")}</Button>
              </div>
              <pre class="font-mono text-xs text-muted-foreground overflow-x-auto"><code>curl -s https://api.maplespike.ca/v1/sources</code></pre>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <script>
    (function () {
      "use strict";

      const sendBtn = document.getElementById("send-request-btn");
      const endpointInput = document.getElementById("api-endpoint") as HTMLInputElement | null;
      const apiKeyInput = document.getElementById("api-key-input") as HTMLInputElement | null;
      // These four are rendered unconditionally by this page's template.
      const responseBody = document.getElementById("response-body")!;
      const statusCode = document.getElementById("status-code")!;
      const responseTime = document.getElementById("response-time")!;
      const methodBadge = document.getElementById("method-badge");

      // Restore saved API key
      const savedKey = localStorage.getItem("quill-api-key");
      if (savedKey && apiKeyInput) apiKeyInput.value = savedKey;

      if (apiKeyInput) {
        apiKeyInput.addEventListener("input", () => {
          if (apiKeyInput) localStorage.setItem("quill-api-key", apiKeyInput.value);
        });
      }

      // Tab switching
      document.querySelectorAll("[data-tab]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = btn.getAttribute("data-tab");
          document.querySelectorAll("[data-tab]").forEach((b) => {
            b.className =
              "inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 " +
              (b === btn
                ? "bg-background text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground");
          });
          document.querySelectorAll(".tab-panel").forEach((p) => {
            p.classList.toggle("hidden", p.getAttribute("data-tab") !== tab);
          });
          if (methodBadge && tab) methodBadge.textContent = tab.toUpperCase();
        });
      });

      // Send request
      if (sendBtn && endpointInput) {
        sendBtn.addEventListener("click", async function () {
          const cfg = window.MAPLESPIKE || {};
          const base = cfg.apiBase || "http://127.0.0.1:8082";
          const endpoint = endpointInput.value.trim();
          if (!endpoint) return;

          const key = apiKeyInput ? apiKeyInput.value.trim() : "";
          const isPost = methodBadge?.textContent === "POST";

          responseBody.innerHTML = `<code class="text-muted-foreground">Loading...</code>`;
          statusCode.classList.add("hidden");
          responseTime.classList.add("hidden");

          const url = base + (endpoint.startsWith("/") ? endpoint : "/" + endpoint);
          const start = performance.now();

          try {
            const headers: Record<string, string> = { "Content-Type": "application/json" };
            if (key) headers["Authorization"] = "Bearer " + key;

            const options: RequestInit = { method: isPost ? "POST" : "GET", headers };
            if (isPost) {
              const bodyEl = document.getElementById("request-body") as HTMLTextAreaElement | null;
              options.body = bodyEl ? bodyEl.value : "{}";
            }

            const resp = await fetch(url, options);
            const elapsed = Math.round(performance.now() - start);
            const text = await resp.text();

            // Try to pretty-print JSON
            let display = text;
            try {
              display = JSON.stringify(JSON.parse(text), null, 2);
            } catch (_) {}

            responseBody.innerHTML = `<code>${escapeHtml(display)}</code>`;
            statusCode.textContent = resp.status + " " + resp.statusText;
            statusCode.className =
              "font-mono text-xs " +
              (resp.status < 400
                ? "bg-green-500/10 text-green-600 border-green-500/20"
                : "bg-destructive/10 text-destructive border-destructive/20");
            statusCode.classList.remove("hidden");
            responseTime.textContent = elapsed + "ms";
            responseTime.classList.remove("hidden");
          } catch (e) {
            const msg = e instanceof Error ? e.message : String(e);
            responseBody.innerHTML = `<code class="text-destructive">Error: ${escapeHtml(msg)}</code>`;
          }
        });
      }

      // Copy sample requests
      document.querySelectorAll(".copy-sample").forEach((btn) => {
        btn.addEventListener("click", () => {
          const code = btn.getAttribute("data-code");
          if (code) {
            navigator.clipboard.writeText(code).then(() => {
              const orig = btn.textContent;
              btn.textContent = "Copied!";
              setTimeout(() => {
                btn.textContent = orig;
              }, 2000);
            });
          }
        });
      });

      function escapeHtml(str: string) {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }
    })();
  </script>
</BaseLayout>
