---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { createI18n } from "@maplespike/i18n";
import { localeUrl } from "@/utils/localeUrl";
import { pick, pickBi, type Bi } from "@/utils/bilingual";
import McpSetupWizard from "@/components/McpSetupWizard.astro";
import statsData from "@/data/stats.json";

const platforms: { name: string; icon: string; description: Bi; setup: string }[] = [
  {
    name: "Claude Desktop",
    icon: "🤖",
    description: {
      en: "Anthropic's desktop app. Open Settings → Developer → Edit Config, paste the MCP snippet below.",
      fr: "L'application de bureau d'Anthropic. Ouvrez Paramètres → Développeur → Modifier la config, collez l'extrait MCP ci-dessous.",
    },
    setup: "claude_desktop_config.json",
  },
  {
    name: "ChatGPT",
    icon: "🧠",
    description: {
      en: "OpenAI's ChatGPT with MCP support. Add the server in Settings → MCP Servers.",
      fr: "ChatGPT d'OpenAI avec support MCP. Ajoutez le serveur dans Paramètres → Serveurs MCP.",
    },
    setup: "chatgpt_mcp.json",
  },
  {
    name: "Cursor",
    icon: "🖊️",
    description: {
      en: "AI code editor. Add to .cursor/mcp.json in your project root.",
      fr: "Éditeur de code IA. Ajoutez à .cursor/mcp.json à la racine de votre projet.",
    },
    setup: ".cursor/mcp.json",
  },
  {
    name: "Windsurf",
    icon: "🌊",
    description: {
      en: "AI-powered IDE. Configure MCP servers in Settings → AI → MCP.",
      fr: "EDI piloté par IA. Configurez les serveurs MCP dans Paramètres → IA → MCP.",
    },
    setup: "windsurf_mcp.json",
  },
  {
    name: "Codebuff",
    icon: "🦾",
    description: {
      en: "Terminal-based AI coding agent. Add to ~/.codebuff/mcp.json.",
      fr: "Agent de codage IA en ligne de commande. Ajoutez à ~/.codebuff/mcp.json.",
    },
    setup: "~/.codebuff/mcp.json",
  },
  {
    name: "OpenCode",
    icon: "💻",
    description: {
      en: "Open-source AI coding agent. Configure in opencode.json in your project.",
      fr: "Agent de codage IA open source. Configurez dans opencode.json de votre projet.",
    },
    setup: "opencode.json",
  },
  {
    name: "Hermes",
    icon: "🔮",
    description: {
      en: "Self-evolution AI agent framework. Add MCP server in agent config.",
      fr: "Cadre d'agent IA à auto-évolution. Ajoutez le serveur MCP dans la config de l'agent.",
    },
    setup: "hermes_config.json",
  },
  {
    name: "OpenClaw",
    icon: "🦅",
    description: {
      en: "Multi-agent framework. Configure MCP in claw.yaml.",
      fr: "Cadre multi-agents. Configurez MCP dans claw.yaml.",
    },
    setup: "claw.yaml",
  },
  {
    name: "Gemini",
    icon: "💎",
    description: {
      en: "Google's Gemini. Use via MCP gateway or direct tool integration.",
      fr: "Gemini de Google. Utilisez via la passerelle MCP ou l'intégration directe d'outils.",
    },
    setup: "gemini_mcp.json",
  },
  {
    name: "Grok",
    icon: "⚡",
    description: {
      en: "xAI's Grok. Connect via MCP for real-time Canadian data context.",
      fr: "Grok de xAI. Connectez-vous via MCP pour un contexte de données canadiennes en temps réel.",
    },
    setup: "grok_mcp.json",
  },
  {
    name: "LM Studio",
    icon: "🖥️",
    description: {
      en: "Local LLM runner. Run @maplespike/mcp alongside your local models.",
      fr: "Exécuteur de LLM local. Faites tourner @maplespike/mcp avec vos modèles locaux.",
    },
    setup: "lm_studio_mcp.json",
  },
  {
    name: "Anything with MCP",
    icon: "🔌",
    description: {
      en: "Any tool that speaks the Model Context Protocol can use MapleSpike. Same config, same tools.",
      fr: "Tout outil qui parle le protocole de contexte de modèle peut utiliser MapleSpike. Même config, mêmes outils.",
    },
    setup: "mcp_config.json",
  },
];

const lang = (Astro.props.lang as "en" | "fr") || "en";
const i18n = createI18n(lang);
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);
---
<BaseLayout
  title={i18n.t('agents.title')}
  description={t(
    `Connect an AI chatbot to Quill's public-sector data tools. One MCP config, ${statsData.tools} tools, and broad platform support. Source coverage and terms vary.`,
    `Connectez un chatbot IA aux outils de données du secteur public de Quill. Une configuration MCP, ${statsData.tools} outils et une large prise en charge des plateformes. La couverture et les conditions varient selon la source.`,
  )}
  ogImage="/og-image-agents.png"
  lang={lang}
>
  <!-- Hero -->
  <section class="aurora relative overflow-hidden border-b py-16 md:py-24">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          {t("Connect your AI to", "Connectez votre IA à")}<br /><span class="text-gradient">Quill</span>
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
          {t(
            `One config file connects your AI chatbot — Claude, ChatGPT, Gemini, Grok, Cursor, Windsurf, Codebuff, OpenCode, Hermes, OpenClaw, LM Studio, or any MCP-compatible tool — to ${statsData.tools} Quill tools for searching public-sector sources, including committees, lobbying, court decisions, regulations, and budgets. Coverage and source terms vary.`,
            `Un seul fichier de configuration connecte votre chatbot IA — Claude, ChatGPT, Gemini, Grok, Cursor, Windsurf, Codebuff, OpenCode, Hermes, OpenClaw, LM Studio ou tout outil compatible MCP — aux ${statsData.tools} outils de Quill pour rechercher des sources du secteur public, notamment les comités, le lobbying, les décisions judiciaires, les règlements et les budgets. La couverture et les conditions varient selon la source.`,
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- MCP Config Snippet -->
  <section class="py-12 md:py-16 border-b border-border/60 bg-card/20">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h2 class="text-2xl font-bold mb-4">{t("One config snippet. Every AI.", "Un seul extrait de config. Toute IA.")}</h2>
      <p class="text-muted-foreground mb-8">
        {t(
          "Copy this into your AI's MCP settings. All 12 platforms above use the exact same config.",
          "Copiez ceci dans les paramètres MCP de votre IA. Les 12 plateformes ci-dessus utilisent exactement la même config.",
        )}
      </p>
      <Card className="text-left mx-auto border-primary/20 bg-primary/5 mb-6">
        <CardContent className="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
          &#123;<br />
          &nbsp;&nbsp;<span class="text-[#D4A017]">"mcpServers"</span>: &#123;<br />
          &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">"maplespike"</span>: &#123;<br />
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">"command"</span>: <span class="text-[#0891B2]">"npx"</span>,<br />
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">"args"</span>: [<span class="text-[#0891B2]">"@maplespike/mcp"</span>],<br />
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#D4A017]">"env"</span>: &#123; <span class="text-[#D4A017]">"QUILL_API_KEY"</span>: <span class="text-[#0891B2]">"ms_live_..."</span> &#125;<br />
          &nbsp;&nbsp;&nbsp;&nbsp;&#125;<br />
          &nbsp;&nbsp;&#125;<br />
          &#125;
        </CardContent>
      </Card>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={localeUrl('/signup', lang)} class="btn-sheen inline-flex h-11 items-center rounded-full px-7 text-sm font-medium text-primary-foreground">{i18n.t('auth.api_key')} →</a>
        <a href={localeUrl('/docs', lang) + '#mcp-tools'} class="inline-flex h-11 items-center rounded-full border px-7 text-sm font-medium hover:bg-foreground/[0.04] transition-colors">{i18n.t('nav.docs')}</a>
      </div>
    </div>
  </section>

  <!-- MCP setup wizard -->
  <section class="py-12 md:py-16 border-b border-border/60 bg-card/20">
    <div class="container mx-auto px-4 max-w-3xl">
      <McpSetupWizard lang={lang} />
    </div>
  </section>

  <!-- Platform grid -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold tracking-tight mb-2 text-center">{i18n.t('agents.title')}</h2>
      <p class="text-muted-foreground mb-10 text-center">{t("One config for every platform", "Une config pour chaque plateforme")}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 max-w-6xl mx-auto">
        {platforms.map((p) => (
          <Card className="card-hover flex flex-col border-border/60">
            <CardHeader className="p-4 pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl" aria-hidden="true">{p.icon}</span>
                <CardTitle className="text-base">{p.name}</CardTitle>
              </div>
              <CardDescription className="text-xs mt-2 leading-relaxed">{tb(p.description)}</CardDescription>
            </CardHeader>
            <CardContent className="p-4 pt-0 mt-auto">
              <Badge variant="secondary" className="text-xs font-mono">{p.setup}</Badge>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="aurora relative overflow-hidden border-t py-16 md:py-20">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl mb-4">
        {t("Your AI is one line away from understanding Canada", "Votre IA est à une ligne de comprendre le Canada")}
      </h2>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        {t(
          `The free tier includes access to ${statsData.tools} MCP tools. No credit card required. Connect to Quill's public-sector search tools in under 60 seconds; source coverage and terms vary.`,
          `Le forfait gratuit comprend l'accès à ${statsData.tools} outils MCP. Sans carte de crédit. Connectez-vous aux outils de recherche du secteur public de Quill en moins de 60 secondes; la couverture et les conditions varient selon la source.`,
          
        )}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={localeUrl('/signup', lang)} class="btn-sheen inline-flex h-12 items-center rounded-full px-8 text-base font-medium text-primary-foreground">{i18n.t('billing.cta.get_started')}</a>
        <a href={localeUrl('/docs', lang) + '#mcp-tools'} class="inline-flex h-12 items-center rounded-full border px-8 text-base font-medium hover:bg-foreground/[0.04] transition-colors">{i18n.t('nav.docs')}</a>
        <a href={localeUrl('/ask', lang)} class="inline-flex h-12 items-center rounded-full border px-8 text-base font-medium hover:bg-foreground/[0.04] transition-colors">{i18n.t('ask.title')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
