---
interface Props {
  page: string;
  lang?: "en" | "fr";
}
const { page, lang = "en" } = Astro.props;
const t = (en: string, fr: string) => lang === "fr" ? fr : en;
const issueUrl = `https://github.com/maplespike/quill/issues/new?template=bug_report.md&title=${encodeURIComponent('Data issue: ' + page)}&labels=data-quality`;
---
<a href={issueUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground transition-colors">
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
  {t("Report an issue", "Signaler un problème")}
</a>