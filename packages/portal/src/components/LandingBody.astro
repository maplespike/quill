---
// Shared landing page body — used by / (index.astro) and /[locale].astro
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { localeUrl } from "@/utils/localeUrl";
import { pick, pickBi, type Bi } from "@/utils/bilingual";
import statsData from "@/data/stats.json";

const lang = (Astro.props.lang as "en" | "fr") || "en";
const t = (en: string, fr: string) => pick(lang, en, fr);
const tb = (bi: Bi) => pickBi(lang, bi);

// Stats — single source: src/data/stats.json (generated by
// scripts/generate-plans.mjs from the live MCP tool count + pipeline-core
// module registry). NEVER hardcode module/tool counts here.
const stats = [
  { value: String(statsData.modules), label: { en: "Data modules", fr: "Modules de données" } as Bi },
  { value: String(statsData.tools), label: { en: "MCP tools", fr: "Outils MCP" } as Bi },
  { value: String(statsData.jurisdictions), label: { en: "Jurisdictions", fr: "Juridictions" } as Bi },
  { value: statsData.linesOfTs, label: { en: "Lines of TS", fr: "Lignes de TS" } as Bi },
];

const categories: { title: Bi; items: Bi[] }[] = [
  {
    title: { en: "Federal Core", fr: "Noyau fédéral" },
    items: [
      { en: "IRCC immigration", fr: "Immigration IRCC" },
      { en: "StatCan WDS", fr: "StatCan WDS" },
      { en: "Health Canada", fr: "Santé Canada" },
      { en: "CRA Charity registry", fr: "Registre des organismes de bienfaisance de l'ARC" },
      { en: "Federal Budget", fr: "Budget fédéral" },
      { en: "Proactive Disclosure", fr: "Divulgation proactive" },
      { en: "ATI", fr: "AIPRP" },
      { en: "NPRI + Species at Risk", fr: "INRP + Espèces en péril" },
      { en: "CIPO + CMHC", fr: "OPIC + SCHL" },
    ],
  },
  {
    title: { en: "Parliament", fr: "Parlement" },
    items: [
      { en: "House committees", fr: "Comités de la Chambre" },
      { en: "Senate committees", fr: "Comités du Sénat" },
      { en: "Hansard transcripts", fr: "Transcriptions du hansard" },
      { en: "Canada Gazette I / II / III", fr: "Gazette du Canada I / II / III" },
      { en: "LEGISinfo", fr: "LEGISinfo" },
      { en: "GIC appointments", fr: "Nominations du gouverneur en conseil" },
    ],
  },
  {
    title: { en: "Oversight", fr: "Surveillance" },
    items: [
      { en: "OAG · PBO", fr: "BVG · DPO" },
      { en: "Ethics Commissioner", fr: "Commissaire à l'éthique" },
      { en: "Lobbying Commissioner", fr: "Commissaire au lobbying" },
      { en: "Competition Bureau", fr: "Bureau de la concurrence" },
      { en: "CRTC", fr: "CRTC" },
      { en: "Privacy Commissioner", fr: "Commissaire à la protection de la vie privée" },
      { en: "OSFI · FCAC · FINTRAC", fr: "BSIF · ACFC · CANAFE" },
    ],
  },
  {
    title: { en: "Corporate + Influence", fr: "Entreprises + influence" },
    items: [
      { en: "Lobbying Registry (1996→)", fr: "Registre du lobbying (1996→)" },
      { en: "CanadaBuys procurement", fr: "Achats Canada" },
      { en: "SEDI insider trades", fr: "Transactions d'initiés SEDI" },
      { en: "SEDAR+ filings", fr: "Dépôts SEDAR+" },
      { en: "Corporations Canada", fr: "Corporations Canada" },
      { en: "31 NGO / think tank RSS feeds", fr: "31 fils RSS d'ONG / groupes de réflexion" },
    ],
  },
  {
    title: { en: "Provincial + Municipal", fr: "Provincial + municipal" },
    items: [
      { en: "All 13 legislatures", fr: "Les 13 assemblées législatives" },
      { en: "13 CKAN portals", fr: "13 portails CKAN" },
      { en: "273 regulators across 21 categories", fr: "273 organismes de réglementation dans 21 catégories" },
      { en: "19 cities (direct)", fr: "19 villes (direct)" },
      { en: "3,490+ via CKAN federation", fr: "3 490+ via la fédération CKAN" },
    ],
  },
  {
    title: { en: "Justice + Media", fr: "Justice + médias" },
    items: [
      { en: "CanLII case law", fr: "Jurisprudence CanLII" },
      { en: "A2AJ (116K+ decisions)", fr: "A2AJ (116 000+ décisions)" },
      { en: "Justice Canada legislation", fr: "Législation de Justice Canada" },
      { en: "CRTC market reports", fr: "Rapports de marché du CRTC" },
      { en: "ECCC alerts", fr: "Alertes ECCC" },
      { en: "CBSA wait times", fr: "Délais d'attente de l'ASFC" },
    ],
  },
];

const platforms = [
  { name: "Claude Desktop", icon: "🤖" },
  { name: "ChatGPT", icon: "🧠" },
  { name: "Cursor", icon: "🖊️" },
  { name: "Gemini", icon: "💎" },
  { name: "Grok", icon: "⚡" },
  { name: "LM Studio", icon: "🖥️" },
];

const mcpConfig = `{"mcpServers":{"maplespike":{"url":"https://mcp.maplespike.ca/sse","headers":{"Authorization":"Bearer YOUR_API_KEY"}}}}`;
// One backslash pair in the template literal renders a single `\` — the
// shell line-continuation. Four backslashes (\\ in the literal) render `\\`,
// producing a broken command when visitors copy it.
const curlSnippet = `curl -H "Authorization: Bearer $QUILL_KEY" \\\
  https://quill.maplespike.ca/v1/search?q=lobbying+registrations`;
---

<div class="quill-landing-bg">
  <!-- QuillHero -->
  <section id="quill-hero" class="quill-hero aurora relative overflow-hidden border-b py-20 md:py-28">
    <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-4 max-w-4xl text-center">        <Badge variant="outline" className="mb-6">License declarations under review</Badge>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
        {t("Canadian government data,", "Les données gouvernementales canadiennes,")}
        <br />
        <span class="text-gradient">{t("on tap for any AI.", "à la portée de toute IA.")}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        {t(
          `${statsData.modules} modules across federal, provincial, territorial, and municipal sources. ${statsData.tools} MCP tools. Source terms vary by publisher and dataset. One line of config.`,
          `${statsData.modules} modules issus de sources fédérales, provinciales, territoriales et municipales. ${statsData.tools} outils MCP. Les conditions varient selon l'éditeur et le jeu de données. Une ligne de configuration.`,
        )}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={localeUrl("/signup", lang)} class="press-feedback inline-flex transition-transform duration-[160ms] ease-out">
          <Button asChild size="lg">
            <span>{t("Get your API key", "Obtenez votre clé API")}</span>
          </Button>
        </a>
        <a href="https://github.com/reverb256/quill" target="_blank" rel="noopener noreferrer" class="press-feedback inline-flex transition-transform duration-[160ms] ease-out">
          <Button asChild variant="outline" size="lg">
            <span>{t("Fork on GitHub", "Forker sur GitHub")}</span>
          </Button>
        </a>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">{t("Free while in beta · No credit card required", "Gratuit en version bêta · Sans carte de crédit")}</p>
    </div>
  </section>

  <!-- Stats -->
  <section id="quill-stats" class="border-b py-12">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 gap-px md:grid-cols-4 reveal-on-scroll">
        {stats.map((s) => (
          <div class="px-6 py-4 text-center">
            <div class="text-3xl font-bold tracking-tight text-primary font-mono-num">{s.value}</div>
            <div class="mt-1 text-sm text-muted-foreground">{tb(s.label)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- McpServerBlock -->
  <section id="quill-mcp-server" class="mcp-server-block container mx-auto px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center reveal-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight">
        {t("One line of", "Une ligne de")} <span class="text-gradient">{t("config", "configuration")}</span>
      </h2>
      <p class="mt-3 text-muted-foreground">
        {t(
          "Paste this into your AI chatbot. Works with anything that speaks MCP.",
          "Collez ceci dans votre chatbot IA. Fonctionne avec tout ce qui parle MCP.",
        )}
      </p>
    </div>
    <div class="mx-auto mt-8 max-w-2xl reveal-on-scroll">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center justify-between">
            {t("MCP Server Config", "Configuration du serveur MCP")}
            <Button variant="ghost" size="sm" id="copy-config" className="press-feedback" aria-live="polite" aria-label={t("Copy MCP config", "Copier la configuration MCP")}>{t("Copy", "Copier")}</Button>
          </CardTitle>
          <CardDescription>{t("JSON for Claude Desktop, Cursor, ChatGPT, and more", "JSON pour Claude Desktop, Cursor, ChatGPT, et plus")}</CardDescription>
        </CardHeader>
        <CardContent>
          <pre class="overflow-x-auto rounded-lg bg-muted p-4 text-sm font-mono"><code id="mcp-config-text">{mcpConfig}</code></pre>
        </CardContent>
      </Card>
    </div>

    <!-- Terminal snippet -->
    <div class="mx-auto mt-8 max-w-2xl reveal-on-scroll">
      <div class="rounded-lg border border-border/60 bg-card/40 p-4 font-mono text-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs text-muted-foreground uppercase tracking-wider">{t("REST example", "Exemple REST")}</span>
          <Button variant="ghost" size="sm" id="copy-curl" className="press-feedback" aria-live="polite" aria-label={t("Copy cURL example", "Copier l'exemple cURL")}>{t("Copy", "Copier")}</Button>
        </div>
        <pre class="overflow-x-auto text-muted-foreground"><code id="curl-config-text">{curlSnippet}</code></pre>
      </div>
    </div>

    <!-- Platform grid -->
    <div class="mx-auto mt-12 max-w-3xl reveal-on-scroll">
      <p class="mb-4 text-center text-sm text-muted-foreground">{t("Works with your favorite AI tools", "Fonctionne avec vos outils IA préférés")}</p>
      <div class:list={["grid", "grid-cols-3", "gap-3", "sm:grid-cols-6", "stagger-children"]}>
        {platforms.map((p) => (
          <div class:list={["flex", "flex-col", "items-center", "gap-1", "rounded-lg", "border", "border-border/40", "p-3", "card-hover"]}>
            <span class="text-2xl">{p.icon}</span>
            <span class="text-xs text-muted-foreground">{p.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ToolGrid -->
  <section id="quill-tool-grid" class="tool-grid border-t bg-card/20 py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="mb-10 text-center reveal-on-scroll">
        <h2 class="text-3xl font-bold tracking-tight">
          {t("Every source,", "Chaque source,")} <span class="text-gradient">{t("openly aggregated", "ouvertement agrégée")}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-muted-foreground">
          {t(
            "Records include source provenance and SHA-256 data where available. Check each publisher's terms before reuse.",
            "Les enregistrements incluent la provenance de la source et des données SHA-256 lorsque disponibles. Consultez les conditions de chaque éditeur avant toute réutilisation.",
          )}
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 stagger-children">
        {categories.map((cat) => (
          <Card className="card-hover">
            <CardHeader>
              <CardTitle className="text-base">{tb(cat.title)}</CardTitle>
            </CardHeader>
            <CardContent>
              <ul class="space-y-1.5">
                {cat.items.map((item) => (
                  <li class="flex items-center gap-2 text-sm text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {tb(item)}
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Sovereignty -->
  <section id="quill-sovereignty" class="sovereignty container mx-auto px-4 py-16 md:py-24">
    <div class="grid gap-8 md:grid-cols-3 stagger-children reveal-on-scroll">
      <Card className="card-hover">
        <CardHeader>
          <CardTitle className="text-lg">🔍 {t("Verifiable", "Vérifiable")}</CardTitle>
          <CardDescription>
            {t(
              "Where available, SHA-256 hashes and source metadata support integrity comparisons. Hashes do not establish source authenticity or reuse rights; check the original publisher's terms.",
              "Lorsqu'ils sont disponibles, les hachages SHA-256 et les métadonnées de source permettent des comparaisons d'intégrité. Les hachages n'établissent ni l'authenticité de la source ni les droits de réutilisation; consultez les conditions de l'éditeur d'origine.",
            )}
          </CardDescription>
        </CardHeader>
      </Card>
      <Card className="card-hover">
        <CardHeader>
          <CardTitle className="text-lg">🔧 {t("Self-sovereign", "Auto-souverain")}</CardTitle>
          <CardDescription>
            {t(
              "Runs in your cluster or on your laptop. No managed-service lock-in. Nix builds for full reproducibility end to end.",
              "Tourne dans votre cluster ou sur votre portable. Aucune dépendance à un service géré. Builds Nix pour une reproductibilité complète de bout en bout.",
            )}
          </CardDescription>
        </CardHeader>
      </Card>
      <Card className="card-hover">
        <CardHeader>
          <CardTitle className="text-lg">📜 {t("Open source", "Open source")}</CardTitle>
          <CardDescription>
            {t(
              "Package and file license declarations are under review. Check the repository notices before use or redistribution.",
              "Les déclarations de licence des paquets et fichiers sont en cours de vérification. Consultez les avis du dépôt avant toute utilisation ou redistribution.",
            )}
          </CardDescription>
        </CardHeader>
      </Card>
    </div>
  </section>

  <!-- CTA -->
  <section id="quill-cta" class="aurora border-t py-16 md:py-20">
    <div class="container mx-auto px-4 text-center reveal-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight">
        {t("Start building with", "Commencez à bâtir avec")} <span class="text-gradient">{t("Canadian data", "les données canadiennes")}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-md text-muted-foreground">
        {t("Get your API key in 30 seconds. Free while in beta.", "Obtenez votre clé API en 30 secondes. Gratuit en version bêta.")}
      </p>
      <div class="mt-6">
        <a href={localeUrl("/signup", lang)} class="press-feedback inline-flex transition-transform duration-[160ms] ease-out">
          <Button asChild size="lg">
            <span>{t("Get started free", "Commencer gratuitement")}</span>
          </Button>
        </a>
      </div>
    </div>
  </section>
</div>

<noscript>
  <style>
    .reveal-on-scroll,
    .stagger-children > * {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  </style>
</noscript>

<script>
  // Reveal on scroll via IntersectionObserver
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => revealObserver.observe(el));

  // Copy config button
  const copyBtn = document.getElementById("copy-config");
  const configText = document.getElementById("mcp-config-text");
  const copiedLabel = window.__LANG === "fr" ? "Copié !" : "Copied!";
  if (copyBtn && configText) {
    copyBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(configText.textContent || "");
      const original = copyBtn.textContent;
      copyBtn.textContent = copiedLabel;
      setTimeout(() => { copyBtn.textContent = original; }, 2000);
    });
  }

  // Copy curl button
  const copyCurlBtn = document.getElementById("copy-curl");
  const curlText = document.getElementById("curl-config-text");
  if (copyCurlBtn && curlText) {
    copyCurlBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(curlText.textContent || "");
      const original = copyCurlBtn.textContent;
      copyCurlBtn.textContent = copiedLabel;
      setTimeout(() => { copyCurlBtn.textContent = original; }, 2000);
    });
  }
</script>
