---
import { localeUrl } from "@/utils/localeUrl";
import stats from "@/data/stats.json";
const lang = (Astro.props.lang as "en" | "fr") || "en";
const t = (en: string, fr: string) => lang === "fr" ? fr : en;
const url = (path: string) => localeUrl(path, lang);
const pathways = [
  { n: '01', title: t('Follow the public record.', 'Suivez les dossiers publics.'), text: t('Find government datasets, committee records, and public disclosures in one place.', 'Trouvez des jeux de données, des dossiers de comités et des divulgations publiques au même endroit.'), link: '/explorer', action: t('Explore the data', 'Explorer les données'), tag: t('DISCOVER', 'DÉCOUVRIR') },
  { n: '02', title: t('Ask a better question.', 'Posez une meilleure question.'), text: t('Use Quill’s research tools to ask about policy, connect records, and inspect sources.', 'Utilisez les outils de Quill pour poser des questions sur les politiques, relier les dossiers et examiner les sources.'), link: '/ask', action: t('Open Ask Quill', 'Ouvrir Demander à Quill'), tag: t('RESEARCH', 'CHERCHER') },
  { n: '03', title: t('Bring your own AI.', 'Connectez votre propre IA.'), text: t('Give your AI tools access to Canadian public-sector sources through MCP or the REST API.', 'Donnez à vos outils IA accès aux sources publiques canadiennes par MCP ou par l’API REST.'), link: '/agents', action: t('Connect an agent', 'Connecter un agent'), tag: t('BUILD', 'CRÉER') },
];
const categories = [
  { n: '01', title: t('Federal government', 'Gouvernement fédéral'), text: t('Statistics Canada · public disclosures · immigration', 'Statistique Canada · divulgations publiques · immigration'), query: 'Statistics Canada' },
  { n: '02', title: t('Provinces & territories', 'Provinces et territoires'), text: t('Legislatures · public data portals · regulators', 'Assemblées législatives · portails de données · organismes de réglementation'), query: 'provincial' },
  { n: '03', title: t('Cities & communities', 'Villes et collectivités'), text: t('Municipal datasets · local public records', 'Données municipales · dossiers publics locaux'), query: 'municipal' },
  { n: '04', title: t('Corporate & influence', 'Entreprises et influence'), text: t('Lobbying · procurement · corporate records', 'Lobbying · marchés publics · dossiers d’entreprises'), query: 'lobbying' },
];
const mcpConfig = JSON.stringify({ mcpServers: { quill: { url: 'https://mcp.maplespike.ca/sse', headers: { Authorization: 'Bearer YOUR_API_KEY' } } } }, null, 2);
const curlSnippet = 'curl --get https://api.maplespike.ca/v1/gov/search \\\n  --data-urlencode "q=housing" \\\n  -H "Authorization: Bearer $QUILL_KEY"';
const exampleResponse = JSON.stringify({ data: { sha256: 'sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08', verified: true, source_name: 'House of Commons — Committee Evidence', source_url: 'https://www.ourcommons.ca/Committees/', retrieved_at: '2026-10-01T12:00:00Z' } }, null, 2);
---
<div class="public-record-landing">
  <section class="record-hero page-width" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="editorial-dot" aria-hidden="true"></span>{t('CANADIAN PUBLIC DATA. CONNECTED.', 'LES DONNÉES PUBLIQUES CANADIENNES. RELIÉES.')}</p>
      <h1 id="hero-title">{t('The public record.', 'Les dossiers publics.')}<br /><em>{t('An open possibility.', 'Un monde de possibles.')}</em></h1>
      <p class="hero-description">{t('Find the source. Follow the story. Build something that matters. Quill connects Canada’s public-sector data to you and your AI tools.', 'Trouvez la source. Suivez l’histoire. Créez quelque chose d’utile. Quill relie les données du secteur public canadien à vous et à vos outils IA.')}</p>
      <form class="hero-search relative" action={url('/explorer')} method="GET" role="search">
        <label class="sr-only" for="landing-query">{t('Search public data', 'Rechercher des données publiques')}</label>
        <span aria-hidden="true" class="search-symbol">⌕</span>
        <input id="landing-query" name="query" type="search" required placeholder={t('What are you looking into?', 'Quel sujet vous intéresse ?')} autocomplete="off" />
        <button type="submit" aria-label={t('Search public data', 'Rechercher des données publiques')}><span aria-hidden="true">↗</span></button>
        <ul id="landing-suggestions" class="absolute left-0 right-0 top-full z-20 mt-2 hidden max-h-60 overflow-auto rounded-md border border-border bg-background shadow-lg" role="listbox" aria-label={t('Search suggestions', 'Suggestions de recherche')}></ul>
      </form>
      <div class="hero-suggestions"><span>{t('START WITH', 'ESSAYEZ')}</span>{['housing', 'lobbying', 'procurement'].map((query, index) => <a href={`${url('/explorer')}?query=${query}`}>{[t('Housing', 'Logement'), t('Lobbying', 'Lobbying'), t('Procurement', 'Marchés publics')][index]}</a>)}</div>
      <div class="hero-links"><a class="text-link" href={url('/agents')}>{t('Connect your AI', 'Connecter votre IA')} <span aria-hidden="true">↗</span></a><span class="hero-link-note">{t('MCP + REST API', 'MCP + API REST')}</span></div>
    </div>
    <figure class="hero-art">
      <div class="art-kicker"><span>QUILL / {t('FIELD NOTES', 'NOTES DE TERRAIN')}</span><span aria-hidden="true">↗</span></div>
      <img src="/assets/public-record.webp" width="960" height="960" alt="" fetchpriority="high" />
      <figcaption><span>{t('A new perspective on the public record.', 'Un autre regard sur les dossiers publics.')}</span><span class="art-edition">№ 001</span></figcaption>
      <span class="art-disclosure">{t('AI-generated illustration · not a map or dataset', 'Illustration générée par IA · ni carte ni jeu de données')}</span>
    </figure>
  </section>

  <section class="page-width onboarding-section" aria-labelledby="onboarding-title">
    <div class="section-heading"><div><p class="eyebrow">{t('GET STARTED', 'DÉMARRER')}</p><h2 id="onboarding-title">{t('From key to first answer in three steps.', 'De la clé à la première réponse en trois étapes.')}</h2></div><p>{t('Get a free key, make one call, and connect your AI. No credit card required.', 'Obtenez une clé gratuite, faites un appel, connectez votre IA. Aucune carte de crédit requise.')}</p></div>
    <p class="onboarding-summary text-sm text-muted-foreground mb-6">{t('1. Get your free key → 2. Make your first call (copy-paste curl) → 3. Connect your AI (MCP config)', '1. Obtenez votre clé gratuite → 2. Faites votre premier appel (curl à copier-coller) → 3. Connectez votre IA (config MCP)')}</p>
    <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <li class="rounded-xl border border-border/60 bg-card/40 p-5">
        <div class="flex items-center gap-2 mb-3"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--maple)] text-primary-foreground text-sm font-semibold">1</span><h3 class="text-base font-semibold">{t('Get your free key', 'Obtenez votre clé gratuite')}</h3></div>
        <p class="text-sm text-muted-foreground mb-4">{t('Create a free account and copy your API key.', 'Créez un compte gratuit et copiez votre clé API.')}</p>
        <a href={url('/signup')} class="quill-button light-button inline-flex">{t('Get your API key', 'Obtenir votre clé API')} <span aria-hidden="true">↗</span></a>
      </li>
      <li class="rounded-xl border border-border/60 bg-card/40 p-5">
        <div class="flex items-center gap-2 mb-3"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--maple)] text-primary-foreground text-sm font-semibold">2</span><h3 class="text-base font-semibold">{t('Make your first call (copy-paste curl)', 'Faites votre premier appel (curl à copier-coller)')}</h3></div>
        <p class="text-sm text-muted-foreground mb-4">{t('Paste this curl into your terminal.', 'Collez ce curl dans votre terminal.')}</p>
        <div class="console-code"><div class="code-toolbar"><span>terminal</span><button type="button" data-copy-target="onboarding-curl-text" data-copy-label={t('Copy', 'Copier')} data-copied-label={t('Copied', 'Copié')} data-error-label={t('Copy failed — select the code', 'Échec — sélectionnez le code')} aria-label={t('Copy REST example', 'Copier l’exemple REST')}>{t('Copy', 'Copier')}</button></div><pre><code id="onboarding-curl-text">{curlSnippet}</code></pre></div>
      </li>
      <li class="rounded-xl border border-border/60 bg-card/40 p-5">
        <div class="flex items-center gap-2 mb-3"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--maple)] text-primary-foreground text-sm font-semibold">3</span><h3 class="text-base font-semibold">{t('Connect your AI (MCP config)', 'Connectez votre IA (config MCP)')}</h3></div>
        <p class="text-sm text-muted-foreground mb-4">{t('Add this to your MCP client config.', 'Ajoutez ceci à la config de votre client MCP.')}</p>
        <div class="console-code"><div class="code-toolbar"><span>mcp.json</span><button type="button" data-copy-target="onboarding-mcp-text" data-copy-label={t('Copy', 'Copier')} data-copied-label={t('Copied', 'Copié')} data-error-label={t('Copy failed — select the code', 'Échec — sélectionnez le code')} aria-label={t('Copy MCP configuration', 'Copier la configuration MCP')}>{t('Copy', 'Copier')}</button></div><pre><code id="onboarding-mcp-text">{mcpConfig}</code></pre></div>
      </li>
    </ol>
    <div class="mt-6 rounded-xl border border-border/60 bg-card/40 p-5">
      <p class="eyebrow mb-2">{t('LIVE EXAMPLE RESPONSE', 'EXEMPLE DE RÉPONSE EN DIRECT')}</p>
      <pre class="overflow-x-auto rounded-md bg-muted p-3 text-xs"><code>{exampleResponse}</code></pre>
    </div>
  </section>

  <section class="coverage-band" aria-label={t('Platform coverage', 'Couverture de la plateforme')}>
    <div class="page-width coverage-inner"><p>{t('A country of sources.', 'Un pays de sources.')}<br /><em>{t('One place to start.', 'Un point de départ.')}</em></p>
      <dl><div><dt>{t('Data modules', 'Modules de données')}</dt><dd>{stats.modules}</dd></div><div><dt>{t('MCP tools', 'Outils MCP')}</dt><dd>{stats.tools}</dd></div><div><dt>{t('Jurisdictions', 'Juridictions')}</dt><dd>{stats.jurisdictions}</dd></div></dl>
    </div>
  </section>

  <section class="page-width editorial-section" aria-labelledby="pathways-title">
    <div class="section-heading"><div><p class="eyebrow">{t('MADE FOR THE CURIOUS', 'POUR LES ESPRITS CURIEUX')}</p><h2 id="pathways-title">{t('Less searching. More understanding.', 'Moins de recherches. Plus de clarté.')}</h2></div><p>{t('For the journalist with a lead. The researcher with a question. The developer with an idea.', 'Pour le journaliste qui suit une piste. Pour le chercheur qui pose une question. Pour le développeur qui a une idée.')}</p></div>
    <div class="research-pathways">{pathways.map(path => <a href={url(path.link)} class="pathway"><div class="pathway-meta"><span>{path.n}</span><span>{path.tag}</span></div><h3>{path.title}</h3><p>{path.text}</p><span class="pathway-action">{path.action}<span aria-hidden="true">↗</span></span></a>)}</div>
  </section>

  <section class="source-section" aria-labelledby="sources-title"><div class="page-width source-layout">
    <div class="source-intro"><p class="eyebrow">{t('THE SOURCE DIRECTORY', 'LE RÉPERTOIRE DES SOURCES')}</p><h2 id="sources-title">{t('Across Canada.', 'Partout au Canada.')}<br /><em>{t('Beyond the silos.', 'Au-delà des silos.')}</em></h2><p>{t('Federal to municipal. Policy to procurement. Start with a source, then see where the record takes you.', 'Du fédéral au municipal. Des politiques aux marchés publics. Commencez par une source, puis suivez les dossiers.')}</p><a class="text-link" href={url('/data-sources')}>{t('Sources & licence terms', 'Sources et conditions de licence')}<span aria-hidden="true">↗</span></a></div>
    <div class="source-directory">{categories.map(category => <a href={`${url('/explorer')}?query=${encodeURIComponent(category.query)}`}><span class="source-number">{category.n}</span><div><h3>{category.title}</h3><p>{category.text}</p></div><span class="source-arrow" aria-hidden="true">↗</span></a>)}</div>
  </div></section>

  <section class="page-width editorial-section provenance-section" aria-labelledby="provenance-title">
    <div><p class="eyebrow">{t('EVIDENCE, NOT JUST ANSWERS', 'DES PREUVES, PAS SEULEMENT DES RÉPONSES')}</p><h2 id="provenance-title">{t('Keep the source', 'Gardez la source')}<br /><em>{t('in the picture.', 'en vue.')}</em></h2><p>{t('A useful answer is only the beginning. Inspect available source metadata, follow publisher links, and compare record integrity where hashes are available.', 'Une réponse utile n’est que le début. Examinez les métadonnées disponibles, consultez les liens des éditeurs et comparez l’intégrité des dossiers lorsque des hachages sont disponibles.')}</p><a class="text-link" href={url('/verify')}>{t('Explore record verification', 'Explorer la vérification des dossiers')}<span aria-hidden="true">↗</span></a></div>
    <div class="evidence-note"><div class="evidence-heading"><span>{t('THE PROVENANCE PRINCIPLE', 'LE PRINCIPE DE PROVENANCE')}</span><span aria-hidden="true">↗</span></div><ol><li><span>01</span><div><h3>{t('Start at the source.', 'Commencez à la source.')}</h3><p>{t('Check the original publisher and the context of the record.', 'Vérifiez l’éditeur original et le contexte du dossier.')}</p></div></li><li><span>02</span><div><h3>{t('Inspect the evidence.', 'Examinez les preuves.')}</h3><p>{t('Metadata and hashes vary by source and record.', 'Les métadonnées et les hachages varient selon la source et le dossier.')}</p></div></li><li><span>03</span><div><h3>{t('Know the limits.', 'Connaissez les limites.')}</h3><p>{t('A hash checks integrity, not authenticity or reuse rights. Source terms still apply.', 'Un hachage vérifie l’intégrité, pas l’authenticité ni les droits de réutilisation. Les conditions de la source s’appliquent.')}</p></div></li></ol></div>
  </section>

  <section class="integration-section" id="connect" aria-labelledby="connect-title"><div class="page-width integration-layout">
    <div><p class="eyebrow">{t('FOR YOUR NEXT BUILD', 'POUR VOTRE PROCHAIN PROJET')}</p><h2 id="connect-title">{t('Your tools.', 'Vos outils.')}<br /><em>{t('A wider perspective.', 'Une perspective élargie.')}</em></h2><p>{t('Connect an MCP-compatible client or call the REST API. Bring Canadian public-sector sources into the way you already work.', 'Connectez un client compatible MCP ou utilisez l’API REST. Intégrez les sources du secteur public canadien à vos outils habituels.')}</p><a href={url('/signup')} class="quill-button light-button">{t('Get your API key', 'Obtenir votre clé API')} <span aria-hidden="true">↗</span></a><a class="integration-docs" href={url('/docs')}>{t('Read the setup guide', 'Lire le guide de configuration')} →</a><p class="integration-note">{t('Client support varies. Check the setup guide for your tool.', 'La compatibilité varie selon le client. Consultez le guide de votre outil.')}</p></div>
    <div class="integration-console">
      <div class="console-header"><span>{t('CONNECTION DESK', 'BUREAU DE CONNEXION')}</span><span aria-hidden="true">{`{ }`}</span></div>
      <details open><summary>{t('MCP server configuration', 'Configuration du serveur MCP')}<span>MCP</span></summary><div class="console-code"><div class="code-toolbar"><span>mcp.json</span><button type="button" data-copy-target="mcp-config-text" data-copy-label={t('Copy', 'Copier')} data-copied-label={t('Copied', 'Copié')} data-error-label={t('Copy failed — select the code', 'Échec — sélectionnez le code')} aria-label={t('Copy MCP configuration', 'Copier la configuration MCP')}>{t('Copy', 'Copier')}</button></div><pre><code id="mcp-config-text">{mcpConfig}</code></pre></div></details>
      <details><summary>{t('Make a REST request', 'Faire une requête REST')}<span>REST</span></summary><div class="console-code"><div class="code-toolbar"><span>terminal</span><button type="button" data-copy-target="curl-config-text" data-copy-label={t('Copy', 'Copier')} data-copied-label={t('Copied', 'Copié')} data-error-label={t('Copy failed — select the code', 'Échec — sélectionnez le code')} aria-label={t('Copy REST example', 'Copier l’exemple REST')}>{t('Copy', 'Copier')}</button></div><pre><code id="curl-config-text">{curlSnippet}</code></pre></div></details>
      <p class="copy-status" role="status" aria-live="polite"></p>
      <div class="console-footnote">{t('Replace YOUR_API_KEY with your Quill key. Never publish it.', 'Remplacez YOUR_API_KEY par votre clé Quill. Ne la publiez jamais.')}</div>
    </div>
  </div></section>

  <section class="page-width closing-section"><p class="eyebrow">{t('THE NEXT QUESTION IS YOURS', 'LA PROCHAINE QUESTION VOUS APPARTIENT')}</p><h2>{t('There’s more to the story.', 'L’histoire ne s’arrête pas là.')}</h2><a class="quill-button" href={url('/explorer')}>{t('Open the data explorer', 'Ouvrir l’explorateur')}<span aria-hidden="true">↗</span></a><p class="licence-note">{t('Source terms vary by publisher and dataset. Package and file licence declarations are under review.', 'Les conditions varient selon l’éditeur et le jeu de données. Les déclarations de licence des paquets et fichiers sont en cours de vérification.')} <a href={url('/data-sources')}>{t('Read the notices.', 'Lire les avis.')}</a></p></section>
</div>
<script>
  function setupCopyControls() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach(button => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        const code = document.getElementById(button.dataset.copyTarget || '');
        const status = button.closest('.integration-console')?.querySelector<HTMLElement>('[role="status"]');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          button.textContent = button.dataset.copiedLabel || 'Copied';
          if (status) status.textContent = button.dataset.copiedLabel || 'Copied';
        } catch {
          if (status) status.textContent = button.dataset.errorLabel || 'Copy failed — select the code';
        }
        setTimeout(() => { button.textContent = button.dataset.copyLabel || 'Copy'; }, 2000);
      });
    });
  }
  setupCopyControls();
  document.addEventListener('astro:page-load', setupCopyControls);
</script>
<script is:inline>
  (function () {
    var KEY = 'quill-recent-searches';
    var DEFAULTS = ['housing', 'lobbying', 'procurement'];
    function readRecent() {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; }
    }
    function saveRecent(q) {
      if (!q) return;
      try {
        var list = readRecent().filter(function (x) { return x !== q; });
        list.unshift(q);
        localStorage.setItem(KEY, JSON.stringify(list.slice(0, 8)));
      } catch (e) {}
    }
    function renderSuggestions(input, listEl) {
      var q = (input.value || '').toLowerCase().trim();
      var recent = readRecent();
      var pool = q ? recent.filter(function (x) { return String(x).toLowerCase().indexOf(q) !== -1; }) : recent;
      var extras = DEFAULTS.filter(function (x) { return pool.indexOf(x) === -1 && (q ? x.toLowerCase().indexOf(q) !== -1 : true); });
      var items = pool.concat(extras).slice(0, 8);
      listEl.innerHTML = '';
      if (items.length === 0) { listEl.classList.add('hidden'); return; }
      items.forEach(function (item) {
        var li = document.createElement('li');
        li.className = 'cursor-pointer px-3 py-2 text-sm hover:bg-muted/60';
        li.setAttribute('role', 'option');
        li.textContent = item;
        li.addEventListener('mousedown', function (e) { e.preventDefault(); input.value = item; listEl.classList.add('hidden'); });
        listEl.appendChild(li);
      });
      listEl.classList.remove('hidden');
    }
    function init() {
      var input = document.getElementById('landing-query');
      var listEl = document.getElementById('landing-suggestions');
      if (!input || !listEl || input.dataset.suggestBound) return;
      input.dataset.suggestBound = 'true';
      input.addEventListener('focus', function () { renderSuggestions(input, listEl); });
      input.addEventListener('input', function () { renderSuggestions(input, listEl); });
      input.addEventListener('blur', function () { setTimeout(function () { listEl.classList.add('hidden'); }, 150); });
      var form = input.closest('form');
      if (form) form.addEventListener('submit', function () { saveRecent(input.value.trim()); });
    }
    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
