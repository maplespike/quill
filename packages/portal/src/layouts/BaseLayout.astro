---
import "@/styles/globals.css";
import { ViewTransitions } from "astro:transitions";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: "en" | "fr";
}

const {
  title,
  description = "MapleSpike \u2014 Canada\u2019s Government Data Intelligence Layer",
  ogImage = "/assets/og-image.png",
  lang = "en",
} = Astro.props;
const langPrefix = lang === "fr" ? "/fr" : "";
const canonical = `${Astro.site?.href ?? "https://maplespike.ca"}${langPrefix}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | MapleSpike</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={canonical} hreflang={lang === "fr" ? "fr" : "en"} />
    <link
      rel="alternate"
      href={`https://maplespike.ca${lang === "fr" ? "" : "/fr"}${Astro.url.pathname}`}
      hreflang={lang === "fr" ? "en" : "fr"}
    />
    <meta property="og:title" content={`${title} | MapleSpike`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/assets/maplespike_logo.svg" />
    <ViewTransitions />
    <style is:global>
      html { view-transition-name: none; }
      ::view-transition-old(root) { animation: 100ms ease-out both fadeOut; }
      ::view-transition-new(root) { animation: 100ms ease-out both fadeIn; }
      @keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
      @keyframes fadeOut { from { opacity: 1 } to { opacity: 0 } }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem("data-theme") || "dark";
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") document.documentElement.classList.add("dark");
        else document.documentElement.classList.remove("dark");
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">

    <!-- Navigation -->
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="container mx-auto flex h-16 items-center justify-between px-4">
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/maplespike_logo.svg" alt="MapleSpike" class="h-8 w-8" />
          <span class="text-xl font-bold">MapleSpike</span>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Home</a
          >
          <a
            href="/explorer"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Explore</a
          >
          <a
            href="/dashboard"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Dashboard</a
            >
            <a
            href="/owasp"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >OWASP</a
            >
            <a
            href="/pricing"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Pricing</a
          >
          <a
            href="/docs"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Docs</a
          >
          <a
            href="/blog"
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            >Blog</a
          >
        </nav>
        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-3 hover:bg-accent hover:text-accent-foreground transition-colors"
            aria-label="Toggle theme"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="dark:hidden"
            ><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden dark:block"
            ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
          </button>
          <a
            href="/signup"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
            >Get Started</a
          >
          <button
            id="mobile-menu-toggle"
            class="md:hidden inline-flex items-center justify-center rounded-md h-9 w-9 hover:bg-accent transition-colors"
            aria-label="Menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
          </button>
        </div>
      </div>
      <!-- Mobile nav -->
      <div id="mobile-nav" class="md:hidden hidden border-t bg-background px-4 py-4">
        <nav class="flex flex-col gap-3">
          <a href="/" class="text-sm font-medium text-muted-foreground hover:text-foreground">Home</a>
          <a href="/explorer" class="text-sm font-medium text-muted-foreground hover:text-foreground">Explore</a>
          <a href="/dashboard" class="text-sm font-medium text-muted-foreground hover:text-foreground">Dashboard</a>
 <a href="/owasp" class="text-sm font-medium text-muted-foreground hover:text-foreground">OWASP</a>
 <a href="/pricing" class="text-sm font-medium text-muted-foreground hover:text-foreground">Pricing</a>
          <a href="/docs" class="text-sm font-medium text-muted-foreground hover:text-foreground">Docs</a>
          <a href="/blog" class="text-sm font-medium text-muted-foreground hover:text-foreground">Blog</a>
        </nav>
      </div>
    </header>

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t py-8 md:py-12">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <h3 class="font-semibold mb-3">Product</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li><a href="/owasp" class="hover:text-foreground transition-colors">OWASP</a></li>
 <li><a href="/pricing" class="hover:text-foreground transition-colors">Pricing</a></li>
              <li><a href="/docs" class="hover:text-foreground transition-colors">Documentation</a></li>
              <li><a href="/changelog" class="hover:text-foreground transition-colors">Changelog</a></li>
              <li><a href="/api-explorer" class="hover:text-foreground transition-colors">API Explorer</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold mb-3">Data</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li><a href="/explorer" class="hover:text-foreground transition-colors">Data Explorer</a></li>
              <li><a href="/dashboard" class="hover:text-foreground transition-colors">Dashboard</a></li>
 <li><a href="/owasp" class="hover:text-foreground transition-colors">OWASP</a></li>
              <li><a href="/signal" class="hover:text-foreground transition-colors">Signals</a></li>
              <li><a href="/watcher" class="hover:text-foreground transition-colors">Watcher</a></li>
              <li><a href="/agents" class="hover:text-foreground transition-colors">AI Agents</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold mb-3">Company</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li><a href="/blog" class="hover:text-foreground transition-colors">Blog</a></li>
              <li><a href="/contact" class="hover:text-foreground transition-colors">Contact</a></li>
              <li><a href="/citation" class="hover:text-foreground transition-colors">Citations</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold mb-3">Legal</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li><a href="/llms.txt" class="hover:text-foreground transition-colors">llms.txt</a></li>
              <li><a href="/llms-full.txt" class="hover:text-foreground transition-colors">llms-full.txt</a></li>
              <li><a href="/robots.txt" class="hover:text-foreground transition-colors">robots.txt</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t text-center text-sm text-muted-foreground">
          <p>&copy; {new Date().getFullYear()} MapleSpike. All rights reserved.</p>
          <p class="mt-1">Contains information licensed under the Open Government Licence \u2013 Canada.</p>
        </div>
      </div>
    </footer>

    <script>
      // Theme toggle
      const themeToggle = document.getElementById("theme-toggle");
      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const html = document.documentElement;
          const current = html.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          html.setAttribute("data-theme", next);
          html.classList.toggle("dark", next === "dark");
          localStorage.setItem("data-theme", next);
        });
      }

      // Mobile menu toggle
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const mobileNav = document.getElementById("mobile-nav");
      if (mobileToggle && mobileNav) {
        mobileToggle.addEventListener("click", () => {
          mobileNav.classList.toggle("hidden");
        });
      }
    </script>

    <!-- Load api-bridge.mjs for pages that need it -->
    <script src="/api-bridge.mjs" type="module" is:inline></script>
    <script src="/script.js" is:inline></script>
  </body>
</html>
