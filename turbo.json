{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["SKIP_NETWORK_TESTS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "agents.json", "v1/**", "assets/**", "public/llms.txt", "public/llms-full.txt", "public/data/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
