# Build artifacts — rebuilt inside container
**/dist/
# The portal image (Dockerfile.portal) copies the PRE-BUILT Astro dist
# (packages/portal/dist), so it must NOT be excluded from the build context.
!packages/portal/dist/
**/.next/
**/*.tsbuildinfo

# Host dependencies — installed inside container via pnpm
**/node_modules/

# Version control
.git/

# Environment files
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Nix
result
result-*
