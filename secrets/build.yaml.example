# Quill — build-time secrets (decrypted on dev workstations + CI)
#
# Copy this file to secrets/build.yaml, fill in real values, then:
#   SOPS_AGE_KEY_FILE=/etc/nixos/.age/key.txt \
#     sops --encrypt --in-place secrets/build.yaml
#
# Consumed by:
#   - scripts/deploy.sh (docker registry credentials)
#   - .github/workflows/deploy-dev.yml (CLOUDFLARE_API_TOKEN for pages deploy)

CLOUDFLARE_API_TOKEN: ""
CLOUDFLARE_ACCOUNT_ID: ""
