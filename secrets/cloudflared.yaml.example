# Quill — Cloudflare Tunnel credentials (decrypted at both build + runtime)
#
# Copy this file to secrets/cloudflared.yaml, fill in real values, then:
#   SOPS_AGE_KEY_FILE=~/.config/sops/age/cluster-age-key.txt \
#     sops --encrypt --in-place secrets/cloudflared.yaml
# (encrypts to every recipient in .sops.yaml's creation_rules)
#
# Consumed by:
#   - K8s Secret cloudflared-creds (credentials.json for tunnel pod)
#   - sops-sync-k8s.sh constructs credentials.json from TUNNEL_ID/ACCOUNT_TAG/SECRET
#   - TUNNEL_TOKEN is the base64-encoded JWT for the token-based auth alternative
#
# Get values from: cloudflared tunnel token <tunnel-uuid>
# Or from ~/.cloudflared/<tunnel-uuid>.json

TUNNEL_ID: "cec1b070-796f-4524-b43e-9b05c32af906"
TUNNEL_ACCOUNT_TAG: ""
TUNNEL_SECRET: ""
TUNNEL_TOKEN: ""
