# Quill — runtime secrets (decrypted by sops-nix on nexus at boot)
#
# Copy this file to secrets/runtime.yaml, fill in real values, then:
#   SOPS_AGE_KEY_FILE=/etc/nixos/.age/nexus-prod-key.txt \
#     sops --encrypt --in-place secrets/runtime.yaml
#
# Consumed by:
#   - K8s Secret maplespike-secrets (JWT_SECRET, QUILL_BILLING_SECRET)
#   - K8s Secret postgres-secret (POSTGRES_PASSWORD)
#   - K8s Secret cloudflared-creds (TUNNEL_TOKEN — see cloudflared.yaml)
#   - api-server config.ts (QUILL_GATEWAY_API_KEY)
#   - quill-mcp index.ts (ASTRAL_KEY_URL)

JWT_SECRET: "change-me-to-a-secure-random-value"
QUILL_BILLING_SECRET: "change-me-to-a-secure-random-value"
POSTGRES_PASSWORD: "change-me-to-a-secure-random-value"
QUILL_GATEWAY_API_KEY: ""
ASTRAL_KEY_URL: "http://astral-key.astral-key.svc.cluster.local:8080"
MAPLESPIKE_BILLING_EMAIL: "billing@maplespike.ca"
