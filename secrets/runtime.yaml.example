# Quill — runtime secrets (decrypted by sops-nix on nexus at boot)
#
# Copy this file to secrets/runtime.yaml, fill in real values, then:
#   SOPS_AGE_KEY_FILE=/etc/nixos/.age/nexus-prod-key.txt \
#     sops --encrypt --in-place secrets/runtime.yaml
#
# Consumed by:
#   - K8s Secret maplespike-secrets (JWT_SECRET, QUILL_BILLING_SECRET, QUILL_PII_HASH_SECRET)
#   - K8s Secret postgres-secret (POSTGRES_PASSWORD)
#   - api-server config.ts (QUILL_GATEWAY_API_KEY)
#   - quill-mcp index.ts (ASTRAL_KEY_URL)
#
# #825 DRY (secret-key ownership):
#   runtime.yaml = JWT_SECRET, QUILL_BILLING_SECRET, POSTGRES_PASSWORD,
#                 QUILL_GATEWAY_API_KEY, ASTRAL_KEY_URL, MAPLESPIKE_BILLING_EMAIL
#   billing.yaml = ALL Stripe keys (STRIPE_*)
#   cloudflared.yaml = TUNNEL_* (cloudflared-creds)
# No key may appear in more than one file — see scripts/check-secret-keys-disjoint.sh
# (CI enforces this).

JWT_SECRET: "change-me-to-a-secure-random-value"
QUILL_BILLING_SECRET: "change-me-to-a-secure-random-value"
POSTGRES_PASSWORD: "change-me-to-a-secure-random-value"
QUILL_GATEWAY_API_KEY: ""
ASTRAL_KEY_URL: "http://astral-key.astral-key.svc.cluster.local:8080"
MAPLESPIKE_BILLING_EMAIL: "billing@maplespike.ca"

# ── PII hashing (REQUIRED in production — Decision 0002) ──────────────────
# A stable 64-char hex secret. The api-server refuses POST /v1/register
# without it. Generate: openssl rand -hex 32
QUILL_PII_HASH_SECRET: "change-me-to-a-64-char-hex-secret"

# ── Stripe keys live in secrets/billing.yaml (R3 key ownership) ──────────
# STRIPE_* belong to billing.yaml ONLY — see scripts/check-secret-keys-disjoint.sh.

