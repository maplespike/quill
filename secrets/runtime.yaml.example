# Quill — runtime secrets (encrypted with sops+age; see secrets/README.md)
#
# Copy this file to secrets/runtime.yaml, fill in real values, then:
#   SOPS_AGE_KEY_FILE=~/.config/sops/age/cluster-age-key.txt \
#     sops --encrypt --in-place secrets/runtime.yaml
#
# Consumed by:
#   - K8s Secret quill-secrets (jwtSecret, apiKey, githubClientId,
#     githubClientSecret, internalJwtSecret)
#   - K8s Secret maplespike-secrets (JWT_SECRET, QUILL_BILLING_SECRET, QUILL_PII_HASH_SECRET, QUILL_API_KEY)
#   - K8s Secret postgres-secret (POSTGRES_PASSWORD)
#   - K8s Secret cloudflared-creds (TUNNEL_TOKEN — see cloudflared.yaml)
#   - api-server config.ts (QUILL_GATEWAY_API_KEY)
#   - quill-mcp index.ts (ASTRAL_KEY_URL, QUILL_API_KEY)

JWT_SECRET: "change-me-to-a-secure-random-value"
QUILL_BILLING_SECRET: "change-me-to-a-secure-random-value"
POSTGRES_PASSWORD: "change-me-to-a-secure-random-value"
QUILL_GATEWAY_API_KEY: ""
ASTRAL_KEY_URL: "http://astral-key.astral-key.svc.cluster.local:8080"
MAPLESPIKE_BILLING_EMAIL: "billing@maplespike.ca"

# ── MCP gateway auth (REQUIRED — 2026-08-15 audit) ────────────────────
# Without QUILL_API_KEY the quill-mcp server falls back to the well-known
# default 'dev-key', which anyone with repo access can use to authenticate.
# Generate: openssl rand -hex 32
QUILL_API_KEY: "change-me-to-a-secure-random-value"

# ── PII hashing (REQUIRED in production — Decision 0002) ──────────────────
# A stable 64-char hex secret. The api-server refuses POST /v1/register
# without it. Generate: openssl rand -hex 32
QUILL_PII_HASH_SECRET: "change-me-to-a-64-char-hex-secret"

# ── Stripe (monetization MVP) ──
# Secret key from https://dashboard.stripe.com/apikeys — rotates live
# after paste-the-keys-but-before-they-hit-prod.
STRIPE_SECRET_KEY: "sk_live_REPLACE_WITH_LIVE_ROTATED_KEY"
# Webhook signing secret from https://dashboard.stripe.com/webhooks after
# pointing a webhook at /v1/billing/stripe/webhook on api.maplespike.ca
STRIPE_WEBHOOK_SECRET: "whsec_REPLACE_WITH_ROTATED_SIGNING_SECRET"
# Account ID (cosmetic — also encoded in the secret key prefix)
STRIPE_ACCOUNT_ID: "acct_REPLACE_WITH_ROTATED_ACCOUNT_ID"
# Stripe publishable key (browser-side; safe to expose, but we don't render
# any client components yet — kept here for forward-compat with the SDK path)
STRIPE_PUBLISHABLE_KEY: "pk_live_REPLACE_WITH_LIVE_ROTATED_KEY"

# ── GitHub OAuth (consumed by quill-secrets via sops-sync-k8s.sh) ──
# Client id is public (it rides every authorize URL); regenerate the secret
# in GitHub → Settings → Developer settings → OAuth Apps (Maplespike Quill)
# when rotating. Both must be present for the sync to emit github* keys.
GITHUB_CLIENT_ID: "Ov23likmcgrcrY0Hifd9"
GITHUB_CLIENT_SECRET: "«paste from GitHub — rotate, then replace this note»"

# ── Internal service auth (quill-mcp → api-server, gateway → api-server) ──
# HMAC secret for the X-Internal-Token JWTs (audience quill-internal), read from
# process.env by packages/api-server/src/middleware/internal-auth.ts and by
# packages/pipeline-core/src/shared/ledger-report.ts. Both reject values shorter
# than 32 chars. Live value lives in quill-secrets/internalJwtSecret.
# Generate: openssl rand -hex 32
INTERNAL_JWT_SECRET: "change-me-to-a-64-char-hex-secret"
