From: MapleSpike Agent <agent@maplespike>
Date: Thu, 18 Jun 2026 00:00:00 +0000
Subject: [PATCH] fix: fall back to HTTP/1.1 for CBC RSS feeds

CBC and some other Canadian news RSS feeds intermittently fail with
"NGHTTP2_INTERNAL_ERROR" when using HTTP/2 via undici. This patch:

1. Adds `preferHttp1` option to `HttpGetOptions` in the shared HTTP utility
2. Passes `allowH2: false` to undici when `preferHttp1` is true, forcing
   HTTP/1.1 fallback
3. Adds `preferHttp1` field to `RSSSource` and `FetchOptions` in rss.ts
4. Passes the flag through `fetchFeed` to `httpGet`
5. Marks all 6 CBC sources to use HTTP/1.1

---
 packages/pipeline-core/src/utils/http.ts       | 12 ++++++++++--
 packages/pipeline-core/src/ingestion/rss.ts    | 19 +++++++++++++++----
 2 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/packages/pipeline-core/src/utils/http.ts b/packages/pipeline-core/src/utils/http.ts
--- a/packages/pipeline-core/src/utils/http.ts
+++ b/packages/pipeline-core/src/utils/http.ts
@@ -113,6 +113,8 @@ export interface HttpGetOptions {
   throttle?: DomainThrottleConfig;
   /** HTTP method (default 'GET'). Use 'HEAD' for lightweight health checks. */
   method?: 'GET' | 'HEAD' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';
+  /** Force HTTP/1.1 fallback for servers with HTTP/2 issues (CBC, etc.). */
+  preferHttp1?: boolean;
 }
 
 export interface HttpResponse {
@@ -191,10 +193,16 @@ export async function httpGet(
   for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
     try {
       // eslint-disable-next-line @typescript-eslint/no-explicit-any
-      const resp = await (undiciRequest as any)(url, {
+      const resp = await (undiciRequest as any)(url,
+      // When preferHttp1 is true, disable HTTP/2 ALPN negotiation
+      // to work around NGHTTP2_INTERNAL_ERROR on misconfigured servers.
+      {
         method: options.method ?? 'GET',
         headers: requestHeaders,
         headersTimeout: timeout,
         bodyTimeout: timeout,
+        ...(options.preferHttp1 ? { allowH2: false } : {}),
       });
 
       // Normalise headers — undici headers are iterable entries
diff --git a/packages/pipeline-core/src/ingestion/rss.ts b/packages/pipeline-core/src/ingestion/rss.ts
--- a/packages/pipeline-core/src/ingestion/rss.ts
+++ b/packages/pipeline-core/src/ingestion/rss.ts
@@ -28,6 +28,8 @@ export interface RSSSource {
   name: string;
   url: string;
   category: string;
+  /** Force HTTP/1.1 for feeds that have HTTP/2 issues (e.g. CBC). */
+  preferHttp1?: boolean;
 }
 
 /** Canonical article shape produced by the pipeline. */
@@ -53,12 +55,12 @@ export const RSS_SOURCES: RSSSource[] = [
   // National broadcasters
-  { name: 'CBC News Top Stories', url: 'https://www.cbc.ca/webfeed/rss/rss-topstories', category: 'news' },
-  { name: 'CBC Politics', url: 'https://www.cbc.ca/webfeed/rss/rss-politics', category: 'politics' },
-  { name: 'CBC Business', url: 'https://www.cbc.ca/webfeed/rss/rss-business', category: 'business' },
-  { name: 'CBC Technology', url: 'https://www.cbc.ca/webfeed/rss/rss-technology', category: 'technology' },
-  { name: 'CBC Health', url: 'https://www.cbc.ca/webfeed/rss/rss-health', category: 'health' },
-  { name: 'CBC World', url: 'https://www.cbc.ca/webfeed/rss/rss-world', category: 'world' },
+  { name: 'CBC News Top Stories', url: 'https://www.cbc.ca/webfeed/rss/rss-topstories', category: 'news', preferHttp1: true },
+  { name: 'CBC Politics', url: 'https://www.cbc.ca/webfeed/rss/rss-politics', category: 'politics', preferHttp1: true },
+  { name: 'CBC Business', url: 'https://www.cbc.ca/webfeed/rss/rss-business', category: 'business', preferHttp1: true },
+  { name: 'CBC Technology', url: 'https://www.cbc.ca/webfeed/rss/rss-technology', category: 'technology', preferHttp1: true },
+  { name: 'CBC Health', url: 'https://www.cbc.ca/webfeed/rss/rss-health', category: 'health', preferHttp1: true },
+  { name: 'CBC World', url: 'https://www.cbc.ca/webfeed/rss/rss-world', category: 'world', preferHttp1: true },
 
   // National newspapers
   { name: 'The Globe and Mail - Canada', url: 'https://www.theglobeandmail.com/arc/outboundfeeds/rss/category/canada/', category: 'politics' },
@@ -225,6 +227,8 @@ export interface FetchOptions {
   userAgent?: string;
   timeout?: number;
+  /** Force HTTP/1.1 for this particular fetch. */
+  preferHttp1?: boolean;
 }
 
 /**
@@ -244,10 +248,17 @@ export async function fetchFeed(
     if (cached.lastModified) reqHeaders['If-Modified-Since'] = cached.lastModified;
   }
 
-  const resp = await httpGet(url, {
-    headers: reqHeaders,
-    timeoutMs: timeout,
-  });
+  const resp = await httpGet(
+    url,
+    {
+      headers: reqHeaders,
+      timeoutMs: timeout,
+      ...(options.preferHttp1 ? { preferHttp1: true } : {}),
+    },
+  );
 
   if (resp.statusCode === 304 && cached) {
     console.warn(`[RSS] 304 Not Modified for ${url} — using cached body`);
