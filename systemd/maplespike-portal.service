# MapleSpike Portal - Podman quadlet (systemd)
# Build: nix build .#maplespike-portal-image → podman load
# Start: systemctl enable --now maplespike-portal.service

[Unit]
Description=MapleSpike Portal (via Podman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/podman run --rm \
  --name maplespike-portal \
  -p 8080:8080 \
  -e PORT=8080 \
  -e PYTHONUNBUFFERED=1 \
  -e HOME=/tmp \
  ghcr.io/reverb256/maplespike-portal:2026-06-01

Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target