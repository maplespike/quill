# MapleSpike Quill Ingestion Runner (CronJob)
# Uses pre-built dist/ from host — no need to rebuild in container
FROM docker.io/library/node:24-alpine

RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy pre-built dist and node_modules from local build
COPY packages/pipeline-core/dist/ /app/packages/pipeline-core/dist/
COPY packages/pipeline-core/package.json /app/packages/pipeline-core/
COPY packages/database/ /app/packages/database/
COPY packages/engine/ /app/packages/engine/
COPY packages/legal-core/ /app/packages/legal-core/
COPY packages/legislation/ /app/packages/legislation/
COPY packages/sdk/ /app/packages/sdk/
COPY node_modules/ /app/node_modules/
COPY package.json /app/package.json

ENV NODE_ENV=production

USER 1001
ENTRYPOINT ["node", "packages/pipeline-core/dist/cli/ingest.js"]
