{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@maplespike/database": ["./packages/database/dist"],
      "@maplespike/database/*": ["./packages/database/dist/*"],
      "@maplespike/pipeline-core": ["./packages/pipeline-core/dist"],
      "@maplespike/pipeline-core/*": ["./packages/pipeline-core/dist/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "packages/database" },
    { "path": "packages/pipeline-core" },
    { "path": "packages/engine" },
    { "path": "packages/mcp-server" },
    { "path": "packages/api-server" }
  ],
  "exclude": ["node_modules", "dist"]
}
