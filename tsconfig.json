{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@maplespike/database": ["./packages/database/dist"],
      "@maplespike/database/*": ["./packages/database/dist/*"],
      "@maplespike/pipeline-core": ["./packages/pipeline-core/src/index.ts"],
      "@maplespike/pipeline-core/*": ["./packages/pipeline-core/src/*"],
      "@maplespike/pipeline-core/ontario-provincial": ["./packages/pipeline-core/src/ingestion/ontario-provincial"],
      "@maplespike/pipeline-core/worldbank-wdi": ["./packages/pipeline-core/src/ingestion/worldbank-wdi"],
      "@maplespike/pipeline-core/un-comtrade": ["./packages/pipeline-core/src/ingestion/un-comtrade"],
      "@maplespike/pipeline-core/gtfs-transit": ["./packages/pipeline-core/src/ingestion/gtfs-transit"],
      "@maplespike/pipeline-core/police-data": ["./packages/pipeline-core/src/ingestion/police-data"],
      "@maplespike/pipeline-core/political-donations": ["./packages/pipeline-core/src/ingestion/political-donations"],
      "@maplespike/pipeline-core/parliamentary-voting": ["./packages/pipeline-core/src/ingestion/parliamentary-voting"],
      "@maplespike/pipeline-core/public-accounts": ["./packages/pipeline-core/src/ingestion/public-accounts"],
      "@maplespike/pipeline-core/fire-emergency": ["./packages/pipeline-core/src/ingestion/fire-emergency"],
      "@maplespike/pipeline-core/municipal": ["./packages/pipeline-core/src/ingestion/municipal"],
      "@maplespike/pipeline-core/library": ["./packages/pipeline-core/src/ingestion/library"],
      "@maplespike/pipeline-core/parks": ["./packages/pipeline-core/src/ingestion/parks"],
      "@maplespike/pipeline-core/utilities": ["./packages/pipeline-core/src/ingestion/utilities"],
      "@maplespike/pipeline-core/housing-data": ["./packages/pipeline-core/src/ingestion/housing-data"],
      "@maplespike/pipeline-core/financial-regulation": ["./packages/pipeline-core/src/ingestion/financial-regulation"],
      "@maplespike/pipeline-core/energy": ["./packages/pipeline-core/src/ingestion/energy"],
      "@maplespike/pipeline-core/real-estate": ["./packages/pipeline-core/src/ingestion/real-estate"],
      "@maplespike/pipeline-core/opencorporates": ["./packages/pipeline-core/src/ingestion/opencorporates"]
    }
  },
  "files": [],
  "references": [
    { "path": "packages/i18n" },
    { "path": "packages/database" },
    { "path": "packages/pipeline-core" },
    { "path": "packages/engine" },
    { "path": "packages/quill-mcp" },
    { "path": "packages/api-server" }
  ],
  "exclude": ["node_modules", "dist"]
}
