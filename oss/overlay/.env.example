# Copy this file to .env.
# A value of unset means you have not configured that variable.
# Leave an optional group unset to turn that group off.

# --- core ---
NODE_ENV=production
PORT=8082
QUILL_PUBLIC_BASE_URL=unset
MAPLESPIKE_DOMAIN=unset
MAPLESPIKE_PUBLIC_URL=unset
APP_URL=http://localhost:8082
JWT_SECRET=unset
QUILL_FIXTURES=0
QUILL_PII_HASH_SECRET=unset

# --- storage ---
QUILL_STORAGE=sqlite
QUILL_DB_PATH=/data/quill.db
QUILL_DB_HOST=unset
QUILL_DB_PORT=5432
QUILL_DB_NAME=quill
QUILL_DB_USER=quill
QUILL_DB_PASSWORD=unset
DATABASE_URL=unset
REDIS_URL=redis://redis:6379

# --- auth ---
GITHUB_CLIENT_ID=unset
GITHUB_CLIENT_SECRET=unset

# --- AI (optional) ---
# Leave these unset. An unset endpoint turns AI off.
QUILL_AI_ENDPOINT=unset
QUILL_AI_MODEL=unset
QUILL_GATEWAY_URL=unset
QUILL_GATEWAY_API_KEY=unset
QUILL_QDRANT_ENDPOINT=unset
QUILL_EMBED_MODEL=unset

# --- billing (optional) ---
# Leave Stripe unset. Unset Stripe values turn billing off.
STRIPE_ENV=unset
STRIPE_SECRET_KEY=unset
STRIPE_PUBLISHABLE_KEY=unset
STRIPE_WEBHOOK_SECRET=unset
STRIPE_ACCOUNT_ID=unset
QUILL_BILLING_SECRET=unset
MAPLESPIKE_BILLING_EMAIL=unset

# --- x402 / crypto (optional) ---
# Leave these unset. Unset values turn crypto payments off.
X402_ENABLED=false
X402_RECIPIENT=unset
X402_LEDGER_PATH=unset
SOLANA_RPC_URL=unset
