# MapleSpike Quill Portal (Astro → nginx)
# Multi-stage build: build Astro static site with Node, serve with nginx
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Install pnpm and build dependencies
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      ca-certificates \
      python3 \
      make \
      g++ && \
    corepack enable && corepack prepare pnpm@10.32.1 --activate && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy entire workspace (respects .dockerignore)
COPY . .

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Build workspace deps in dependency order. NOTE: @maplespike/i18n must be
# built first — the portal (and sdk) import it, and it is a real compiled
# package (main: ./dist/index.js); without building it here, vite/rolldown
# cannot resolve the "@maplespike/i18n" import at astro build time.
RUN pnpm --filter @maplespike/i18n build && \
    pnpm --filter @maplespike/database build && \
    pnpm --filter @maplespike/pipeline-core build && \
    pnpm --filter @maplespike/sdk build && \
    pnpm --filter @maplespike/portal build

# ─── Runtime stage ───────────────────────────────────────────────────────────
FROM nginx:stable-bookworm-slim

# Copy nginx config to templates directory so envsubst processes ${API_UPSTREAM}
COPY --from=builder /app/packages/portal/nginx.conf /etc/nginx/templates/default.conf.template

# Copy built Astro static output
COPY --from=builder /app/packages/portal/dist/ /usr/share/nginx/html/

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
