# MapleSpike Quill Portal (Astro → nginx)
# Multi-stage: build Astro static site → serve with nginx
FROM node:24-alpine AS builder
WORKDIR /app
COPY packages/portal/ /app/packages/portal/
COPY packages/portal/package.json /app/
RUN apk add --no-cache python3 make g++ && cd /app/packages/portal && npm install && npm run build

FROM nginx:alpine
COPY --from=builder /app/packages/portal/dist/ /usr/share/nginx/html
COPY --from=builder /app/packages/portal/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
